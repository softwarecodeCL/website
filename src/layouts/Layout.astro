      }
    }

    @media (prefers-reduced-motion: reduce) {
      .sc-nav,
      .sc-nav::after,
      .sc-dd-menu,
      .sc-mobile-drawer,
      .sc-mobile-backdrop,
      .sc-menu-toggle span {
        transition: none;
      }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const navbar = document.querySelector('.sc-nav');
      const servicesItem = document.getElementById('scServicesItem');
      const servicesToggle = document.getElementById('scServicesToggle');

      const setServicesOpen = (open) => {
        if (!servicesItem || !servicesToggle) return;
        servicesItem.classList.toggle('is-open', open);
        servicesToggle.setAttribute('aria-expanded', String(open));
      };

      servicesToggle?.addEventListener('click', (event) => {
        event.stopPropagation();
        setServicesOpen(!servicesItem?.classList.contains('is-open'));
      });

      servicesItem?.addEventListener('mouseenter', () => {
        servicesToggle?.setAttribute('aria-expanded', 'true');
      });

      servicesItem?.addEventListener('mouseleave', () => {
        if (!servicesItem.classList.contains('is-open')) {
          servicesToggle?.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('click', (event) => {
        if (servicesItem && !servicesItem.contains(event.target)) {
          setServicesOpen(false);
        }
      });

      const mobileToggle = document.getElementById('scMenuToggle');
      const mobileLayer = document.getElementById('scMobileLayer');
      const mobileClose = document.getElementById('scMobileClose');
      const mobileBackdrop = document.getElementById('scMobileBackdrop');
      let lastFocusedElement = null;

      const openMobileMenu = () => {
        if (!mobileToggle || !mobileLayer) return;
        lastFocusedElement = document.activeElement;
        mobileLayer.removeAttribute('inert');
        mobileLayer.setAttribute('aria-hidden', 'false');
        mobileLayer.classList.add('is-open');
        mobileToggle.classList.add('is-open');
        mobileToggle.setAttribute('aria-expanded', 'true');
        document.documentElement.classList.add('sc-menu-open');
        window.setTimeout(() => mobileClose?.focus(), 60);
      };

      const closeMobileMenu = () => {
        if (!mobileToggle || !mobileLayer) return;
        mobileLayer.classList.remove('is-open');
        mobileLayer.setAttribute('aria-hidden', 'true');
        mobileToggle.classList.remove('is-open');
        mobileToggle.setAttribute('aria-expanded', 'false');
        document.documentElement.classList.remove('sc-menu-open');

        window.setTimeout(() => {
          mobileLayer.setAttribute('inert', '');
          if (lastFocusedElement instanceof HTMLElement) lastFocusedElement.focus();
        }, 240);
      };

      mobileToggle?.addEventListener('click', () => {
        mobileLayer?.classList.contains('is-open') ? closeMobileMenu() : openMobileMenu();
      });

      mobileClose?.addEventListener('click', closeMobileMenu);
      mobileBackdrop?.addEventListener('click', closeMobileMenu);
      mobileLayer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMobileMenu));

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        setServicesOpen(false);
        closeMobileMenu();
      });

      window.matchMedia('(min-width: 992px)').addEventListener('change', (event) => {
        if (event.matches) closeMobileMenu();
        else setServicesOpen(false);
      });

      if (navbar) {
        let ticking = false;

        const updateNavbar = () => {
          navbar.classList.toggle('scrolled', window.scrollY > 40);
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (ticking) return;
          window.requestAnimationFrame(updateNavbar);
          ticking = true;
        }, { passive: true });

        updateNavbar();
      }
    });
  </script>
