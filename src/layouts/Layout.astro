<style>
:root{
  --sc-brand: #6f2cff;
  --sc-accent: #4e0f33;
  --sc-ink: rgba(95, 95, 95, 0.92);
  --sc-muted: rgba(15,23,42,.70);
  --sc-border: rgba(15,23,42,.10);
  --sc-bg: rgba(255,255,255);
  --sc-bg-solid: #fff;
}

/* NAV base (serio, limpio, enterprise) */
.sc-nav{
  background: var(--sc-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--sc-border);
}

.nav-logo{ height: 60px; width:auto; } /* no tocamos el logo */

/* Links */
.sc-link{
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  padding: .62rem .92rem !important;
  border-radius: 999px;
  font-weight: 800;
  font-size: .95rem;
  color: var(--sc-ink) !important;
  letter-spacing: .01em;
  opacity: .9;
  transition: background .18s ease, transform .18s ease, color .18s ease, opacity .18s ease;
}

.sc-link:hover{
  background: rgba(111,44,255,.08);
  color: var(--sc-brand) !important;
  transform: translateY(-1px);
}

.sc-link.active{
  background: rgba(111,44,255,.12);
  color: var(--sc-brand) !important;
  opacity: 1;
}

/* CTA */
.sc-cta-btn{
  border-radius: 999px;
  padding: .62rem 1.05rem;
  font-weight: 900;
  border: 1px solid rgba(111,44,255,.22);
  background: rgba(255,255,255,.92);
  color: var(--sc-brand);
  transition: transform .18s ease, background .18s ease, box-shadow .18s ease, border-color .18s ease;
  white-space: nowrap;
}
.sc-cta-btn:hover{
  transform: translateY(-1px);
  border-color: rgba(111,44,255,.35);
  background: rgba(111,44,255,.06);
  box-shadow: 0 14px 35px rgba(15,23,42,.10);
}

/* Burger refinada */
.sc-burger{
  width: 46px; height: 42px;
  border: 0; padding: 0;
  border-radius: 14px;
  background: rgba(111,44,255,.10);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  flex-direction: column;
}
.sc-burger span{
  width: 22px; height: 2px;
  background: var(--sc-brand);
  border-radius: 2px;
  transition: transform .18s ease, opacity .18s ease, width .18s ease;
}
.sc-burger:not(.collapsed) span:nth-child(1){ transform: translateY(8px) rotate(45deg); }
.sc-burger:not(.collapsed) span:nth-child(2){ opacity: 0; width: 16px; }
.sc-burger:not(.collapsed) span:nth-child(3){ transform: translateY(-8px) rotate(-45deg); }

/* Dropdown: panel premium */
.sc-dd{ position: relative; }

/* MENÚ dropdown (estructura) */
.sc-dd-menu{
  border: 1px solid var(--sc-border);
  background: rgba(255,255,255,.96);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-radius: 18px;
  padding: .75rem;
  min-width: 420px;
  box-shadow: 0 30px 80px rgba(15,23,42,.14);
  margin-top: .55rem;
}

/* Header */
.sc-dd-head{
  padding: .25rem .25rem .65rem .25rem;
  border-bottom: 1px solid rgba(15,23,42,.08);
  margin-bottom: .65rem;
}
.sc-dd-title{
  font-weight: 950;
  letter-spacing: .02em;
  color: var(--sc-ink);
}
.sc-dd-sub{
  font-size: .88rem;
  color: var(--sc-muted);
}

/* Cards grid */
.sc-dd-grid{
  display: grid;
  grid-template-columns: 1fr;
  gap: .55rem;
}

.sc-dd-card{
  display: flex;
  align-items: center;
  gap: .8rem;
  padding: .8rem .85rem;
  border-radius: 14px;
  text-decoration: none;
  border: 1px solid rgba(15,23,42,.08);
  background: rgba(248,250,252,.80);
  transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease, background .16s ease;
  color: var(--sc-ink);
}

.sc-dd-card:hover{
  transform: translateY(-1px);
  border-color: rgba(111,44,255,.22);
  background: rgba(111,44,255,.05);
  box-shadow: 0 18px 45px rgba(15,23,42,.10);
}

.sc-dd-card.active{
  border-color: rgba(255,46,166,.25);
  background: rgba(255,46,166,.06);
}

.sc-dd-ic{
  width: 42px; height: 42px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(90deg, rgba(255,46,166,.14), rgba(111,44,255,.14));
  border: 1px solid rgba(111,44,255,.16);
  color: var(--sc-brand);
  flex: 0 0 auto;
}

.sc-dd-txt{ display:flex; flex-direction:column; gap:.15rem; min-width: 0; }
.sc-dd-label{ font-weight: 900; color: var(--sc-ink); }
.sc-dd-meta{
  font-size: .82rem;
  color: var(--sc-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sc-dd-arrow{
  margin-left: auto;
  opacity: .75;
  color: var(--sc-ink);
}

/* Footer */
.sc-dd-foot{
  margin-top: .7rem;
  padding-top: .7rem;
  border-top: 1px solid rgba(15,23,42,.08);
}
.sc-dd-brief{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  border-radius: 14px;
  padding: .75rem 1rem;
  font-weight: 900;
  text-decoration: none;
  color: #fff;
  background: linear-gradient(90deg, var(--sc-accent), var(--sc-brand));
  box-shadow: 0 16px 40px rgba(111,44,255,.18), 0 10px 24px rgba(255,46,166,.14);
  transition: transform .18s ease, filter .18s ease;
}
.sc-dd-brief:hover{ transform: translateY(-1px); filter: brightness(1.02); }

/* ===== Desktop: hover estable, sin parpadeos ===== */
@media (min-width: 992px){
  /* evita que Bootstrap haga "click toggle" en desktop */
  .sc-dd > button[data-bs-toggle="dropdown"]{ pointer-events: none; }
  .sc-dd:focus-within > button[data-bs-toggle="dropdown"]{ pointer-events: auto; }

  /* estado base: oculto (sin display:none para permitir transición) */
  .sc-dd .dropdown-menu{
    display: block;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity .16s ease, transform .16s ease, visibility .16s ease;
  }

  /* zona buffer invisible para que no se corte al mover el mouse */
  .sc-dd::after{
    content:"";
    position:absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 14px; /* buffer */
  }

  /* abre con hover o focus */
  .sc-dd:hover .dropdown-menu,
  .sc-dd:focus-within .dropdown-menu{
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
}

/* ===== Mobile ===== */
@media (max-width: 991.98px){
  .navbar-collapse{
    margin-top: .75rem;
    padding: .8rem;
    border: 1px solid var(--sc-border);
    border-radius: 18px;
    background: rgba(255,255,255,.96);
  }

  .sc-link{
    width: 100%;
    justify-content: center;
    border-radius: 14px;
    padding: .92rem 1rem !important;
  }

  /* dropdown integrado como panel */
  .sc-dd-menu{
    min-width: 100%;
    margin-top: .5rem;
    box-shadow: none;
  }

  /* aquí SÍ debe ser clickeable */
  .sc-dd > button[data-bs-toggle="dropdown"]{ pointer-events: auto; }
}


