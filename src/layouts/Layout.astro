    .sc-menu-toggle span {
      width: 21px;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, #a78bfa, #f43fbb);
      transition: transform 180ms ease, opacity 150ms ease, width 180ms ease;
    }

    .sc-menu-toggle.is-open span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .sc-menu-toggle.is-open span:nth-child(2) {
      width: 0;
      opacity: 0;
    }

    .sc-menu-toggle.is-open span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile drawer */
    .sc-mobile-layer {
      position: fixed;
      inset: 0;
      z-index: 1200;
      pointer-events: none;
    }

    .sc-mobile-backdrop {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      background: rgba(2, 4, 12, 0.72);
      opacity: 0;
      transition: opacity 220ms ease;
    }

    .sc-mobile-drawer {
      position: absolute;
      top: 0;
      right: 0;
      width: min(90vw, 390px);
      height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      color: #fff;
      background:
        radial-gradient(circle at 100% 0%, rgba(139, 92, 246, 0.18), transparent 34%),
        radial-gradient(circle at 0% 100%, rgba(236, 72, 153, 0.1), transparent 35%),
        #070a12;
      border-left: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: -28px 0 80px rgba(0, 0, 0, 0.48);
