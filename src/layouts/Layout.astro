      will-change: transform;
    }

    .sc-mobile-layer.is-open {
      pointer-events: auto;
    }

    .sc-mobile-layer.is-open .sc-mobile-backdrop {
      opacity: 1;
    }

    .sc-mobile-layer.is-open .sc-mobile-drawer {
      transform: translate3d(0, 0, 0);
    }

    .sc-mobile-head {
      min-height: 86px;
      padding: 18px 18px 16px 22px;
      display: flex;
      align-items: center;
