  ---
  const navServices = [
    {
      label: 'Desarrollo web',
      href: '/desarrollo-web-a-medida/',
      icon: 'bi-braces',
      description: 'Software, plataformas e integraciones a medida',
    },
    {
      label: 'Marketing Digital',
      href: '/agencia-marketing-digital/',
      icon: 'bi-graph-up-arrow',
      description: 'SEO técnico, rendimiento y conversión',
    },
  ];

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  schemaExtras?: any[];
  url?: string;
  robots?: string;
}

  const currentPath = Astro.url.pathname;

  const SITE_URL = 'https://www.softwarecode.cl/';
  const SITE_NAME = 'SoftwareCode';
  const DEFAULT_IMAGE = '/logosc-original.png';

  const {
    title = `Empresa de Desarrollo de Software en Chile | ${SITE_NAME}`,
    description = 'Empresa de desarrollo de software a medida y aplicaciones web en Chile. Creamos sistemas escalables, integraciones de APIs y SEO técnico B2B.',
    image = DEFAULT_IMAGE,
    type = 'website',
    publishedTime,
    modifiedTime,
    url,
    robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  } = Astro.props;

  const normalizedPath = currentPath.endsWith('/')
    ? currentPath
    : `${currentPath}/`;

  const inferredPageUrl = new URL(normalizedPath, SITE_URL).toString();

  const requestedPageUrl = url
    ? new URL(url, SITE_URL)
    : new URL(inferredPageUrl);

  if (
    !requestedPageUrl.pathname.endsWith('/') &&
    !/\.[a-z0-9]+$/i.test(requestedPageUrl.pathname)
  ) {
    requestedPageUrl.pathname = `${requestedPageUrl.pathname}/`;
  }

  const pageUrl = requestedPageUrl.toString();


  // Normaliza imagen a absoluta
  const imageUrl = new URL(image.startsWith('http') ? image : image || DEFAULT_IMAGE, SITE_URL).toString();

  // Breadcrumbs (home + segmento(s))
  const segments = normalizedPath.split('/').filter(Boolean);
  const breadcrumbItems = [
    { name: 'Inicio', item: SITE_URL },
    ...segments.map((seg, i) => {
      const item = new URL('/' + segments.slice(0, i + 1).join('/') + '/', SITE_URL).toString();
      const pretty =
        seg
          .replace(/-/g, ' ')
          .replace(/\b\w/g, (c) => c.toUpperCase());
      return { name: pretty, item };
    }),
  ];

  // JSON-LD base
  const jsonLd: any[] = [
  {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": `${SITE_URL}#organization`,
      "name": "SoftwareCode",
      "url": SITE_URL,
      "logo": {
        "@type": "ImageObject",
        "@id": `${SITE_URL}#logo`,
        "url": new URL("/logosc-original.png", SITE_URL).toString()
      },
      "image": { "@id": `${SITE_URL}#logo` },
      "description": "Empresa de desarrollo de software a medida, sistemas web escalables y consultoría SEO técnico en Santiago, Chile.",
      "telephone": "+56988396128",
      "priceRange": "$$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santiago",
        "addressRegion": "Región Metropolitana",
        "addressCountry": "CL"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "-33.5111", // Coordenadas aproximadas de tu zona central de operación
        "longitude": "-70.7523"
      },
      "areaServed": [
        { "@type": "Country", "name": "Chile" },
        { "@type": "AdministrativeArea", "name": "Región Metropolitana" }
      ],
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "sales",
          "telephone": "+56988396128",
          "areaServed": "CL",
          "availableLanguage": ["es"]
        }
      ],
      "knowsLanguage": ["es-CL"],
      "sameAs": [
        "https://www.linkedin.com/in/software-code-67b8543aa/",
        "https://www.instagram.com/softwarecode.cl/",
        "https://x.com/softwarecodeCL"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": `${SITE_URL}#website`,
      "url": SITE_URL,
      "name": SITE_NAME,
      "publisher": { "@id": `${SITE_URL}#organization` },
      "inLanguage": "es-CL"
    },
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${SITE_URL}#website` },
      "about": { "@id": `${SITE_URL}#organization` },
      "inLanguage": "es-CL",
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "@id": `${pageUrl}#primaryimage`,
        "url": imageUrl
      },
      "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
      "potentialAction": [
        { "@type": "ContactAction", "target": "https://wa.me/56988396128" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems.map((b, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": b.name,
        "item": b.item
      }))
    }
  ];

  // ✅ Extras opcionales por página (NO rompe nada si no vienen)
  const { schemaExtras = [] } = Astro.props;
  if (Array.isArray(schemaExtras) && schemaExtras.length) {
    jsonLd.push(...schemaExtras);
  }

  // Si es un post (article), añade Article schema
  if (type === 'article' && publishedTime) {
    jsonLd.push({
      '@context': 'https://schema.org',
      '@type': 'Article',
      "mainEntityOfPage": { '@type': 'WebPage', '@id': `${pageUrl}#webpage` },
      "headline": title,
      "description": description,
      "image": [imageUrl],
      "author": {
        '@id': `${SITE_URL}#organization` // Corregido: Ahora vincula directamente tu autoridad
      },
      "publisher": { '@id': `${SITE_URL}#organization` },
      "datePublished": publishedTime,
      "dateModified": modifiedTime || publishedTime,
      "inLanguage": 'es-CL'
    });
  }
