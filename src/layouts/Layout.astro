    .sc-mobile-kicker {
      color: #c4b5fd;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .sc-mobile-close {
      position: relative;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid rgba(167, 139, 250, 0.22);
