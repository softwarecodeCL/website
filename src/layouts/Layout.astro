    .sc-dd:hover .sc-dd-menu,
    .sc-dd:focus-within .sc-dd-menu,
    .sc-dd.is-open .sc-dd-menu {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate3d(0, 0, 0) scale(1);
    }

    .sc-dd:hover .sc-dd-trigger .bi,
    .sc-dd:focus-within .sc-dd-trigger .bi,
    .sc-dd.is-open .sc-dd-trigger .bi {
      transform: rotate(180deg);
