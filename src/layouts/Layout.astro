   NAV SCROLL EFFECT — oscuro glass
   ===================================================== */

.sc-nav {
  position: fixed;
  width: 100%;
  top: 0;
  z-index: 1050;

  background: rgba(7, 10, 18, 0.88) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10) !important;

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  box-shadow:
    0 14px 40px rgba(0, 0, 0, 0.28),
    inset 0 -1px 0 rgba(255,255,255,.035);

  transition:
    background .25s ease,
    box-shadow .25s ease,
    border-color .25s ease,
    backdrop-filter .25s ease;
}

/* cuando haces scroll: un poco más transparente */
/* =====================================================
   NAV SCROLL EFFECT — glass oscuro premium
   ===================================================== */

.sc-nav {
  position: fixed;
  width: 100%;
  top: 0;
  z-index: 1050;

  background: rgba(7, 10, 18, 0.88) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10) !important;

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  box-shadow:
    0 14px 40px rgba(0, 0, 0, 0.28),
