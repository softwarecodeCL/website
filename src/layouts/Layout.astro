  <style>
    :root {
      --sc-brand: #7c3aed;
      --sc-pink: #db2777;
      --sc-nav-height: 82px;
      --sc-mobile-nav-height: 76px;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      max-width: 100vw;
      overflow-x: hidden;
    }

    .page {
      padding-top: var(--sc-nav-height);
    }

    /* Navbar */
    .sc-nav {
      position: fixed;
      inset: 0 0 auto;
      z-index: 1050;
      height: var(--sc-nav-height);
      padding: 0;
      overflow: visible;
      background: rgba(7, 10, 18, 0.9) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      transition: background 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    }

    .sc-nav.scrolled {
      background: rgba(7, 10, 18, 0.72) !important;
      border-color: rgba(255, 255, 255, 0.14);
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
      backdrop-filter: blur(24px) saturate(155%);
      -webkit-backdrop-filter: blur(24px) saturate(155%);
    }

    .sc-nav::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -1px;
      width: 0;
      height: 1px;
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%);
      background: linear-gradient(90deg, transparent, #ec4899, #a78bfa, #6366f1, transparent);
      box-shadow: 0 0 22px rgba(168, 85, 247, 0.48);
      transition: width 280ms ease, opacity 280ms ease;
    }

    .sc-nav.scrolled::after {
      width: min(760px, 78vw);
      opacity: 1;
    }

    .sc-nav > .container {
      height: 100%;
      flex-wrap: nowrap;
    }

    .sc-brand-logo {
      display: inline-flex;
      align-items: center;
      margin: 0;
      padding: 0;
    }

    .nav-logo {
      width: auto;
      height: 42px;
      transition: filter 220ms ease;
    }

    .sc-nav.scrolled .nav-logo {
      filter: drop-shadow(0 0 18px rgba(168, 85, 247, 0.15));
    }

    /* Desktop navigation */
    .sc-desktop-nav,
    .sc-desktop-nav .navbar-nav {
      height: 100%;
      align-items: center;
    }

    .sc-desktop-nav .navbar-nav {
      flex-direction: row;
      flex-wrap: nowrap;
    }

    .sc-desktop-nav .nav-item {
      display: flex;
      align-items: center;
    }

    .sc-link {
      display: inline-flex;
      align-items: center;
      gap: 0.42rem;
      padding: 0.62rem 0.9rem !important;
      border: 0;
      border-radius: 999px;
      color: rgba(255, 255, 255, 0.76) !important;
      background: transparent;
      font-size: 0.94rem;
      font-weight: 800;
      letter-spacing: 0.01em;
      white-space: nowrap;
      transition: color 160ms ease, background 160ms ease, transform 160ms ease;
    }

    .sc-link:hover,
    .sc-link:focus-visible {
      color: #fff !important;
      background: rgba(255, 255, 255, 0.08);
      transform: translateY(-1px);
    }

    .sc-link.active {
      color: #fff !important;
      background: rgba(139, 92, 246, 0.2);
    }

    .sc-link:focus-visible,
    .sc-cta-btn:focus-visible,
    .sc-menu-toggle:focus-visible,
    .sc-mobile-close:focus-visible {
      outline: 2px solid #c4b5fd;
      outline-offset: 3px;
    }

    .sc-cta-btn {
      display: inline-flex;
      align-items: center;
      padding: 0.64rem 1.08rem;
      border: 1px solid rgba(216, 180, 254, 0.25);
      border-radius: 999px;
      color: #fff !important;
      background: rgba(255, 255, 255, 0.065);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
      font-weight: 900;
      white-space: nowrap;
      transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
    }

    .sc-cta-btn:hover {
      color: #fff;
      border-color: rgba(216, 180, 254, 0.38);
      background: linear-gradient(135deg, #5b21b6, #a21caf);
      transform: translateY(-1px);
    }

    /* Desktop services dropdown: custom positioning, no Bootstrap Popper */
    .sc-dd {
      position: relative;
      height: 100%;
    }

    .sc-dd-trigger {
      height: auto;
    }

    .sc-dd-trigger .bi {
      font-size: 0.72rem;
      transition: transform 180ms ease;
    }

    .sc-dd-menu {
      position: absolute;
      top: calc(100% - 1px);
      right: 0;
      z-index: 1100;
      width: min(560px, calc(100vw - 32px));
      padding: 16px;
      color: #fff;
      background:
        radial-gradient(circle at 100% 0%, rgba(124, 58, 237, 0.18), transparent 34%),
        rgba(9, 12, 23, 0.985);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      box-shadow: 0 28px 80px rgba(0, 0, 0, 0.48);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate3d(0, 10px, 0) scale(0.985);
      transform-origin: top right;
      transition: opacity 150ms ease, transform 180ms ease, visibility 150ms ease;
    }

    .sc-dd-menu::before {
      content: "";
      position: absolute;
      top: -6px;
      right: 42px;
      width: 12px;
      height: 12px;
