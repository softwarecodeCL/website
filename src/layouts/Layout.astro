      <meta name="twitter:image" content={imageUrl} />

      <!-- JSON-LD -->
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@graph": jsonLd.map(({ "@context": _ctx, ...rest }) => rest)
