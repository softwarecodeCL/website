    .sc-mobile-services {
      margin-top: 25px;
    }

    .sc-mobile-section-head {
      margin-bottom: 11px;
      padding: 0 4px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
    }

    .sc-mobile-section-head span {
      color: #fff;
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .sc-mobile-section-head small,
    .sc-mobile-service small {
      color: rgba(255, 255, 255, 0.48);
      font-size: 0.72rem;
    }

    .sc-mobile-service {
      min-height: 76px;
      padding: 12px;
      display: grid;
      grid-template-columns: 45px 1fr 20px;
