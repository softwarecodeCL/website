    .sc-mobile-cta {
      min-height: 66px;
      padding: 12px 17px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #fff;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 17px;
      background: linear-gradient(110deg, #6d28d9, #9333ea 52%, #c026d3);
      box-shadow: 0 18px 38px rgba(109, 40, 217, 0.28);
    }

    .sc-mobile-cta small {
      color: rgba(255, 255, 255, 0.68);
