  transition:
    background .28s ease,
    box-shadow .28s ease,
    border-color .28s ease,
    backdrop-filter .28s ease,
    min-height .28s ease;
}

/* línea luminosa inferior */
.sc-nav::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -1px;
  width: 0;
  height: 1px;
  transform: translateX(-50%);
  pointer-events: none;
  opacity: 0;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 97, 210, .75),
    rgba(216, 180, 254, .95),
    rgba(109, 143, 255, .75),
    transparent
  );
  box-shadow:
    0 0 18px rgba(168, 85, 247, .55),
    0 0 42px rgba(109, 143, 255, .22);
  transition: width .35s ease, opacity .35s ease;
}

/* cuando haces scroll */
.sc-nav.scrolled {
  background: rgba(7, 10, 18, 0.56) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.13) !important;

  backdrop-filter: blur(26px) saturate(170%);
  -webkit-backdrop-filter: blur(26px) saturate(170%);

  box-shadow:
    0 18px 55px rgba(0, 0, 0, 0.24),
    inset 0 -1px 0 rgba(255,255,255,.045);
}

.sc-nav.scrolled::after {
  width: min(760px, 78vw);
  opacity: 1;
}

/* logo con transición suave */
.nav-logo {
  transition:
    height .28s ease,
    transform .28s ease,
    filter .28s ease,
    opacity .28s ease;
}

.sc-nav.scrolled .nav-logo {
  height: 64px;
  transform: translateY(-1px);
  filter:
    drop-shadow(0 10px 22px rgba(0,0,0,.35))
    drop-shadow(0 0 18px rgba(168,85,247,.16));
}

/* links se ven un poco más finos al hacer scroll */
.sc-nav.scrolled .sc-link {
  color: rgba(255,255,255,.82) !important;
}

.sc-nav.scrolled .sc-link:hover {
  background: rgba(255,255,255,.085) !important;
  color: #fff !important;
}

/* CTA con brillo suave */
.sc-nav.scrolled .sc-cta-btn {
  background: rgba(255,255,255,.075) !important;
  border-color: rgba(216,180,254,.28) !important;
  box-shadow:
    0 14px 36px rgba(0,0,0,.24),
    0 0 24px rgba(168,85,247,.12),
    inset 0 0 0 1px rgba(255,255,255,.04);
}

/* Links sobre navbar oscuro */
.sc-nav .sc-link {
  color: rgba(255,255,255,.78) !important;
}

.sc-nav .sc-link:hover {
  background: rgba(255,255,255,.08) !important;
  color: #ffffff !important;
}

.sc-nav .sc-link.active {
  background: rgba(139,92,246,.20) !important;
  color: #ffffff !important;
}

/* Botón diagnóstico */
.sc-nav .sc-cta-btn {
  color: #ffffff !important;
  background: rgba(255,255,255,.065) !important;
  border: 1px solid rgba(216,180,254,.24) !important;
  box-shadow:
    0 14px 34px rgba(0,0,0,.24),
    inset 0 0 0 1px rgba(255,255,255,.035);
}

.sc-nav .sc-cta-btn:hover {
  background: linear-gradient(135deg, #5b21b6, #a21caf) !important;
  color: #ffffff !important;
} 


@media (max-width: 991.98px) {
  .sc-nav {
    background: rgba(7, 10, 18, 0.94) !important;
  }

  .sc-nav.scrolled {
    background: rgba(7, 10, 18, 0.84) !important;
  }

  .sc-nav.scrolled .nav-logo {
    height: 56px;
  }

  .sc-nav.scrolled::after {
    width: 82vw;
  }

  .navbar-collapse {
    background: rgba(7, 10, 18, 0.96) !important;
    border-color: rgba(255,255,255,.12) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
}


</style>
<style>
  .page {
    padding-top: 80px;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.getElementById('navbarNav');
    if (!nav) return;

    nav.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (!link) return;

      const collapseEl = document.getElementById('navbarNav');
      const isShown = collapseEl.classList.contains('show');
      if (isShown && window.bootstrap) {
        window.bootstrap.Collapse.getOrCreateInstance(collapseEl).hide();
      }
    });
  });


window.addEventListener("scroll", function () {
  const navbar = document.querySelector(".sc-nav");
  if (!navbar) return;

  if (window.scrollY > 50) {
    navbar.classList.add("scrolled");
  } else {
    navbar.classList.remove("scrolled");
  }
});
</script>
