      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, #a78bfa, #f43fbb);
    }

    .sc-mobile-close span:first-child {
      transform: translate(-50%, -50%) rotate(45deg);
    }

    .sc-mobile-close span:last-child {
      transform: translate(-50%, -50%) rotate(-45deg);
    }

    .sc-mobile-content {
      flex: 1;
      padding: 18px;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .sc-mobile-nav,
    .sc-mobile-service-grid {
      display: grid;
      gap: 8px;
    }

    .sc-mobile-link {
      min-height: 57px;
      padding: 0 16px;
      display: grid;
      grid-template-columns: 30px 1fr 22px;
      align-items: center;
      gap: 10px;
