  <script is:inline>
    function isMobileDevice() {
      return /Android|iPhone|iPad|iPod|IEMobile|Opera Mini/i.test(navigator.userAgent || "");
    }

    function getWaPhone() {
      const el = document.getElementById("wa-config");
      const digits = el ? (el.getAttribute("data-wa-phone") || "") : "";
      // defensivo: solo números
      return digits.replace(/[^\d]/g, "");
    }

    function readTemplates() {
      const el = document.getElementById("wa-templates");
      if (!el) return {};
      try { return JSON.parse(el.textContent || "{}"); } catch { return {}; }
    }

    const WA_PHONE = getWaPhone();
    const WA_TEMPLATES = readTemplates();

    function buildWhatsAppUrl(phoneDigits, message) {
      const encoded = encodeURIComponent(message);

      // Desktop: abrir WhatsApp Web directo (evita “compartir”)
      if (!isMobileDevice()) {
        return `https://web.whatsapp.com/send?phone=${phoneDigits}&text=${encoded}`;
      }

      // Mobile: wa.me suele abrir app; si no, WhatsApp muestra el flujo correcto igual
      return `https://wa.me/${phoneDigits}?text=${encoded}`;
    }

    function openWhatsApp(message) {
      const url = buildWhatsAppUrl(WA_PHONE, message);
      // location.href suele funcionar mejor que window.open para mobile
      if (isMobileDevice()) {
        window.location.href = url;
      } else {
        window.open(url, "_blank", "noopener,noreferrer");
      }
    }

    function getTemplate(key) {
      const fallback = "Hola, quiero cotizar servicios de marketing digital B2B.";
      return (key && WA_TEMPLATES[key]) ? WA_TEMPLATES[key] : (WA_TEMPLATES.proposal || fallback);
    }

    // AOS init (si ya lo inicializas en Layout, puedes borrar esto)
    if (typeof AOS !== "undefined") {
      AOS.init({ once: true, duration: 650, offset: 80 });
    }

    // Botones de WhatsApp
    document.addEventListener("click", (e) => {
      const btn = e.target instanceof Element ? e.target.closest("[data-wa-template]") : null;
      if (!btn) return;
      e.preventDefault();
      const key = btn.getAttribute("data-wa-template");
      openWhatsApp(getTemplate(key));
    });

    // Form -> WhatsApp armado
    const form = document.getElementById("waForm");
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();

        // Validación Bootstrap
        if (!form.checkValidity()) {
          form.classList.add("was-validated");
          return;
        }

        const fd = new FormData(form);
        const nombre = String(fd.get("nombre") || "").trim();
        const email = String(fd.get("email") || "").trim();
        const empresa = String(fd.get("empresa") || "").trim();
        const sitio = String(fd.get("sitio") || "").trim();
        const objetivo = String(fd.get("objetivo") || "").trim();
        const plazo = String(fd.get("plazo") || "").trim();
        const inversion = String(fd.get("inversion") || "").trim();
        const dolor = String(fd.get("dolor") || "").trim();

        const msg = [
          "Hola, quiero solicitar diagnóstico y propuesta de Marketing Digital B2B.",
          "",
          "1) Datos",
          `• Nombre: ${nombre}`,
          `• Empresa: ${empresa}`,
          `• Email: ${email}`,
          `• Sitio: ${sitio ? sitio : "(sin sitio / por definir)"}`,
          "",
          "2) Objetivo y plazo",
          `• Objetivo: ${objetivo}`,
          `• Plazo: ${plazo}`,
          "",
          "3) Inversión",
          `• Rango mensual: ${inversion}`,
          "",
          "4) Dolor / contexto",
          dolor,
          "",
          "¿Qué información adicional necesitan para preparar el plan y próximos pasos?"
        ].join("\n");

        openWhatsApp(msg);
      });
    }
  </script>

