:root{
  --sc-ring: rgba(111,44,255,.18);
  --sc-ring-2: rgba(255,46,166,.16);
  --sc-card-bg: rgba(255,255,255,.86);
  --sc-card-border: rgba(15,23,42,.10);
  --sc-card-ink: rgba(15,23,42,.92);
