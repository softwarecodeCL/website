---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Agencia de Marketing Digital en Chile | SEO, Leads y Estrategias B2B - SoftwareCode.cl";
const pageDescription =
  "Somos una Agencia de Marketing Digital en Chile especializada en SEO, generación de leads B2B, estrategias de marketing digital y automatización comercial con resultados medibles (GA4/GTM + pipeline).";
const pageUrl = "https://www.softwarecode.cl/agencia-marketing-digital/";

const heroImageSrc = "/images/agencia-seo-sc.png"; // puedes cambiarlo

// WhatsApp: +56 9 8839 6128 -> sin +, sin espacios
const waPhoneDigits = "56988396128";

// Mensajes predefinidos por CTA (serios, B2B, listos para comprar)
const WA_TEMPLATES = {
  diagnostic:
    "Hola, quiero solicitar un diagnóstico de Marketing Digital B2B. Busco claridad en prioridades (Performance/SEO/CRO/Tracking) y próximos pasos. ¿Qué información necesitan para evaluar mi caso?",
  proposal:
    "Hola, estoy evaluando contratar una agencia de marketing digital B2B. Necesito una propuesta con foco en leads calificados/oportunidades y medición (GA4/GTM + pipeline).",
  performance:
    "Hola, me interesa Performance (Google/Meta) orientado a leads calificados. ¿Cómo trabajan la estrategia, configuración de conversiones, optimización y reporting?",
  seo:
    "Hola, me interesa SEO para empresas con SEO técnico real (indexación, arquitectura, Core Web Vitals). Quiero auditoría + plan por prioridades y ejecución.",
  cro:
    "Hola, quiero mejorar la conversión (CRO): landing, mensaje, formularios, fricción, velocidad y tracking. Busco un plan y backlog de mejoras.",
  automation:
    "Hola, necesito automatización comercial e integraciones (formularios/WhatsApp/CRM). Quiero trazabilidad, asignación automática y seguimiento del pipeline.",
  web:
    "Hola, necesito una web/landing orientada a resultados (velocidad, UX, copy, tracking y SEO). Quiero estimación de alcance, tiempos y próximos pasos.",
  pricing:
    "Hola, vi sus rangos y quiero que recomienden el alcance ideal según mi objetivo y plazo. ¿Qué datos necesitan para cotizar con precisión?"
};
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl}>
  <!-- CONFIG invisible para JS -->
  <div id="wa-config" data-wa-phone={waPhoneDigits} class="d-none"></div>

  <!-- HERO -->
  <section class="sc-hero position-relative overflow-hidden border-bottom">
    <div class="sc-hero-bg"></div>
    <div class="sc-hero-grid"></div>

    <div class="container position-relative py-5">
      <div class="row align-items-center g-4 g-lg-5">
        <div class="col-12 col-lg-7" data-aos="fade" data-aos-duration="700">
          <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="sc-badge">Marketing Digital B2B</span>
            <span class="sc-badge">Performance</span>
            <span class="sc-badge">SEO Técnico</span>
            <span class="sc-badge">CRO</span>
            <span class="sc-badge">Automatización</span>
            <span class="sc-badge">Integraciones</span>
          </div>

          <h1 class="display-5 fw-bold lh-sm mb-3">
            Agencia de Marketing Digital para empresas que necesitan <span class="sc-gradient-text">ventas medibles</span>,
            no “actividad”.
          </h1>

          <p class="lead text-secondary mb-4">
            En SoftwareCode construimos un sistema completo para captar demanda, convertir y dar seguimiento real:
            <strong>campañas</strong> + <strong>SEO técnico</strong> + <strong>CRO</strong> + <strong>tracking</strong> +
            <strong>automatización comercial</strong>. Si tu empresa vende en B2B, necesitas pipeline, atribución y velocidad,
            no solo anuncios o publicaciones.
          </p>

          <div class="d-grid gap-2 d-sm-flex justify-content-sm-start my-3">
            <a class="btn btn-sc-primary btn-lg px-4"
               href="#"
               data-wa-template="diagnostic">
              Solicitar diagnóstico
            </a>

            <a class="btn btn-sc-outline btn-lg px-4"
               href="#"
               data-wa-template="proposal">
              Pedir propuesta
            </a>

            <a class="btn btn-sc-ghost btn-lg px-4"
               href="#form">
              Armar solicitud
            </a>
          </div>

          <div class="row g-3 mt-3">
            <div class="col-12 col-md-6">
              <div class="sc-mini-card">
                <div class="sc-mini-title">Enfoque ejecutivo</div>
                <div class="sc-mini-text">
                  KPI comerciales: leads calificados, costo por oportunidad, conversión, velocidad de respuesta y atribución.
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="sc-mini-card">
                <div class="sc-mini-title">Tecnología aplicada</div>
                <div class="sc-mini-text">
                  GA4 + GTM + eventos, integraciones a CRM y automatizaciones para que no se pierdan leads en el proceso.
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4 sc-trustline text-secondary">
            Enfoque: Chile (Santiago y regiones), servicios profesionales, industria, ecommerce con operación y ventas consultivas B2B.
          </div>
        </div>

        <div class="col-12 col-lg-5" data-aos="fade-left" data-aos-duration="700">
          <div class="sc-hero-card sc-shadow">
            <div class="ratio ratio-4x3 rounded-4 overflow-hidden border bg-light">
              <img
                src={heroImageSrc}
                alt="Agencia de marketing digital B2B en Chile - SoftwareCode.cl"
                class="w-100 h-100"
                style="object-fit: cover;"
                loading="lazy"
              />
            </div>

            <div class="pt-3">
              <div class="d-flex align-items-start justify-content-between gap-3">
                <div>
                  <div class="fw-semibold mb-1">Lo que medimos y optimizamos</div>
                  <div class="text-secondary small">
                    Canal → lead → oportunidad. Costos, conversiones, fricción, indexación, CWV y pipeline comercial.
                  </div>
                </div>
                <span class="sc-pill">B2B</span>
              </div>

              <div class="sc-divider my-3"></div>

              <div class="d-flex flex-column gap-2">
                <div class="sc-kpi-row"><span class="sc-kpi-dot"></span><span class="small text-secondary">Leads calificados por canal</span></div>
                <div class="sc-kpi-row"><span class="sc-kpi-dot"></span><span class="small text-secondary">Conversión (CRO) y fricción</span></div>
                <div class="sc-kpi-row"><span class="sc-kpi-dot"></span><span class="small text-secondary">Indexación + Core Web Vitals</span></div>
                <div class="sc-kpi-row"><span class="sc-kpi-dot"></span><span class="small text-secondary">Atribución y pipeline</span></div>
              </div>

              <div class="mt-3 d-grid">
                <a class="btn btn-sc-dark btn-lg"
                   href="#"
                   data-wa-template="proposal">
                  Contacto
                </a>
              </div>

              <div class="mt-2 small text-secondary">
                Respuesta inicial en horario laboral. Si calificas, te enviamos plan y próximos pasos.
              </div>
            </div>
          </div>

          <div class="mt-3 sc-proof sc-shadow" data-aos="fade" data-aos-duration="650" data-aos-delay="100">
            <div class="small text-secondary mb-2">Validación (placeholders — reemplaza con logos reales)</div>
            <div class="d-flex flex-wrap gap-2">
              <span class="sc-badge sc-badge-proof">Directorio / Marketplace</span>
              <span class="sc-badge sc-badge-proof">Ranking / Certificación</span>
              <span class="sc-badge sc-badge-proof">Casos / Testimonios</span>
              <span class="sc-badge sc-badge-proof">Partners</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- DIFERENCIAL -->
  <section class="py-5">
    <div class="container py-3 py-lg-4">
      <div class="row g-4">
        <div class="col-12" data-aos="fade" data-aos-duration="650">
          <h2 class="fw-bold mb-2">Por qué “agencia” + ingeniería gana en B2B</h2>
          <p class="text-secondary mb-0">
            En Chile hay mucha oferta de “agencia de marketing digital”, pero la mayoría se queda en campañas y contenido.
            En B2B eso falla cuando no hay trazabilidad: leads sin calificación, sin seguimiento, sin atribución y con un sitio lento o mal instrumentado.
            Nosotros cerramos el circuito completo: <strong>adquisición → conversión → seguimiento → medición → optimización</strong>.
          </p>
        </div>

        <div class="col-12 col-lg-4" data-aos="fade" data-aos-duration="650" data-aos-delay="50">
          <div class="sc-feature sc-shadow">
            <div class="sc-feature-n">01</div>
            <h3 class="h5 fw-bold mb-2">Demanda (Performance)</h3>
            <p class="text-secondary mb-3">
              Captamos intención con Google Ads y Meta Ads (cuando corresponde), remarketing y mensajes orientados a decisión.
              El objetivo no es “clics”, es <strong>leads calificados</strong>.
            </p>
            <ul class="text-secondary mb-0">
              <li>Arquitectura de campañas por intención</li>
              <li>Eventos y conversiones bien definidos</li>
              <li>Optimización por costo por oportunidad</li>
            </ul>
            <div class="mt-3">
              <a class="btn btn-sc-outline btn-sm" href="#" data-wa-template="performance">Quiero Performance</a>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-4" data-aos="fade" data-aos-duration="650" data-aos-delay="100">
          <div class="sc-feature sc-shadow">
            <div class="sc-feature-n">02</div>
            <h3 class="h5 fw-bold mb-2">Conversión (CRO)</h3>
            <p class="text-secondary mb-3">
              Si tu landing no convierte, el marketing se encarece. Mejoramos la conversión con estructura, copy, fricción,
              velocidad y tracking.
            </p>
            <ul class="text-secondary mb-0">
              <li>Optimización de formularios y CTA</li>
              <li>Mensajes por etapa del embudo</li>
              <li>Tests y backlog de mejoras</li>
            </ul>
            <div class="mt-3">
              <a class="btn btn-sc-outline btn-sm" href="#" data-wa-template="cro">Quiero CRO</a>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-4" data-aos="fade" data-aos-duration="650" data-aos-delay="150">
          <div class="sc-feature sc-shadow">
            <div class="sc-feature-n">03</div>
            <h3 class="h5 fw-bold mb-2">Sistema (SEO técnico + automatización)</h3>
            <p class="text-secondary mb-3">
              En B2B, ganar no es solo adquirir: es <strong>no perder</strong> leads. Implementamos SEO técnico,
              instrumentación y automatizaciones para un pipeline real.
            </p>
            <ul class="text-secondary mb-0">
              <li>SEO técnico (indexación, arquitectura, CWV)</li>
              <li>GA4 + GTM + eventos y reporting</li>
              <li>Integraciones a CRM y seguimiento</li>
            </ul>
            <div class="mt-3">
              <a class="btn btn-sc-outline btn-sm" href="#" data-wa-template="automation">Quiero Automatización</a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-5 sc-callout sc-shadow" data-aos="fade" data-aos-duration="650">
        <div class="row g-3 align-items-center">
          <div class="col-12 col-lg-8">
            <h3 class="h4 fw-bold mb-2">Si hoy inviertes y no puedes explicar qué funciona, estás perdiendo margen.</h3>
            <p class="text-secondary mb-0">
              Te proponemos un plan de marketing digital para empresas con foco en revenue: canales, métricas, atribución y roadmap
              (marketing + tecnología) para ejecutar sin humo.
            </p>
          </div>
          <div class="col-12 col-lg-4">
            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center my-2">
              <a class="btn btn-sc-primary btn-lg px-4" href="#" data-wa-template="proposal">Cotizar por WhatsApp</a>
              <a class="btn btn-sc-outline btn-lg px-4" href="#" data-wa-template="diagnostic">Pedir diagnóstico</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="py-5 sc-section-soft border-top border-bottom">
    <div class="container py-3 py-lg-4">
      <div class="row g-4">
        <div class="col-12" data-aos="fade" data-aos-duration="650">
          <h2 class="fw-bold mb-2">Servicios de Marketing Digital B2B (con entregables y control)</h2>
          <p class="text-secondary mb-0">
            Esta landing está pensada para intención de compra: “agencia marketing digital”, “marketing digital para empresas”,
            “posicionamiento web Chile”, “SEO técnico”, “generación de leads B2B”. Si buscas contratar, aquí está el alcance real.
          </p>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade" data-aos-duration="650" data-aos-delay="50">
          <div class="sc-service sc-shadow">
            <div class="sc-service-head">
              <div>
                <h3 class="h5 fw-bold mb-1">Performance Marketing (Google/Meta) + Optimización</h3>
                <div class="text-secondary small">Para capturar demanda existente y convertir en oportunidades reales.</div>
              </div>
              <span class="sc-pill sc-pill-soft">Alta intención</span>
            </div>
            <ul class="mt-3 text-secondary">
              <li>Setup de conversiones y eventos (GA4/GTM)</li>
              <li>Estructura por intención, audiencias y remarketing</li>
              <li>Optimización semanal orientada a lead calificado</li>
              <li>Reporte ejecutivo: resultados, aprendizaje y acciones</li>
            </ul>
            <div class="mt-3 d-grid d-sm-flex gap-2">
              <a class="btn btn-sc-outline" href="#" data-wa-template="performance">Hablar Performance</a>
              <a class="btn btn-sc-ghost" href="#" data-wa-template="pricing">Ver alcance recomendado</a>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade" data-aos-duration="650" data-aos-delay="100">
          <div class="sc-service sc-shadow">
            <div class="sc-service-head">
              <div>
                <h3 class="h5 fw-bold mb-1">SEO para Empresas (con SEO Técnico real)</h3>
                <div class="text-secondary small">Indexación, rastreo, arquitectura, performance y contenido transaccional.</div>
              </div>
              <span class="sc-pill sc-pill-soft">Sostenible</span>
            </div>
            <ul class="mt-3 text-secondary">
              <li>Auditoría SEO técnica + plan por prioridades</li>
              <li>Core Web Vitals, estructura interna, canonicals</li>
              <li>Keywords por intención (“cotizar”, “precio”, “agencia”, “a medida”)</li>
              <li>Plan editorial para convertir: comparativas y guías de decisión</li>
            </ul>
            <div class="mt-3 d-grid d-sm-flex gap-2">
              <a class="btn btn-sc-outline" href="#" data-wa-template="seo">Hablar SEO</a>
              <a class="btn btn-sc-ghost" href="#" data-wa-template="diagnostic">Pedir diagnóstico</a>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade" data-aos-duration="650" data-aos-delay="150">
          <div class="sc-service sc-shadow">
            <div class="sc-service-head">
              <div>
                <h3 class="h5 fw-bold mb-1">CRO (Conversion Rate Optimization)</h3>
                <div class="text-secondary small">Convertir más con el mismo tráfico: mensaje, UX, fricción y tracking.</div>
              </div>
              <span class="sc-pill sc-pill-soft">Rentabilidad</span>
            </div>
            <ul class="mt-3 text-secondary">
              <li>Auditoría de fricción y conversión</li>
              <li>Optimización de formularios y CTAs</li>
              <li>Arquitectura de landing y propuesta de valor</li>
              <li>Backlog de mejoras por impacto/esfuerzo</li>
            </ul>
            <div class="mt-3 d-grid d-sm-flex gap-2">
              <a class="btn btn-sc-outline" href="#" data-wa-template="cro">Hablar CRO</a>
              <a class="btn btn-sc-ghost" href="#form">Armar solicitud</a>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade" data-aos-duration="650" data-aos-delay="200">
          <div class="sc-service sc-shadow">
            <div class="sc-service-head">
              <div>
                <h3 class="h5 fw-bold mb-1">Automatización comercial + Integraciones</h3>
                <div class="text-secondary small">Formularios/WhatsApp/CRM + asignación, SLA y seguimiento.</div>
              </div>
              <span class="sc-pill sc-pill-soft">Escala</span>
            </div>
            <ul class="mt-3 text-secondary">
              <li>Lead routing (reglas por servicio/territorio/horario)</li>
              <li>Notificaciones, seguimiento y recordatorios</li>
              <li>Pipeline con etapas y trazabilidad</li>
              <li>Dashboards para decisiones comerciales</li>
            </ul>
            <div class="mt-3 d-grid d-sm-flex gap-2">
              <a class="btn btn-sc-outline" href="#" data-wa-template="automation">Hablar Automatización</a>
              <a class="btn btn-sc-ghost" href="#" data-wa-template="proposal">Pedir propuesta</a>
            </div>
          </div>
        </div>

        <div class="col-12" data-aos="fade" data-aos-duration="650">
          <div class="sc-note sc-shadow">
            <div class="fw-semibold mb-1">Nota</div>
            <div class="text-secondary">
              No vendemos manejo de redes “por posts”. Si aplica, se integra como soporte táctico, pero el foco es performance,
              SEO técnico, CRO y automatización para resultados comerciales.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section id="form" class="py-5">
    <div class="container py-3 py-lg-4">
      <div class="row g-4 g-lg-5 align-items-start">
        <div class="col-12 col-lg-6" data-aos="fade" data-aos-duration="650">
          <h2 class="fw-bold mb-2">Arma tu solicitud (y envíala por WhatsApp)</h2>
          <p class="text-secondary mb-4">
            Este formulario crea un mensaje estructurado para evaluar rápido tu caso. Ideal si estás listo para contratar y quieres
            avanzar sin reuniones innecesarias.
          </p>

          <div class="sc-steps sc-shadow">
            <div class="sc-step">
              <div class="sc-step-n">1</div>
              <div>
                <div class="fw-semibold">Contexto y objetivo</div>
                <div class="text-secondary small">Qué vendes, a quién, qué necesitas y con qué plazo.</div>
              </div>
            </div>
            <div class="sc-step">
              <div class="sc-step-n">2</div>
              <div>
                <div class="fw-semibold">Medición y pipeline</div>
                <div class="text-secondary small">Tracking, conversiones, CRM, seguimiento y atribución.</div>
              </div>
            </div>
            <div class="sc-step">
              <div class="sc-step-n">3</div>
              <div>
                <div class="fw-semibold">Respuesta clara</div>
                <div class="text-secondary small">Te devolvemos plan, alcance y próximos pasos.</div>
              </div>
            </div>
          </div>

          <div class="mt-4 sc-faq sc-shadow">
            <div class="fw-semibold mb-2">Preguntas típicas (B2B)</div>
            <div class="accordion" id="faqAcc">
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                    ¿Trabajan “marketing digital” o también el sitio/SEO técnico?
                  </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAcc">
                  <div class="accordion-body text-secondary">
                    Sí. Para vender en B2B no basta con anuncios: si el sitio es lento o no está bien instrumentado, el costo de adquisición se dispara.
                    Integramos performance + CRO + SEO técnico + tracking y, si aplica, automatización.
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                    ¿Cómo reportan resultados?
                  </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                  <div class="accordion-body text-secondary">
                    Reporte ejecutivo orientado a negocio: leads calificados, costo por oportunidad, tasa de conversión,
                    aprendizaje y acciones. No “métricas vanidosas”.
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                    ¿Qué necesitan para empezar?
                  </button>
                </h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                  <div class="accordion-body text-secondary">
                    Objetivo, plazo, oferta, sitio, canales actuales, y cómo gestionan hoy el lead (CRM/pipeline). Con eso armamos diagnóstico y propuesta.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade-left" data-aos-duration="650">
          <div class="sc-form-card sc-shadow">
            <div class="d-flex align-items-start justify-content-between gap-3">
              <div>
                <h3 class="h4 fw-bold mb-1">Enviar solicitud por WhatsApp</h3>
                <p class="text-secondary mb-0">
                  Completa los datos. Al enviar se abrirá WhatsApp con el mensaje listo.
                </p>
              </div>
              <span class="sc-pill">Chile</span>
            </div>

            <form id="waForm" class="mt-4 needs-validation" novalidate>
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold">Nombre</label>
                  <input class="form-control" name="nombre" type="text" placeholder="Tu nombre" required />
                  <div class="invalid-feedback">Ingresa tu nombre.</div>
                </div>

                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold">Email corporativo</label>
                  <input class="form-control" name="email" type="email" placeholder="nombre@empresa.cl" required />
                  <div class="invalid-feedback">Ingresa un email válido.</div>
                </div>

                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold">Empresa</label>
                  <input class="form-control" name="empresa" type="text" placeholder="Nombre de la empresa" required />
                  <div class="invalid-feedback">Ingresa tu empresa.</div>
                </div>

                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold">Sitio web</label>
                  <input class="form-control" name="sitio" type="url" placeholder="https://..." />
                </div>

                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold">Objetivo principal</label>
                  <select class="form-select" name="objetivo" required>
                    <option value="">Selecciona…</option>
                    <option>Generar leads B2B</option>
                    <option>Reducir costo de adquisición</option>
                    <option>Mejorar SEO / posicionamiento</option>
                    <option>Mejorar conversión (CRO)</option>
                    <option>Automatizar proceso comercial</option>
                  </select>
                  <div class="invalid-feedback">Selecciona un objetivo.</div>
                </div>

                <div class="col-12 col-md-6">
                  <label class="form-label fw-semibold">Plazo esperado</label>
                  <select class="form-select" name="plazo" required>
