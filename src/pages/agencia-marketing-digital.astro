---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const pageTitle = "Agencia de Marketing Digital B2B en Chile";
const pageDescription =
  "Generamos oportunidades para empresas B2B con SEO técnico, campañas digitales, optimización web y automatización comercial. Estrategias medibles en Chile.";
const pageUrl = "https://www.softwarecode.cl/agencia-marketing-digital/";
const heroImageSrc = "/images/agencia-seo-sc.png";
const waPhoneDigits = "56988396128";
const SITE_URL = "https://www.softwarecode.cl/";

const WA_TEMPLATES = {
  diagnostic:
    "Hola, quiero solicitar un diagnóstico de marketing digital para mi empresa. Me interesa revisar captación, SEO, conversión y seguimiento comercial. ¿Qué información necesitan para evaluar mi caso?",
  proposal:
    "Hola, quiero cotizar una estrategia de marketing digital B2B para generar más oportunidades comerciales. ¿Qué información necesitan para preparar una propuesta?",
  campaigns:
    "Hola, quiero evaluar campañas de Google Ads o Meta Ads orientadas a generar oportunidades para mi empresa. Me interesa conocer alcance, medición y forma de trabajo.",
  seo:
    "Hola, necesito mejorar el posicionamiento de mi empresa en Google. Quiero revisar SEO técnico, contenido, indexación y oportunidades de crecimiento orgánico.",
  conversion:
    "Hola, quiero mejorar la conversión de mi sitio web y formularios. Necesito detectar fricciones y aumentar la cantidad de contactos comerciales.",
  automation:
    "Hola, necesito conectar formularios, WhatsApp o CRM para ordenar el seguimiento de oportunidades y evitar contactos perdidos.",
  starter:
    "Hola, quiero ordenar la base digital de mi empresa: medición, SEO técnico y mejoras de conversión. ¿Qué alcance recomiendan?",
  growth:
    "Hola, quiero una estrategia continua para generar oportunidades mediante campañas, SEO y optimización web. ¿Qué alcance recomiendan?",
  scale:
    "Hola, quiero integrar marketing, automatización y seguimiento comercial para escalar la captación de mi empresa. ¿Qué alcance recomiendan?"
};

const schemaExtras = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    "name": "Servicios de Marketing Digital B2B",
    "url": pageUrl,
    "description": pageDescription,
    "serviceType": "Marketing Digital B2B",
    "provider": {
      "@id": `${SITE_URL}#organization`
    },
    "areaServed": {
      "@type": "Country",
      "name": "Chile"
    },
    "audience": {
      "@type": "BusinessAudience",
      "audienceType": "Empresas B2B, servicios profesionales, industria y negocios con ventas consultivas"
    },
    "inLanguage": "es-CL",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios de marketing digital para empresas",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Campañas digitales para generar oportunidades",
            "serviceType": "Google Ads y Meta Ads orientados a captación B2B"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "SEO técnico para empresas",
            "serviceType": "Auditoría, indexación, arquitectura, rendimiento y contenido"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Optimización de conversión",
            "serviceType": "Mejora de landings, formularios, mensajes y experiencia de usuario"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Automatización comercial",
            "serviceType": "Integración de formularios, WhatsApp, CRM y seguimiento comercial"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué incluye el servicio de marketing digital B2B?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El alcance se define según el objetivo de la empresa y puede incluir SEO técnico, campañas digitales, optimización de conversión, analítica e integraciones para el seguimiento comercial."
        }
      },
      {
        "@type": "Question",
        "name": "¿Trabajan solo campañas publicitarias?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. También podemos mejorar la base técnica del sitio, la medición, los formularios y la conexión con el proceso comercial para que la captación funcione de extremo a extremo."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cómo se miden los resultados?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Definimos conversiones y métricas comerciales desde el inicio. El seguimiento puede incluir contactos generados, costo por oportunidad, tasa de conversión, fuentes de captación y evolución de las acciones implementadas."
        }
      },
      {
        "@type": "Question",
        "name": "¿Atienden empresas fuera de Santiago?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Trabajamos de forma remota con empresas de Santiago y otras regiones de Chile."
        }
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={heroImageSrc}
  url={pageUrl}
  schemaExtras={schemaExtras}
>
  <div id="wa-config" data-wa-phone={waPhoneDigits} class="d-none"></div>

  <!-- HERO: intención principal clara -->
  <section class="sc-hero position-relative overflow-hidden border-bottom">
    <div class="sc-hero-bg"></div>
    <div class="sc-hero-grid"></div>

    <div class="container position-relative py-5">
      <div class="row align-items-center g-4 g-lg-5 py-lg-4">
        <div class="col-12 col-lg-7" data-aos="fade" data-aos-duration="650">
          <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="sc-badge">Marketing Digital B2B</span>
            <span class="sc-badge">SEO para empresas</span>
            <span class="sc-badge">Campañas digitales</span>
            <span class="sc-badge">Automatización comercial</span>
          </div>

          <h1 class="display-5 fw-bold lh-sm mb-3">
            Agencia de Marketing Digital B2B en Chile para generar
            <span class="sc-gradient-text">más oportunidades comerciales</span>
          </h1>

          <p class="lead text-secondary mb-4">
            Ayudamos a empresas a atraer clientes potenciales, mejorar la conversión de su sitio y ordenar el seguimiento comercial mediante
            <strong>SEO técnico</strong>, <strong>campañas digitales</strong>, <strong>optimización web</strong> y
            <strong>automatización</strong>.
          </p>

          <div class="d-grid gap-2 d-sm-flex justify-content-sm-start my-3">
            <a
              class="btn btn-sc-primary btn-lg px-4"
              href="#"
              data-wa-template="diagnostic"
              data-cta-location="hero"
            >
              Solicitar diagnóstico
            </a>

            <a
              class="btn btn-sc-outline btn-lg px-4"
              href="#form"
              data-cta-location="hero"
            >
              Cotizar estrategia
            </a>
          </div>

          <div class="row g-3 mt-3">
            <div class="col-12 col-md-6">
              <div class="sc-mini-card h-100">
                <div class="sc-mini-title">Estrategia y ejecución</div>
                <div class="sc-mini-text">
                  Definimos prioridades y también implementamos las mejoras técnicas, campañas e integraciones necesarias.
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="sc-mini-card h-100">
                <div class="sc-mini-title">Medición orientada al negocio</div>
                <div class="sc-mini-text">
                  Seguimos contactos, oportunidades, conversión y canales para tomar decisiones con información real.
                </div>
              </div>
            </div>
          </div>

          <p class="mt-4 mb-0 sc-trustline text-secondary">
            Servicios para empresas de Santiago y regiones de Chile, con atención directa y alcance adaptado a cada proyecto.
          </p>
        </div>

        <div class="col-12 col-lg-5" data-aos="fade-left" data-aos-duration="650">
          <div class="sc-hero-card sc-shadow">
            <div class="ratio ratio-4x3 rounded-4 overflow-hidden border bg-light">
              <img
                src={heroImageSrc}
                alt="Estrategia de marketing digital B2B para empresas en Chile"
                width="640"
                height="480"
                class="w-100 h-100"
                style="object-fit: cover;"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>

            <div class="pt-3">
              <div class="d-flex align-items-start justify-content-between gap-3">
                <div>
                  <div class="fw-semibold mb-1">Un sistema, no acciones aisladas</div>
                  <div class="text-secondary small">
                    Conectamos captación, sitio web, medición y seguimiento comercial para mejorar el resultado completo.
                  </div>
                </div>
                <span class="sc-pill">B2B</span>
              </div>

              <div class="sc-divider my-3"></div>

              <div class="d-flex flex-column gap-2">
                <div class="sc-kpi-row"><span class="sc-kpi-dot"></span><span class="small text-secondary">Visibilidad en búsquedas comerciales</span></div>
                <div class="sc-kpi-row"><span class="sc-kpi-dot"></span><span class="small text-secondary">Contactos y oportunidades generadas</span></div>
                <div class="sc-kpi-row"><span class="sc-kpi-dot"></span><span class="small text-secondary">Conversión de páginas y formularios</span></div>
                <div class="sc-kpi-row"><span class="sc-kpi-dot"></span><span class="small text-secondary">Seguimiento de cada oportunidad</span></div>
              </div>

              <div class="mt-3 d-grid">
                <a
                  class="btn btn-sc-dark btn-lg"
                  href="#"
                  data-wa-template="proposal"
                  data-cta-location="hero-card"
                >
                  Hablar sobre mi empresa
                </a>
              </div>

              <div class="mt-2 small text-secondary">
                Revisamos tu situación actual y te recomendamos un alcance realista.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRUEBA Y POSICIONAMIENTO -->
  <section class="py-4 border-bottom bg-white">
    <div class="container">
      <div class="row g-3">
        <div class="col-12 col-md-4">
          <div class="sc-proof h-100">
            <span class="sc-badge-proof">Experiencia</span>
            <div class="fw-bold mt-2">Más de 10 años en desarrollo e integraciones</div>
            <div class="small text-secondary mt-1">Base técnica para resolver problemas que una agencia tradicional no siempre puede ejecutar.</div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="sc-proof h-100">
            <span class="sc-badge-proof">Enfoque</span>
            <div class="fw-bold mt-2">Marketing para empresas B2B</div>
            <div class="small text-secondary mt-1">Estrategias pensadas para ventas consultivas, servicios profesionales y procesos comerciales complejos.</div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="sc-proof h-100">
            <span class="sc-badge-proof">Ejecución</span>
            <div class="fw-bold mt-2">Un solo equipo para marketing y tecnología</div>
            <div class="small text-secondary mt-1">Menos dependencia entre proveedores y mayor velocidad para implementar mejoras.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEMAS QUE RESOLVEMOS -->
  <section class="py-5">
    <div class="container py-3 py-lg-4">
      <div class="row g-4">
        <div class="col-12 col-lg-8" data-aos="fade" data-aos-duration="650">
          <span class="sc-eyebrow">Resultados antes que herramientas</span>
          <h2 class="fw-bold mt-2 mb-3">Marketing digital con desarrollo, medición y automatización</h2>
          <p class="text-secondary mb-0">
            Una campaña puede atraer visitas, pero el crecimiento se detiene si la web no convierte, Google no entiende las páginas importantes o los contactos no reciben seguimiento. Por eso trabajamos el proceso completo y priorizamos lo que puede generar mayor impacto comercial.
          </p>
        </div>

        <div class="col-12 col-lg-4" data-aos="fade" data-aos-duration="650">
          <div class="sc-note sc-shadow h-100">
            <div class="fw-semibold mb-2">¿Para quién es este servicio?</div>
            <div class="text-secondary">
              Empresas que venden servicios, soluciones técnicas, proyectos, equipamiento o productos con una decisión de compra consultiva.
            </div>
          </div>
        </div>

        <div class="col-12 col-lg-4" data-aos="fade" data-aos-delay="50" data-aos-duration="650">
          <div class="sc-feature sc-shadow h-100">
            <div class="sc-feature-n">01</div>
            <h3 class="h5 fw-bold mb-2">Atraer búsquedas y contactos relevantes</h3>
            <p class="text-secondary mb-3">
              Identificamos cómo buscan tus potenciales clientes y construimos canales para captar esa demanda.
            </p>
            <ul class="text-secondary mb-0">
              <li>SEO para búsquedas comerciales</li>
              <li>Campañas por servicio e intención</li>
              <li>Mensajes alineados con cada público</li>
            </ul>
          </div>
        </div>

        <div class="col-12 col-lg-4" data-aos="fade" data-aos-delay="100" data-aos-duration="650">
          <div class="sc-feature sc-shadow h-100">
            <div class="sc-feature-n">02</div>
            <h3 class="h5 fw-bold mb-2">Convertir más visitas en oportunidades</h3>
            <p class="text-secondary mb-3">
              Mejoramos estructura, velocidad, mensajes y formularios para reducir fricción en el contacto.
            </p>
            <ul class="text-secondary mb-0">
              <li>Optimización de páginas de servicio</li>
              <li>Formularios y llamados a la acción</li>
              <li>Experiencia móvil y rendimiento</li>
            </ul>
          </div>
        </div>

        <div class="col-12 col-lg-4" data-aos="fade" data-aos-delay="150" data-aos-duration="650">
          <div class="sc-feature sc-shadow h-100">
            <div class="sc-feature-n">03</div>
            <h3 class="h5 fw-bold mb-2">Medir y dar seguimiento comercial</h3>
            <p class="text-secondary mb-3">
              Registramos el origen de los contactos y conectamos el proceso para evitar oportunidades perdidas.
            </p>
            <ul class="text-secondary mb-0">
              <li>Medición de eventos y conversiones</li>
              <li>Integración con WhatsApp o CRM</li>
              <li>Alertas, asignación y seguimiento</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios" class="py-5 sc-section-soft border-top border-bottom">
    <div class="container py-3 py-lg-4">
      <div class="row g-4">
        <div class="col-12 col-lg-9" data-aos="fade" data-aos-duration="650">
          <span class="sc-eyebrow">Alcance modular</span>
          <h2 class="fw-bold mt-2 mb-3">Servicios de marketing digital para empresas B2B</h2>
          <p class="text-secondary mb-0">
            No todas las empresas necesitan lo mismo. El alcance se construye según tu objetivo, la situación actual del sitio, la competencia y la capacidad comercial para gestionar nuevas oportunidades.
          </p>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade" data-aos-delay="50" data-aos-duration="650">
          <article class="sc-service sc-shadow h-100">
            <div class="sc-service-head">
              <div>
                <h3 class="h5 fw-bold mb-1">Campañas digitales para generar oportunidades</h3>
                <div class="text-secondary small">Google Ads y Meta Ads cuando existe una oportunidad real para el negocio.</div>
              </div>
              <span class="sc-pill sc-pill-soft">Captación</span>
            </div>
            <ul class="mt-3 text-secondary">
              <li>Investigación de demanda y competencia</li>
              <li>Estructura de campañas por servicio e intención</li>
              <li>Configuración de conversiones y audiencias</li>
              <li>Optimización basada en contactos y oportunidades</li>
            </ul>
            <div class="mt-3">
              <a class="btn btn-sc-outline" href="#" data-wa-template="campaigns" data-cta-location="service-campaigns">Consultar campañas</a>
            </div>
          </article>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade" data-aos-delay="100" data-aos-duration="650">
          <article class="sc-service sc-shadow h-100">
            <div class="sc-service-head">
              <div>
                <h3 class="h5 fw-bold mb-1">SEO técnico y posicionamiento para empresas</h3>
                <div class="text-secondary small">Base técnica, arquitectura y contenido para competir en búsquedas relevantes.</div>
              </div>
              <span class="sc-pill sc-pill-soft">Orgánico</span>
            </div>
            <ul class="mt-3 text-secondary">
              <li>Auditoría de rastreo, indexación y rendimiento</li>
              <li>Optimización de páginas de servicios</li>
              <li>Arquitectura y enlaces internos</li>
              <li>Plan de contenidos según intención de búsqueda</li>
            </ul>
            <div class="mt-3 d-flex flex-wrap gap-2">
              <a class="btn btn-sc-outline" href="#" data-wa-template="seo" data-cta-location="service-seo">Consultar SEO</a>
              <a class="btn btn-sc-ghost" href="/blog/auditoria-seo-tecnica-chile/">Ver guía de auditoría SEO</a>
            </div>
          </article>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade" data-aos-delay="150" data-aos-duration="650">
          <article class="sc-service sc-shadow h-100">
            <div class="sc-service-head">
              <div>
                <h3 class="h5 fw-bold mb-1">Optimización de sitios y formularios</h3>
                <div class="text-secondary small">Mejoras para convertir más con el tráfico que ya estás recibiendo.</div>
              </div>
              <span class="sc-pill sc-pill-soft">Conversión</span>
            </div>
            <ul class="mt-3 text-secondary">
              <li>Revisión de propuesta de valor y mensajes</li>
              <li>Optimización de formularios y CTA</li>
              <li>Experiencia móvil, velocidad y accesibilidad</li>
              <li>Priorización de mejoras por impacto y esfuerzo</li>
            </ul>
            <div class="mt-3 d-flex flex-wrap gap-2">
              <a class="btn btn-sc-outline" href="#" data-wa-template="conversion" data-cta-location="service-conversion">Mejorar conversión</a>
              <a class="btn btn-sc-ghost" href="/desarrollo-web-a-medida/">Ver desarrollo web</a>
            </div>
          </article>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade" data-aos-delay="200" data-aos-duration="650">
          <article class="sc-service sc-shadow h-100">
            <div class="sc-service-head">
              <div>
                <h3 class="h5 fw-bold mb-1">Automatización y seguimiento comercial</h3>
                <div class="text-secondary small">Conecta los contactos con el proceso de ventas para responder y hacer seguimiento.</div>
              </div>
              <span class="sc-pill sc-pill-soft">Escala</span>
            </div>
            <ul class="mt-3 text-secondary">
              <li>Integración de formularios, WhatsApp y CRM</li>
              <li>Asignación automática de oportunidades</li>
              <li>Notificaciones y recordatorios de seguimiento</li>
              <li>Paneles de control para decisiones comerciales</li>
            </ul>
            <div class="mt-3">
              <a class="btn btn-sc-outline" href="#" data-wa-template="automation" data-cta-location="service-automation">Consultar automatización</a>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- METODOLOGÍA -->
  <section class="py-5">
    <div class="container py-3 py-lg-4">
      <div class="row g-4 align-items-start">
        <div class="col-12 col-lg-5" data-aos="fade" data-aos-duration="650">
          <span class="sc-eyebrow">Forma de trabajo</span>
          <h2 class="fw-bold mt-2 mb-3">Una estrategia basada en prioridades, no en una lista genérica de tareas</h2>
          <p class="text-secondary mb-4">
            Primero entendemos el negocio y el proceso comercial. Después definimos qué combinación de SEO, campañas, optimización o automatización tiene más sentido para alcanzar el objetivo.
          </p>

          <div class="sc-callout sc-shadow">
            <h3 class="h5 fw-bold mb-2">Tecnología aplicada donde aporta valor</h3>
            <p class="text-secondary mb-0">
              Podemos intervenir directamente en el sitio, implementar medición, desarrollar integraciones y automatizar tareas. Esto evita que una buena estrategia quede detenida por limitaciones técnicas.
            </p>
          </div>
        </div>

        <div class="col-12 col-lg-7" data-aos="fade-left" data-aos-duration="650">
          <div class="sc-steps sc-shadow">
            <div class="sc-step">
              <div class="sc-step-n">1</div>
              <div>
                <div class="fw-semibold">Diagnóstico del negocio y los canales</div>
                <div class="text-secondary small">Revisamos oferta, cliente ideal, competencia, sitio, medición y proceso comercial.</div>
              </div>
            </div>
            <div class="sc-step">
              <div class="sc-step-n">2</div>
              <div>
                <div class="fw-semibold">Plan priorizado</div>
                <div class="text-secondary small">Ordenamos acciones por impacto, urgencia, dificultad y dependencia técnica.</div>
              </div>
            </div>
            <div class="sc-step">
              <div class="sc-step-n">3</div>
              <div>
                <div class="fw-semibold">Implementación y medición</div>
                <div class="text-secondary small">Ejecutamos campañas, mejoras web, SEO, eventos e integraciones según el alcance.</div>
              </div>
            </div>
            <div class="sc-step">
              <div class="sc-step-n">4</div>
              <div>
                <div class="fw-semibold">Optimización continua</div>
                <div class="text-secondary small">Analizamos resultados, aprendizajes y nuevas oportunidades para el siguiente ciclo.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EXPERIENCIA Y AUTORIDAD -->
  <section class="py-5 sc-section-dark border-top border-bottom">
    <div class="container py-3 py-lg-4">
      <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-7" data-aos="fade" data-aos-duration="650">
          <span class="sc-eyebrow sc-eyebrow-light">Experiencia aplicada</span>
          <h2 class="fw-bold text-white mt-2 mb-3">Marketing respaldado por experiencia real en desarrollo de software</h2>
          <p class="text-white-50 mb-4">
            SoftwareCode combina experiencia en sistemas web, APIs, bases de datos, integraciones, nube y rendimiento con una estrategia de captación orientada a empresas. Esto permite resolver tanto la visibilidad como los bloqueos técnicos que afectan la conversión y el seguimiento.
          </p>

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <div class="sc-dark-card h-100">
                <div class="fw-semibold text-white">Implementación directa</div>
