/* Base mejorada para todas tus cajas */
.sc-shadow{
  box-shadow:
    0 26px 70px rgba(15,23,42,.10),
    0 10px 24px rgba(15,23,42,.08);
}

.sc-hero-card,
.sc-mini-card,
.sc-proof,
.sc-feature,
.sc-service,
.sc-steps,
.sc-form-card,
.sc-price,
.sc-final,
.sc-note,
.sc-faq{
  position: relative;
  overflow: hidden;
  background: var(--sc-card-bg);
  border: 1px solid var(--sc-card-border);
  transform: translateZ(0);
  transition:
    transform .18s ease,
    box-shadow .18s ease,
    border-color .18s ease,
    filter .18s ease;
}

/* Glow suave de fondo (premium) */
.sc-hero-card::before,
.sc-mini-card::before,
.sc-proof::before,
.sc-feature::before,
.sc-service::before,
.sc-steps::before,
.sc-form-card::before,
.sc-price::before,
.sc-final::before,
.sc-note::before,
.sc-faq::before{
  content:"";
  position:absolute;
  inset:-2px;
  pointer-events:none;
  background:
    radial-gradient(700px 260px at 15% 0%, rgba(255,46,166,.12), transparent 60%),
    radial-gradient(700px 260px at 85% 15%, rgba(111,44,255,.12), transparent 62%);
  opacity: .55;
  transition: opacity .18s ease;
}

/* Borde gradiente finito (se ve “caro”) */
.sc-hero-card::after,
.sc-mini-card::after,
.sc-proof::after,
.sc-feature::after,
.sc-service::after,
.sc-steps::after,
.sc-form-card::after,
.sc-price::after,
.sc-final::after,
.sc-note::after,
.sc-faq::after{
  content:"";
  position:absolute;
  inset:0;
  padding:1px;              /* grosor del borde */
  border-radius: inherit;
  background: linear-gradient(90deg,
    rgba(255,46,166,.45),
    rgba(111,44,255,.45),
    rgba(139,92,246,.35)
  );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: .0;
  transition: opacity .18s ease;
  pointer-events:none;
}

