  <script type="application/json" id="wa-templates">
    {JSON.stringify(WA_TEMPLATES)}
  </script>

  <script is:inline>
    function isMobileDevice() {
      return /Android|iPhone|iPad|iPod|IEMobile|Opera Mini/i.test(navigator.userAgent || "");
    }

    function getWaPhone() {
      const el = document.getElementById("wa-config");
      const digits = el ? (el.getAttribute("data-wa-phone") || "") : "";
      return digits.replace(/[^\d]/g, "");
    }

    function readTemplates() {
      const el = document.getElementById("wa-templates");
      if (!el) return {};
      try {
        return JSON.parse(el.textContent || "{}");
      } catch {
        return {};
      }
    }

    function trackEvent(eventName, params = {}) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: eventName, ...params });
    }

    function buildWhatsAppUrl(phoneDigits, message) {
      const encoded = encodeURIComponent(message);
      return isMobileDevice()
        ? `https://wa.me/${phoneDigits}?text=${encoded}`
        : `https://web.whatsapp.com/send?phone=${phoneDigits}&text=${encoded}`;
    }

    function openWhatsApp(message, source = "unknown") {
      const phone = getWaPhone();
      if (!phone) return;

      trackEvent("whatsapp_lead_click", {
        event_category: "lead",
        event_label: source,
        page_path: window.location.pathname
      });

      const url = buildWhatsAppUrl(phone, message);
      if (isMobileDevice()) {
        window.location.href = url;
      } else {
        window.open(url, "_blank", "noopener,noreferrer");
      }
    }

    const WA_TEMPLATES = readTemplates();

    function getTemplate(key) {
      const fallback = "Hola, quiero cotizar servicios de marketing digital para mi empresa.";
      return key && WA_TEMPLATES[key]
        ? WA_TEMPLATES[key]
        : (WA_TEMPLATES.proposal || fallback);
    }

    document.addEventListener("click", (event) => {
      const target = event.target;
      const button = target instanceof Element ? target.closest("[data-wa-template]") : null;
      if (!button) return;

      event.preventDefault();
      const key = button.getAttribute("data-wa-template") || "proposal";
      const source = button.getAttribute("data-cta-location") || key;
      openWhatsApp(getTemplate(key), source);
    });

    const form = document.getElementById("waForm");

    if (form instanceof HTMLFormElement) {
      const siteInput = form.querySelector('input[name="sitio"]');

      function normalizeUrl(raw) {
        const value = String(raw || "").trim();
        if (!value) return "";

        const candidate = /^https?:\/\//i.test(value) ? value : `https://${value}`;
        try {
          const parsed = new URL(candidate);
          return parsed.hostname.includes(".") ? parsed.toString() : null;
        } catch {
          return null;
        }
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();

        if (siteInput instanceof HTMLInputElement) {
          const normalized = normalizeUrl(siteInput.value);
          if (siteInput.value.trim() && !normalized) {
            siteInput.setCustomValidity("invalid");
          } else {
            siteInput.setCustomValidity("");
            if (normalized) siteInput.value = normalized;
          }
        }

        if (!form.checkValidity()) {
          form.classList.add("was-validated");
          return;
        }

        const data = new FormData(form);
        const params = new URLSearchParams(window.location.search);

        const nombre = String(data.get("nombre") || "").trim();
        const email = String(data.get("email") || "").trim();
        const empresa = String(data.get("empresa") || "").trim();
        const sitio = String(data.get("sitio") || "").trim();
        const objetivo = String(data.get("objetivo") || "").trim();
        const plazo = String(data.get("plazo") || "").trim();
        const inversion = String(data.get("inversion") || "").trim();
        const contexto = String(data.get("contexto") || "").trim();

        const campaignData = [
          params.get("utm_source") ? `• Fuente: ${params.get("utm_source")}` : "",
          params.get("utm_medium") ? `• Medio: ${params.get("utm_medium")}` : "",
          params.get("utm_campaign") ? `• Campaña: ${params.get("utm_campaign")}` : ""
        ].filter(Boolean);

        const message = [
          "Hola, quiero solicitar una propuesta de marketing digital B2B.",
          "",
          "1) Empresa y contacto",
          `• Nombre: ${nombre}`,
          `• Empresa: ${empresa}`,
          `• Email: ${email}`,
          `• Sitio: ${sitio || "Sin sitio / por definir"}`,
          "",
          "2) Objetivo",
          `• Objetivo principal: ${objetivo}`,
          `• Plazo: ${plazo}`,
          `• Inversión estimada: ${inversion}`,
          "",
          "3) Situación actual",
          contexto,
          ...(campaignData.length ? ["", "4) Origen de la consulta", ...campaignData] : []),
          "",
          `Página: ${window.location.href}`,
          "",
          "¿Qué punto de partida y alcance recomiendan para este caso?"
        ].join("\n");

        trackEvent("marketing_form_submit", {
          event_category: "lead",
          objective: objetivo,
          investment_range: inversion,
          page_path: window.location.pathname
        });

        openWhatsApp(message, "marketing-form");
      });
    }
  </script>

