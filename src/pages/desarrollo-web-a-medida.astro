---
import Layout from '../layouts/Layout.astro'

const title = 'Desarrollo web a medida en Chile y Latinoamérica — Nuxt, NestJS, Headless CMS y SEO técnico'
const description =
  'Desarrollo web a medida para pymes, startups y empresas medianas. Migración desde WordPress, webs que venden, integraciones con pagos/APIs/sistemas, performance y SEO técnico con Nuxt + NestJS + Headless CMS.'

// ===== SEO: JSON-LD enriquecido (Service + WebPage + Breadcrumb + FAQ + Organization) =====
const siteUrl = 'https://www.softwarecode.cl';
const pageUrl = `${siteUrl}/desarrollo-web-a-medida/`;
const orgName = 'SoftwareCode.cl';
const phone = '+56988396128';
const waUrl = 'https://wa.me/56988396128';
const logoUrl = `${siteUrl}/logosc-original.png`;
const primaryImageUrl = `${siteUrl}/logosc-original.png`;

const faq = [
  {
    q: '¿Cuándo conviene pasar de WordPress a una web a medida?',
    a: 'Cuando tu sitio se vuelve lento, dependes de demasiados plugins, necesitas integraciones reales (pagos, CRM, APIs) o quieres posicionarte con SEO técnico serio. Si cada cambio implica “parches”, normalmente ya es momento de una base moderna.'
  },
  {
    q: '¿Qué significa “SEO técnico desde el inicio”?',
    a: 'Significa construir estructura, semántica, performance, URLs y enlazado interno de forma correcta desde el primer día. Así el contenido que publiques tiene una base sólida para posicionar en Chile y Latinoamérica.'
  },
  {
    q: '¿Pueden integrar pagos y sistemas?',
    a: 'Sí. Integramos pasarelas de pago, APIs externas, CRM y sistemas internos mediante backend con NestJS y arquitectura preparada para crecer.'
  },
  {
    q: '¿Qué es un Headless CMS y por qué ayuda?',
    a: 'Es un CMS donde el contenido se administra separado de la web. Eso mejora performance, seguridad y te permite evolucionar el sitio sin quedar amarrado a plantillas ni plugins. Es ideal para blogs/noticias y páginas comerciales.'
  },
  {
    q: '¿Entregan soporte y evolución?',
    a: 'Sí. Podemos acompañarte con mejoras, performance, SEO técnico, nuevas integraciones y evolución de funcionalidades. La idea es que tu web no se quede estática mientras tu negocio crece.'
  }
];

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      "name": orgName,
      "url": siteUrl,
      "logo": { "@type": "ImageObject", "@id": `${siteUrl}#logo`, "url": logoUrl },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": phone,
          "contactType": "sales",
          "availableLanguage": ["es"],
          "areaServed": ["CL", "LATAM"]
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      "url": siteUrl,
      "name": orgName,
      "publisher": { "@id": `${siteUrl}#organization` },
      "inLanguage": "es-CL",
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${siteUrl}/blog?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}#website` },
      "about": { "@id": `${siteUrl}#organization` },
      "mainEntity": { "@id": `${siteUrl}#service` },
      "breadcrumb": { "@id": `${pageUrl}#breadcrumbs` },
      "primaryImageOfPage": { "@type": "ImageObject", "@id": `${pageUrl}#primaryimage`, "url": primaryImageUrl },
      "inLanguage": "es-CL"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumbs`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Software a medida", "item": pageUrl }
      ]
    },
    {
      "@type": "Service",
      "@id": `${siteUrl}#service`,
      "name": "Desarrollo web a medida",
      "serviceType": ["Web Development", "Custom Software Development", "SEO Technical Consulting"],
      "description": description,
      "url": pageUrl,
      "provider": { "@id": `${siteUrl}#organization` },
      "areaServed": [
        { "@type": "Country", "name": "Chile" },
        { "@type": "AdministrativeArea", "name": "Latinoamérica" }
      ],
      "audience": [
        { "@type": "Audience", "audienceType": "pymes" },
        { "@type": "Audience", "audienceType": "startups" },
        { "@type": "Audience", "audienceType": "empresas medianas" }
      ],
      "offers": {
        "@type": "Offer",
        "url": waUrl,
        "availability": "https://schema.org/InStock",
        "category": "B2B",
        "description": "Cotización a medida según alcance (diagnóstico + propuesta)."
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "url": pageUrl,
      "mainEntity": faq.map((x) => ({
        "@type": "Question",
        "name": x.q,
        "acceptedAnswer": { "@type": "Answer", "text": x.a }
      }))
    }
  ]
};
---
<Layout title={title} description={description}>
  <style>
    :root{
      --c1:#6f42c1; /* purple */
      --c2:#2563eb; /* blue */
      --c3:#10b981; /* green */
      --c4:#f59e0b; /* amber */
      --ink:#0f172a;
      --muted:#475569;
      --card: rgba(255,255,255,0.92);
      --line: rgba(15, 23, 42, 0.08);
      --shadow: 0 18px 50px rgba(15, 23, 42, .12);
    }

    .mk-hero{
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid var(--line);
      background:
        radial-gradient(900px 420px at 15% 12%, rgba(111,66,193,.16), transparent 60%),
        radial-gradient(800px 380px at 85% 20%, rgba(37,99,235,.14), transparent 55%),
        radial-gradient(700px 360px at 55% 85%, rgba(16,185,129,.10), transparent 55%),
        linear-gradient(180deg, #ffffff, #fbfbff);
    }

    .mk-hero::after{
      content:"";
      position:absolute;
      left:-20%;
      right:-20%;
      bottom:-80px;
      height: 160px;
      background: linear-gradient(90deg, rgba(111,66,193,.12), rgba(37,99,235,.10), rgba(16,185,129,.10));
      filter: blur(30px);
      transform: rotate(-2deg);
      opacity:.75;
      pointer-events:none;
    }

    .mk-title{
      color: var(--ink);
      letter-spacing: -0.03em;
      font-weight: 900;
      line-height: 1.08;
    }

    .mk-subtitle{
      color: var(--muted);
      font-size: 1.15rem;
      line-height: 1.7;
      max-width: 68ch;
      margin-left:auto;
      margin-right:auto;
    }

    .mk-badges .badge{
      border: 1px solid rgba(0,0,0,0.06);
      font-weight: 800;
      padding: .45rem .6rem;
      border-radius: 999px;
      color: #2e2e2e;
    }

    .mk-card{
      border: 1px solid var(--line);
      border-radius: 18px;
      background: var(--card);
      box-shadow: var(--shadow);
      transition: transform .25s ease, box-shadow .25s ease;
      overflow: hidden;
    }

    .mk-card:hover{
      transform: translateY(-4px);
      box-shadow: 0 22px 65px rgba(15, 23, 42, .16);
    }

    .mk-mini{
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 10px 30px rgba(15, 23, 42, .08);
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .mk-mini:hover{
      transform: translateY(-3px);
      box-shadow: 0 16px 40px rgba(15, 23, 42, .12);
    }

    .mk-icon{
      width: 38px; height: 38px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border-radius: 12px;
      background: rgba(37,99,235,.10);
      border: 1px solid rgba(37,99,235,.18);
      flex: 0 0 auto;
    }

    .mk-icon.purple{ background: rgba(111,66,193,.12); border-color: rgba(111,66,193,.18); }
    .mk-icon.green{ background: rgba(16,185,129,.12); border-color: rgba(16,185,129,.18); }
    .mk-icon.amber{ background: rgba(245,158,11,.14); border-color: rgba(245,158,11,.20); }
    .mk-icon.red{ background: rgba(239,68,68,.12); border-color: rgba(239,68,68,.20); }

    .mk-kicker{
      font-weight: 900;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: rgba(15,23,42,.65);
      font-size: .75rem;
    }

    .mk-section-title{
      color: var(--ink);
      font-weight: 900;
      letter-spacing: -0.02em;
    }

    .mk-lead{
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.05rem;
    }

    .mk-hr{
      border-top: 1px solid var(--line);
      margin: 2.5rem 0;
    }

    .mk-pill{
      display:inline-flex;
      align-items:center;
      border-radius:999px;
      padding:.35rem .65rem;
      font-weight:800;
      border:1px solid rgba(0,0,0,0.06);
      background: rgba(255,255,255,.85);
      margin: .25rem .35rem 0 0;
      color: rgba(15,23,42,.78);
      font-size: .85rem;
      backdrop-filter: blur(8px);
    }

    .mk-anchor{
      scroll-margin-top: 90px;
    }

    

    html{ scroll-behavior: smooth; }

    .mk-anchor:target{
      outline: 3px solid rgba(111,66,193,.18);
      border-radius: 16px;
    }
.mk-cta{
      background:
        radial-gradient(900px 420px at 20% 10%, rgba(111,66,193,.16), transparent 60%),
        radial-gradient(800px 380px at 85% 10%, rgba(37,99,235,.14), transparent 55%),
        linear-gradient(180deg, #ffffff, #fbfbff);
      border: 1px solid var(--line);
      border-radius: 22px;
      box-shadow: var(--shadow);
    }

    /* Bootstrap 4 accordion polish */
    .accordion .card{
      border-radius: 14px !important;
      overflow:hidden;
      border:1px solid var(--line);
      box-shadow: 0 12px 30px rgba(15,23,42,.06);
    }
    .accordion .card-header{
      background: #fff;
      border-bottom:1px solid var(--line);
    }
    .accordion .btn-link{
      text-decoration:none !important;
      font-weight:800;
      color: var(--ink) !important;
      width:100%;
      text-align:left;
    }
    .accordion .card-header button{
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .75rem;
      padding: .9rem 1rem;
    }
  </style>

  <!-- HERO -->
  <header class="mk-hero py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10 text-center">
