            <span class="mk-pill">✅ Web que convierte</span>
            <span class="mk-pill">✅ Soporte y evolución</span>
          </div>
        </div>
      </div>

      <!-- Quick value cards -->
      <div class="row mt-5">
        <div class="col-md-4 mb-3">
          <div class="mk-mini p-4 h-100">
            <div class="d-flex align-items-start">
              <span class="mk-icon amber me-3">📈</span>
              <div>
                <h3 class="h6 font-weight-bold mb-1">Web orientada a ventas</h3>
                <p class="mb-0 text-muted">Estructura pensada para convertir: velocidad, UX y SEO técnico.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <div class="mk-mini p-4 h-100">
            <div class="d-flex align-items-start">
              <span class="mk-icon green me-3">⚙️</span>
              <div>
                <h3 class="h6 font-weight-bold mb-1">Integraciones reales</h3>
                <p class="mb-0 text-muted">Pagos, APIs, CRM, automatizaciones y sistemas internos.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-3">
          <div class="mk-mini p-4 h-100">
            <div class="d-flex align-items-start">
              <span class="mk-icon purple me-3">🧠</span>
              <div>
                <h3 class="h6 font-weight-bold mb-1">Stack moderno y escalable</h3>
                <p class="mb-0 text-muted">Nuxt + NestJS + Headless CMS para crecer sin rehacer todo.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- NAV ANCHORS -->
  <section class="container py-4">
    <div class="mk-card p-3">
      <div class="d-flex flex-wrap justify-content-center">
        <a class="btn btn-link font-weight-bold" href="#servicios">🧩 Servicios</a>
        <a class="btn btn-link font-weight-bold" href="#seo">🔍 SEO</a>
        <a class="btn btn-link font-weight-bold" href="#tecnologias">🧱 Tecnologías</a>
        <a class="btn btn-link font-weight-bold" href="#proceso">🛠️ Proceso</a>
        <a class="btn btn-link font-weight-bold" href="#integraciones">🔌 Integraciones</a>
        <a class="btn btn-link font-weight-bold" href="#faq">❓ FAQ</a>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios" class="container py-5 mk-anchor">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="text-center mb-4">
          <div class="mk-kicker">Para pymes · startups tech · empresas medianas</div>
          <h2 class="mk-section-title display-4" style="font-size:2.2rem;">Qué hacemos en desarrollo web a medida</h2>
          <p class="mk-lead mb-0">
