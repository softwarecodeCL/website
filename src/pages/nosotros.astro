---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const SITE_URL = "https://www.softwarecode.cl/";
const pageUrl = `${SITE_URL}nosotros/`;

const pageTitle = "Quiénes Somos | Soluciones Digitales B2B en Chile";
const pageDescription =
  "SoftwareCode ayuda a empresas B2B a conectar sistemas, automatizar procesos y mejorar sus canales digitales con soluciones diseñadas para crecer.";

const socialImage = "/logosc-original.png";
const whatsappUrl =
  "https://wa.me/56988396128?text=Hola%2C%20quiero%20evaluar%20c%C3%B3mo%20mejorar%20un%20proceso%20digital%20de%20mi%20empresa.";

const expertise = [
  "Diagnóstico de procesos digitales",
  "Integración de sistemas empresariales",
  "Automatización y trazabilidad operativa",
  "Desarrollo de plataformas B2B",
  "Visibilidad digital y SEO técnico",
  "Optimización y evolución de soluciones"
];

const businessOutcomes = [
  "Menos tareas manuales",
  "Procesos trazables",
  "Sistemas conectados",
  "Canales digitales más rápidos",
  "Datos para tomar decisiones",
  "Soluciones preparadas para crecer"
];

const schemaExtras = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${pageUrl}#aboutpage`,
    "url": pageUrl,
    "name": pageTitle,
    "description": pageDescription,
    "isPartOf": { "@id": `${SITE_URL}#website` },
    "mainEntity": { "@id": `${SITE_URL}#organization` },
    "about": [
      { "@id": `${SITE_URL}#organization` },
      { "@id": `${pageUrl}#marco-estay` }
    ],
    "inLanguage": "es-CL",
    "dateModified": "2026-06-28"
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${pageUrl}#marco-estay`,
    "name": "Marco Estay",
    "jobTitle": "Fundador y consultor de soluciones digitales en SoftwareCode",
    "url": pageUrl,
    "worksFor": { "@id": `${SITE_URL}#organization` },
    "knowsAbout": expertise,
    "sameAs": [
      "https://www.linkedin.com/in/software-code-67b8543aa/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué hace SoftwareCode?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "SoftwareCode ayuda a empresas B2B a conectar sistemas, automatizar procesos, desarrollar plataformas y mejorar sus canales digitales para operar con mayor eficiencia y trazabilidad."
        }
      },
      {
        "@type": "Question",
        "name": "¿Quién lidera SoftwareCode?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "SoftwareCode es liderado por Marco Estay, ingeniero de software con más de diez años de experiencia en sistemas empresariales, integraciones, plataformas digitales y procesos críticos."
        }
      },
      {
        "@type": "Question",
        "name": "¿SoftwareCode puede integrarse con los sistemas que ya utiliza mi empresa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Cada proyecto comienza revisando la operación y la tecnología existente para determinar qué se puede integrar, mejorar o automatizar sin reemplazar innecesariamente sistemas que ya cumplen una función."
        }
      },
      {
        "@type": "Question",
        "name": "¿Con qué tipo de empresas trabaja SoftwareCode?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "SoftwareCode trabaja principalmente con empresas B2B, servicios profesionales, comercio especializado y organizaciones que necesitan ordenar procesos, conectar plataformas o fortalecer su canal digital."
        }
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={socialImage}
  url={pageUrl}
  schemaExtras={schemaExtras}
>
  <!-- HERO -->
  <section class="about-hero position-relative overflow-hidden">
    <div class="about-hero__glow about-hero__glow--one"></div>
    <div class="about-hero__glow about-hero__glow--two"></div>
    <div class="about-hero__grid"></div>

    <div class="container position-relative">
      <div class="row align-items-center g-5">
        <div class="col-12 col-lg-7" data-aos="fade-up" data-aos-duration="650">
          <nav aria-label="Breadcrumb" class="about-breadcrumb mb-4">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/">Inicio</a></li>
              <li class="breadcrumb-item active" aria-current="page">Nosotros</li>
            </ol>
          </nav>

          <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="about-badge">Soluciones digitales B2B</span>
            <span class="about-badge">Integración y automatización</span>
            <span class="about-badge">Santiago, Chile</span>
          </div>

          <h1 class="display-4 fw-bold lh-sm mb-4">
            Conectamos sistemas y automatizamos procesos para que tu empresa pueda
            <span class="about-gradient-text">escalar con control</span>
          </h1>

          <p class="lead text-secondary mb-4">
            Ayudamos a empresas B2B a conectar sus sistemas y automatizar sus procesos para que puedan escalar sin multiplicar tareas manuales.
          </p>

          <p class="text-secondary about-hero__support mb-4">
            Diseñamos soluciones digitales que reducen fricción, mejoran la trazabilidad y convierten la tecnología en una ventaja operativa y comercial.
          </p>

          <div class="d-grid gap-2 d-sm-flex">
            <a
              href={whatsappUrl}
              class="btn about-btn-primary btn-lg px-4"
              target="_blank"
              rel="noopener noreferrer"
              data-about-cta="hero-contact"
            >
              Evaluar un proceso de mi empresa
            </a>
            <a href="/proyectos/" class="btn about-btn-outline btn-lg px-4">
              Ver proyectos
            </a>
          </div>
        </div>

        <div class="col-12 col-lg-5" data-aos="fade-left" data-aos-duration="650">
          <div class="about-visual-card">
            <img
              src="/yo-image.png"
              alt="Marco Estay, fundador de SoftwareCode"
              width="720"
              height="820"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="about-main-image"
            />
            <div class="about-floating-proof">
              <span class="about-floating-proof__icon"><i class="bi bi-diagram-3"></i></span>
              <div>
                <strong>Negocio y tecnología conectados</strong>
                <span>Soluciones diseñadas alrededor del proceso real</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRUEBAS RÁPIDAS -->
  <section class="about-proof-strip border-top border-bottom">
    <div class="container">
      <div class="row g-0">
        <div class="col-12 col-md-4">
          <div class="about-proof-item">
            <i class="bi bi-calendar-check"></i>
            <div>
              <strong>Más de 10 años</strong>
              <span>resolviendo sistemas y procesos digitales</span>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="about-proof-item">
            <i class="bi bi-bezier2"></i>
            <div>
              <strong>Procesos conectados</strong>
              <span>menos duplicación y mayor trazabilidad</span>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="about-proof-item">
            <i class="bi bi-chat-square-text"></i>
            <div>
              <strong>Atención directa</strong>
              <span>diagnóstico y seguimiento sin intermediarios</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VISIÓN Y POSICIONAMIENTO -->
  <section class="py-5 about-section">
    <div class="container py-lg-4">
      <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-6" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Nuestra visión</span>
          <h2 class="about-title mt-2 mb-3">
            La tecnología debe resolver el proceso, no agregar complejidad
          </h2>
          <p class="text-secondary">
            SoftwareCode nace al detectar un problema frecuente: empresas que acumulan sitios, planillas, formularios, sistemas y proveedores, pero continúan dependiendo de tareas manuales para que la operación funcione.
          </p>
          <p class="text-secondary">
            No comenzamos recomendando una tecnología. Primero entendemos dónde se pierde tiempo, qué información se duplica, qué sistemas no conversan y qué parte del proceso limita el crecimiento.
          </p>
          <p class="text-secondary mb-0">
            A partir de ese diagnóstico diseñamos una solución realista: integrar lo que ya existe, automatizar lo repetitivo, construir lo que falta y medir el resultado para que la inversión tenga un propósito claro.
          </p>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade-left" data-aos-duration="650">
          <div class="about-principles-card">
            <div class="about-principle">
              <span>01</span>
              <div>
                <h3>Entendemos la operación</h3>
                <p>Identificamos el objetivo, los responsables, los datos y los puntos donde el proceso pierde eficiencia.</p>
              </div>
            </div>
            <div class="about-principle">
              <span>02</span>
              <div>
                <h3>Priorizamos el impacto</h3>
                <p>Ordenamos las mejoras según valor para el negocio, riesgo, esfuerzo y capacidad de implementación.</p>
              </div>
            </div>
            <div class="about-principle">
              <span>03</span>
              <div>
                <h3>Integramos antes de reemplazar</h3>
                <p>Aprovechamos los sistemas existentes cuando siguen siendo útiles y evitamos cambios costosos sin justificación.</p>
              </div>
            </div>
            <div class="about-principle">
              <span>04</span>
              <div>
                <h3>Medimos y evolucionamos</h3>
                <p>Definimos señales concretas para comprobar avances y decidir las siguientes etapas con información real.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIRECCIÓN -->
  <section class="py-5 about-section-soft border-top border-bottom">
    <div class="container py-lg-4">
      <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-5" data-aos="fade-right" data-aos-duration="650">
          <div class="about-founder-media">
            <img
              src="/yo.png"
              alt="Marco Estay, fundador y consultor de soluciones digitales en SoftwareCode"
              width="680"
              height="760"
              loading="lazy"
              decoding="async"
              class="about-founder-image"
            />
          </div>
        </div>

        <div class="col-12 col-lg-7" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Dirección y experiencia</span>
          <h2 class="about-title mt-2 mb-3">Una mirada técnica con criterio de negocio</h2>
          <p class="text-secondary">
            Lidero SoftwareCode con la visión de que la tecnología debe ser invisible: lo que importa es que el proceso funcione, sea trazable y genere resultados.
          </p>
          <p class="text-secondary">
            Soy Marco Estay, ingeniero de software con más de diez años de experiencia en plataformas empresariales, integraciones, servicios financieros, marketplaces B2B y sistemas vinculados a procesos críticos.
          </p>
          <p class="text-secondary">
            Participo directamente en el diagnóstico, la definición de la solución y el seguimiento de cada proyecto. Cuando el alcance requiere otras especialidades, se organiza el equipo adecuado manteniendo una dirección técnica y un punto de contacto claro.
          </p>

          <div class="row g-3 mt-1">
            <div class="col-12 col-sm-6">
              <div class="about-founder-point">
                <i class="bi bi-check2-circle"></i>
                <span>Diagnóstico de procesos</span>
              </div>
            </div>
            <div class="col-12 col-sm-6">
              <div class="about-founder-point">
                <i class="bi bi-check2-circle"></i>
                <span>Diseño de soluciones viables</span>
              </div>
            </div>
            <div class="col-12 col-sm-6">
              <div class="about-founder-point">
                <i class="bi bi-check2-circle"></i>
                <span>Integración entre negocio y tecnología</span>
              </div>
            </div>
            <div class="col-12 col-sm-6">
              <div class="about-founder-point">
                <i class="bi bi-check2-circle"></i>
                <span>Seguimiento y evolución</span>
              </div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2 mt-4">
            <a
              href="https://www.linkedin.com/in/software-code-67b8543aa/"
              class="btn about-btn-outline"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="bi bi-linkedin me-2"></i>Ver trayectoria
            </a>
            <a href="/proyectos/" class="btn about-btn-ghost">
              Conocer proyectos realizados
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RESULTADOS -->
  <section class="py-5 about-section">
    <div class="container py-lg-4">
      <div class="row justify-content-between align-items-end g-4 mb-4 mb-lg-5">
        <div class="col-12 col-lg-8" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Resultados que entregamos</span>
          <h2 class="about-title mt-2 mb-3">
            Soluciones orientadas a reducir fricción y mejorar el crecimiento
          </h2>
          <p class="text-secondary mb-0">
            El alcance cambia según cada empresa, pero la prioridad se mantiene: resolver un problema concreto y dejar una operación más clara, conectada y medible.
          </p>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-clipboard-data"></i></span>
            <h3>Auditoría de eficiencia operativa</h3>
            <p>Detectamos tareas repetitivas, duplicación de información, puntos de bloqueo y oportunidades de mejora dentro del proceso.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Evaluar mi operación <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650" data-aos-delay="60">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-diagram-2"></i></span>
            <h3>Integración sin reemplazar todo</h3>
            <p>Conectamos ERP, CRM, plataformas, APIs, formularios y bases de datos para evitar reprocesos y mantener la información sincronizada.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Consultar una integración <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650" data-aos-delay="120">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-gear-wide-connected"></i></span>
            <h3>Automatización y trazabilidad</h3>
            <p>Transformamos tareas manuales en flujos controlados, con estados, responsables, alertas y datos disponibles para seguimiento.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Revisar un proceso manual <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-window-stack"></i></span>
            <h3>Plataformas alineadas al negocio</h3>
            <p>Construimos portales, sistemas internos, catálogos y aplicaciones web alrededor de la operación y los usuarios reales.</p>
            <a href="/desarrollo-web-a-medida/">Conocer desarrollo a medida <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650" data-aos-delay="60">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-graph-up-arrow"></i></span>
            <h3>Visibilidad digital para venta B2B</h3>
            <p>Mejoramos estructura, rendimiento, indexación y contenido para que el canal digital atraiga oportunidades comerciales relevantes.</p>
            <a href="/agencia-marketing-digital/">Ver estrategia SEO y digital <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650" data-aos-delay="120">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-shield-check"></i></span>
            <h3>Continuidad y evolución técnica</h3>
            <p>Ordenamos despliegue, rendimiento, monitoreo y mantenimiento para reducir riesgos y permitir que la solución siga creciendo.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Evaluar una solución existente <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMA DE TRABAJO -->
  <section class="py-5 about-process-section border-top border-bottom">
    <div class="container py-lg-4">
      <div class="text-center mx-auto about-section-heading" data-aos="fade-up" data-aos-duration="650">
        <span class="about-kicker">Metodología</span>
        <h2 class="about-title mt-2 mb-3">Cómo convertimos un problema operativo en una solución digital</h2>
        <p class="text-secondary mb-0">
          Decisiones visibles, prioridades claras y avances que pueden validarse desde las primeras etapas.
        </p>
      </div>

      <div class="row g-4 mt-4">
        <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-duration="650">
          <div class="about-step h-100">
            <span class="about-step__number">01</span>
            <h3>Entender</h3>
            <p>Revisamos el proceso, las personas, los sistemas actuales y el resultado que la empresa necesita mejorar.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-duration="650" data-aos-delay="60">
          <div class="about-step h-100">
            <span class="about-step__number">02</span>
            <h3>Priorizar</h3>
            <p>Definimos qué resolver primero según impacto, dependencia, costo y riesgo para la operación.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-duration="650" data-aos-delay="120">
          <div class="about-step h-100">
            <span class="about-step__number">03</span>
            <h3>Implementar</h3>
            <p>Integramos, automatizamos o desarrollamos por etapas, validando cada avance con el proceso real.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-duration="650" data-aos-delay="180">
          <div class="about-step h-100">
            <span class="about-step__number">04</span>
            <h3>Medir y evolucionar</h3>
            <p>Observamos el resultado, corregimos fricciones y organizamos nuevas mejoras según evidencia.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPACTO Y DESAFÍOS -->
  <section class="py-5 about-section">
    <div class="container py-lg-4">
      <div class="row g-5">
        <div class="col-12 col-lg-7" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Impacto esperado</span>
          <h2 class="about-title mt-2 mb-3">Qué debería cambiar después de una buena solución</h2>
          <p class="text-secondary">
            La tecnología utilizada importa, pero para la empresa importa más el efecto que produce sobre la operación, el equipo y la capacidad de crecimiento.
          </p>
          <div class="about-tech-list mt-4">
            {businessOutcomes.map((outcome) => (
              <span>{outcome}</span>
            ))}
          </div>
        </div>

        <div class="col-12 col-lg-5" data-aos="fade-left" data-aos-duration="650">
          <div class="about-sector-card">
            <span class="about-kicker">Señales de oportunidad</span>
            <h2 class="h3 fw-bold mt-2 mb-3">Podemos aportar cuando tu empresa...</h2>
            <ul class="about-check-list mb-0">
              <li><i class="bi bi-check2"></i> Copia información entre sistemas o planillas</li>
              <li><i class="bi bi-check2"></i> Pierde seguimiento entre áreas o responsables</li>
              <li><i class="bi bi-check2"></i> Depende de tareas manuales para operar</li>
              <li><i class="bi bi-check2"></i> Tiene plataformas que no se comunican</li>
              <li><i class="bi bi-check2"></i> Necesita crecer sin aumentar el desorden</li>
              <li><i class="bi bi-check2"></i> No convierte su presencia digital en oportunidades</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-5 about-section-soft border-top">
    <div class="container py-lg-4">
      <div class="row g-5">
        <div class="col-12 col-lg-5" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Preguntas frecuentes</span>
          <h2 class="about-title mt-2 mb-3">Antes de iniciar una conversación</h2>
          <p class="text-secondary mb-0">
            Algunas respuestas sobre el enfoque de SoftwareCode y el tipo de desafíos que podemos evaluar.
          </p>
        </div>

        <div class="col-12 col-lg-7" data-aos="fade-left" data-aos-duration="650">
          <div class="accordion about-accordion" id="aboutFaq">
            <div class="accordion-item">
              <h3 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#aboutFaq1" aria-expanded="true" aria-controls="aboutFaq1">
                  ¿Qué hace SoftwareCode?
                </button>
              </h3>
              <div id="aboutFaq1" class="accordion-collapse collapse show" data-bs-parent="#aboutFaq">
                <div class="accordion-body">
                  Ayudamos a empresas B2B a conectar sistemas, automatizar procesos, desarrollar plataformas y mejorar sus canales digitales para operar con mayor eficiencia y trazabilidad.
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aboutFaq2" aria-expanded="false" aria-controls="aboutFaq2">
                  ¿Quién lidera SoftwareCode?
                </button>
              </h3>
              <div id="aboutFaq2" class="accordion-collapse collapse" data-bs-parent="#aboutFaq">
                <div class="accordion-body">
