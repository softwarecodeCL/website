---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const SITE_URL = "https://www.softwarecode.cl/";
const pageUrl = `${SITE_URL}nosotros/`;

const pageTitle = "Quiénes Somos: Software y SEO en Chile";
const pageDescription =
  "Conoce a SoftwareCode, empresa chilena especializada en desarrollo de software, SEO técnico, automatización e integraciones para negocios B2B.";

// Reemplaza esta imagen cuando tengas una fotografía real del equipo o fundador.
const socialImage = "/logosc-original.png";
const whatsappUrl =
  "https://wa.me/56988396128?text=Hola%2C%20quiero%20conversar%20sobre%20un%20proyecto%20digital%20para%20mi%20empresa.";

const expertise = [
  "Desarrollo de software y plataformas web a medida",
  "Integración de APIs, sistemas y servicios externos",
  "SEO técnico, rendimiento y arquitectura web",
  "Automatización de procesos comerciales",
  "Analítica, medición de conversiones y optimización",
  "Infraestructura cloud, despliegue y mantenimiento"
];

const technologies = [
  "Golang",
  "Node.js",
  "NestJS",
  "PHP",
  "Java",
  "Vue",
  "Nuxt",
  "React",
  "Astro",
  "PostgreSQL",
  "MySQL",
  "Docker",
  "AWS",
  "Cloudflare"
];

const schemaExtras = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${pageUrl}#aboutpage`,
    "url": pageUrl,
    "name": pageTitle,
    "description": pageDescription,
    "isPartOf": { "@id": `${SITE_URL}#website` },
    "mainEntity": { "@id": `${SITE_URL}#organization` },
    "about": [
      { "@id": `${SITE_URL}#organization` },
      { "@id": `${pageUrl}#marco-estay` }
    ],
    "inLanguage": "es-CL",
    "dateModified": "2026-06-23"
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${pageUrl}#marco-estay`,
    "name": "Marco Estay",
    "jobTitle": "Ingeniero de software y responsable de SoftwareCode",
    "url": pageUrl,
    "worksFor": { "@id": `${SITE_URL}#organization` },
    "knowsAbout": expertise,
    "sameAs": [
      "https://www.linkedin.com/in/software-code-67b8543aa/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué es SoftwareCode?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "SoftwareCode es una empresa chilena de servicios digitales especializada en desarrollo de software, sitios web, SEO técnico, integraciones y automatización para empresas."
        }
      },
      {
        "@type": "Question",
        "name": "¿Quién está detrás de SoftwareCode?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "SoftwareCode es liderado por Marco Estay, ingeniero de software con más de diez años de experiencia en desarrollo backend, frontend, integraciones, bases de datos, nube y soluciones digitales para empresas."
        }
      },
      {
        "@type": "Question",
        "name": "¿Con qué tipo de empresas trabaja SoftwareCode?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "SoftwareCode trabaja principalmente con empresas B2B, servicios profesionales, comercio especializado, industria y organizaciones que necesitan desarrollar, integrar u optimizar sus canales digitales."
        }
      },
      {
        "@type": "Question",
        "name": "¿Atienden empresas fuera de Santiago?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. SoftwareCode trabaja de manera remota con empresas de Santiago y otras regiones de Chile, organizando cada proyecto mediante etapas, entregables y seguimiento."
        }
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={socialImage}
  url={pageUrl}
  schemaExtras={schemaExtras}
>
  <!-- HERO -->
  <section class="about-hero position-relative overflow-hidden">
    <div class="about-hero__glow about-hero__glow--one"></div>
    <div class="about-hero__glow about-hero__glow--two"></div>
    <div class="about-hero__grid"></div>

    <div class="container position-relative">
      <div class="row align-items-center g-5">
        <div class="col-12 col-lg-7" data-aos="fade-up" data-aos-duration="650">
          <nav aria-label="Breadcrumb" class="about-breadcrumb mb-4">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/">Inicio</a></li>
              <li class="breadcrumb-item active" aria-current="page">Nosotros</li>
            </ol>
          </nav>

          <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="about-badge">SoftwareCode</span>
            <span class="about-badge">Santiago, Chile</span>
            <span class="about-badge">Más de 10 años de experiencia</span>
          </div>

          <h1 class="display-4 fw-bold lh-sm mb-4">
            Desarrollo de software, SEO técnico y automatización con
            <span class="about-gradient-text">experiencia real</span>
          </h1>

          <p class="lead text-secondary mb-4">
            SoftwareCode es una empresa chilena que combina ingeniería de software,
            optimización web y estrategia digital para ayudar a empresas a construir
            plataformas más rápidas, conectadas y preparadas para generar oportunidades.
          </p>

          <p class="text-secondary about-hero__support mb-4">
            Trabajamos directamente con cada cliente, desde el diagnóstico y la arquitectura
            hasta la implementación, medición y mejora continua del proyecto.
          </p>

          <div class="d-grid gap-2 d-sm-flex">
            <a
              href={whatsappUrl}
              class="btn about-btn-primary btn-lg px-4"
              target="_blank"
              rel="noopener noreferrer"
              data-about-cta="hero-contact"
            >
              Conversar sobre un proyecto
            </a>
            <a href="/desarrollo-web-a-medida/" class="btn about-btn-outline btn-lg px-4">
              Ver servicios
            </a>
          </div>
        </div>

        <div class="col-12 col-lg-5" data-aos="fade-left" data-aos-duration="650">
          <div class="about-visual-card">
              <img
                src="/yo2.png"
                alt="Equipo de SoftwareCode desarrollando soluciones digitales en Chile"
                width="720"
                height="820"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="about-main-image"
              />
            <div class="about-floating-proof">
              <span class="about-floating-proof__icon"><i class="bi bi-code-slash"></i></span>
              <div>
                <strong>Ingeniería + estrategia</strong>
                <span>Una sola mirada para negocio y tecnología</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRUEBAS RÁPIDAS -->
  <section class="about-proof-strip border-top border-bottom">
    <div class="container">
      <div class="row g-0">
        <div class="col-12 col-md-4">
          <div class="about-proof-item">
            <i class="bi bi-calendar-check"></i>
            <div>
              <strong>Más de 10 años</strong>
              <span>desarrollando soluciones digitales</span>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="about-proof-item">
            <i class="bi bi-diagram-3"></i>
            <div>
              <strong>Experiencia integral</strong>
              <span>software, integraciones, SEO y nube</span>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="about-proof-item">
            <i class="bi bi-chat-square-text"></i>
            <div>
              <strong>Atención directa</strong>
              <span>sin intermediarios innecesarios</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HISTORIA Y POSICIONAMIENTO -->
  <section class="py-5 about-section">
    <div class="container py-lg-4">
      <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-6" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Quiénes somos</span>
          <h2 class="about-title mt-2 mb-3">
            Una empresa de desarrollo de software en Chile con enfoque técnico y comercial
          </h2>
          <p class="text-secondary">
            SoftwareCode nace para resolver un problema frecuente: muchas empresas contratan
            desarrollo, marketing, analítica y automatización por separado, pero nadie conecta
            todas las piezas del proceso.
          </p>
          <p class="text-secondary">
            Nuestra forma de trabajo une arquitectura, experiencia de usuario, velocidad,
            posicionamiento en buscadores, medición e integración de sistemas. El objetivo no es
            entregar una página aislada, sino una solución digital que pueda operar, crecer y
            mejorar con datos reales.
          </p>
          <p class="text-secondary mb-0">
            Tenemos experiencia en marketplaces B2B, plataformas empresariales, biometría,
            servicios financieros, comercio especializado, integraciones de APIs y sistemas
            orientados a procesos críticos.
          </p>
        </div>

        <div class="col-12 col-lg-6" data-aos="fade-left" data-aos-duration="650">
          <div class="about-principles-card">
            <div class="about-principle">
              <span>01</span>
              <div>
                <h3>Primero entendemos el negocio</h3>
                <p>Antes de recomendar tecnología, identificamos el objetivo, el proceso y las restricciones reales.</p>
              </div>
            </div>
            <div class="about-principle">
              <span>02</span>
              <div>
                <h3>Diseñamos una solución mantenible</h3>
                <p>Priorizamos arquitectura clara, seguridad, rendimiento y capacidad de evolución.</p>
              </div>
            </div>
            <div class="about-principle">
              <span>03</span>
              <div>
                <h3>Medimos después de implementar</h3>
                <p>Configuramos datos y conversiones para saber qué funciona y qué se debe mejorar.</p>
              </div>
            </div>
            <div class="about-principle">
              <span>04</span>
              <div>
                <h3>Acompañamos el crecimiento</h3>
                <p>El proyecto no termina con el despliegue: puede continuar con soporte, optimización y nuevas etapas.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RESPONSABLE -->
  <section class="py-5 about-section-soft border-top border-bottom">
    <div class="container py-lg-4">
      <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-5" data-aos="fade-right" data-aos-duration="650">
          <div class="about-founder-media">
              <img
                src="/yo.png"
                alt="Marco Estay, ingeniero de software responsable de SoftwareCode"
                width="680"
                height="760"
                loading="lazy"
                decoding="async"
                class="about-founder-image"
              />
          </div>
        </div>

        <div class="col-12 col-lg-7" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Responsable de SoftwareCode</span>
          <h2 class="about-title mt-2 mb-3">Marco Estay, ingeniero de software</h2>
          <p class="text-secondary">
            Soy ingeniero de software con más de diez años de experiencia construyendo y
            manteniendo sistemas web, APIs, integraciones, procesos backend y productos digitales
            para empresas.
          </p>
          <p class="text-secondary">
            He trabajado con tecnologías como Golang, Node.js, Java, PHP, Vue, React, Nuxt,
            PostgreSQL, MySQL, Docker y AWS. Esta experiencia permite evaluar un proyecto desde
            una mirada completa: negocio, arquitectura, implementación, rendimiento, seguridad,
            posicionamiento y operación.
          </p>
          <p class="text-secondary">
            En SoftwareCode participo directamente en el diagnóstico, diseño y seguimiento de cada
            solución. Cuando un proyecto requiere otras especialidades, se organiza un equipo según
            el alcance, manteniendo un punto de contacto claro para el cliente.
          </p>

          <div class="row g-3 mt-1">
            <div class="col-12 col-sm-6">
              <div class="about-founder-point">
                <i class="bi bi-check2-circle"></i>
                <span>Experiencia backend y frontend</span>
              </div>
            </div>
            <div class="col-12 col-sm-6">
              <div class="about-founder-point">
                <i class="bi bi-check2-circle"></i>
                <span>Arquitectura e integraciones</span>
              </div>
            </div>
            <div class="col-12 col-sm-6">
              <div class="about-founder-point">
                <i class="bi bi-check2-circle"></i>
                <span>SEO técnico y rendimiento</span>
              </div>
            </div>
            <div class="col-12 col-sm-6">
              <div class="about-founder-point">
                <i class="bi bi-check2-circle"></i>
                <span>Infraestructura y despliegue</span>
              </div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2 mt-4">
            <a
              href="https://www.linkedin.com/in/software-code-67b8543aa/"
              class="btn about-btn-outline"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="bi bi-linkedin me-2"></i>Ver LinkedIn
            </a>
            <a href="/blog/" class="btn about-btn-ghost">
              Ver artículos y experiencia
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ESPECIALIDADES -->
  <section class="py-5 about-section">
    <div class="container py-lg-4">
      <div class="row justify-content-between align-items-end g-4 mb-4 mb-lg-5">
        <div class="col-12 col-lg-8" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Especialidades</span>
          <h2 class="about-title mt-2 mb-3">
            Capacidades para construir y mejorar ecosistemas digitales completos
          </h2>
          <p class="text-secondary mb-0">
            Cada servicio puede contratarse de forma independiente o combinarse dentro de un proyecto por etapas.
          </p>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-window-stack"></i></span>
            <h3>Desarrollo de software y plataformas web</h3>
            <p>Aplicaciones, portales, sistemas internos y soluciones web diseñadas según procesos reales de negocio.</p>
            <a href="/desarrollo-web-a-medida/">Conocer desarrollo web <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650" data-aos-delay="60">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-diagram-2"></i></span>
            <h3>Integración de APIs y sistemas</h3>
            <p>Conexión entre plataformas, servicios externos, bases de datos, formularios, CRM y procesos empresariales.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Consultar una integración <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650" data-aos-delay="120">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-search"></i></span>
            <h3>SEO técnico y rendimiento web</h3>
            <p>Auditoría, indexación, estructura, velocidad y contenido orientado a mejorar visibilidad y captación orgánica.</p>
            <a href="/agencia-marketing-digital/">Ver marketing y SEO <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-gear-wide-connected"></i></span>
            <h3>Automatización de procesos</h3>
            <p>Flujos para reducir tareas manuales, ordenar contactos, activar seguimientos y mejorar la trazabilidad.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Evaluar automatización <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650" data-aos-delay="60">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-bar-chart-line"></i></span>
            <h3>Medición y optimización</h3>
            <p>Configuración de eventos, conversiones y paneles para comprender el comportamiento y priorizar mejoras.</p>
            <a href="/blog/">Revisar guías técnicas <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up" data-aos-duration="650" data-aos-delay="120">
          <article class="about-service-card h-100">
            <span class="about-service-icon"><i class="bi bi-cloud-check"></i></span>
            <h3>Infraestructura y soporte</h3>
            <p>Despliegue, nube, contenedores, monitoreo, mantenimiento y evolución técnica de soluciones digitales.</p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Consultar soporte <i class="bi bi-arrow-right"></i></a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMA DE TRABAJO -->
  <section class="py-5 about-process-section border-top border-bottom">
    <div class="container py-lg-4">
      <div class="text-center mx-auto about-section-heading" data-aos="fade-up" data-aos-duration="650">
        <span class="about-kicker">Metodología</span>
        <h2 class="about-title mt-2 mb-3">Cómo trabajamos un proyecto digital</h2>
        <p class="text-secondary mb-0">
          Un proceso simple, con decisiones visibles y entregables claros desde el inicio.
        </p>
      </div>

      <div class="row g-4 mt-4">
        <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-duration="650">
          <div class="about-step h-100">
            <span class="about-step__number">01</span>
            <h3>Diagnóstico</h3>
            <p>Revisamos objetivos, usuarios, procesos, tecnología existente y principales restricciones.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-duration="650" data-aos-delay="60">
          <div class="about-step h-100">
            <span class="about-step__number">02</span>
            <h3>Propuesta y arquitectura</h3>
            <p>Definimos alcance, prioridades, solución técnica, etapas, costos y criterios de éxito.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-duration="650" data-aos-delay="120">
          <div class="about-step h-100">
            <span class="about-step__number">03</span>
            <h3>Implementación</h3>
            <p>Desarrollamos por avances verificables, validando funcionalidad, rendimiento y experiencia.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-duration="650" data-aos-delay="180">
          <div class="about-step h-100">
            <span class="about-step__number">04</span>
            <h3>Medición y evolución</h3>
            <p>Publicamos, medimos resultados y organizamos mejoras según impacto y nuevas necesidades.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TECNOLOGÍAS Y SECTORES -->
  <section class="py-5 about-section">
    <div class="container py-lg-4">
      <div class="row g-5">
        <div class="col-12 col-lg-7" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Tecnologías</span>
          <h2 class="about-title mt-2 mb-3">Herramientas elegidas según cada solución</h2>
          <p class="text-secondary">
            No forzamos todos los proyectos a utilizar la misma tecnología. Evaluamos mantenimiento,
            rendimiento, equipo, presupuesto e integración con la operación existente.
          </p>
          <div class="about-tech-list mt-4">
            {technologies.map((technology) => (
              <span>{technology}</span>
            ))}
          </div>
        </div>

        <div class="col-12 col-lg-5" data-aos="fade-left" data-aos-duration="650">
          <div class="about-sector-card">
            <span class="about-kicker">Sectores y desafíos</span>
            <h2 class="h3 fw-bold mt-2 mb-3">Experiencia aplicable a distintos negocios</h2>
            <ul class="about-check-list mb-0">
              <li><i class="bi bi-check2"></i> Servicios profesionales y empresas B2B</li>
              <li><i class="bi bi-check2"></i> Marketplaces y plataformas de operación</li>
              <li><i class="bi bi-check2"></i> Comercio especializado y catálogos técnicos</li>
              <li><i class="bi bi-check2"></i> Servicios financieros e integraciones críticas</li>
              <li><i class="bi bi-check2"></i> Procesos internos y automatización comercial</li>
              <li><i class="bi bi-check2"></i> Sitios con problemas de SEO y rendimiento</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-5 about-section-soft border-top">
    <div class="container py-lg-4">
      <div class="row g-5">
        <div class="col-12 col-lg-5" data-aos="fade-up" data-aos-duration="650">
          <span class="about-kicker">Preguntas frecuentes</span>
          <h2 class="about-title mt-2 mb-3">Conoce mejor a SoftwareCode</h2>
          <p class="text-secondary mb-0">
            Estas respuestas aclaran cómo se organiza el trabajo y qué tipo de proyectos podemos evaluar.
          </p>
        </div>

        <div class="col-12 col-lg-7" data-aos="fade-left" data-aos-duration="650">
          <div class="accordion about-accordion" id="aboutFaq">
            <div class="accordion-item">
              <h3 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#aboutFaq1" aria-expanded="true" aria-controls="aboutFaq1">
                  ¿Qué es SoftwareCode?
                </button>
              </h3>
              <div id="aboutFaq1" class="accordion-collapse collapse show" data-bs-parent="#aboutFaq">
                <div class="accordion-body">
                  SoftwareCode es una empresa chilena de servicios digitales especializada en desarrollo de software,
                  sitios web, SEO técnico, integraciones y automatización para empresas.
                </div>
              </div>
            </div>

            <div class="accordion-item">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aboutFaq2" aria-expanded="false" aria-controls="aboutFaq2">
                  ¿Quién está detrás de SoftwareCode?
                </button>
              </h3>
              <div id="aboutFaq2" class="accordion-collapse collapse" data-bs-parent="#aboutFaq">
                <div class="accordion-body">
