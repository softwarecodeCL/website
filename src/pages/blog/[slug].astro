---
export const prerender = true;
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(p => !p.data.draft)
  return posts.map(p => ({
    params: { slug: p.slug },
  }))
}

const { slug } = Astro.params

// Busca el post por slug (esto evita el undefined)
const allPosts = (await getCollection('blog')).filter(p => !p.data.draft)
const post = allPosts.find(p => p.slug === slug)

if (!post) {
  // Si no existe, lanza 404 real
  throw new Error(`Post no encontrado: ${slug}`)
}

const { Content } = await post.render()

const title = post.data.title
const description = post.data.description
const image = post.data.image || '/img/blog/blog-hero.jpg'
const publishedTime = post.data.date
const updatedTime = post.data.updatedAt || post.data.date
const category = post.data.category
const tags = post.data.tags || []


const slugifyTag = (value: any) =>
  value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');


// Canonical robusto (sin romper si Astro.site viene vacío)
const siteOrigin = Astro.site?.origin || 'https://www.softwarecode.cl'
const canonical = `${siteOrigin}/blog/${post.slug}`

// Datos base para schema (sin inventar dirección/ratings)
const orgName = 'SoftwareCode.cl'
const orgLogo = `${siteOrigin}/logosc-original.png`
const blogUrl = `${siteOrigin}/blog`

// ✅ JSON-LD mejorado (sin borrar tu idea original, solo reforzado)
const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}#organization`,
      "name": orgName,
      "url": siteOrigin,
      "logo": {
        "@type": "ImageObject",
        "@id": `${siteOrigin}#logo`,
        "url": orgLogo
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}#website`,
      "url": siteOrigin,
      "name": orgName,
      "publisher": { "@id": `${siteOrigin}#organization` },
      "inLanguage": "es-CL"
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteOrigin}#website` },
      "inLanguage": "es-CL"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumbs`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteOrigin },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": blogUrl },
        { "@type": "ListItem", "position": 3, "name": title, "item": canonical }
      ]
    },
    {
      "@type": "BlogPosting",
      "@id": `${canonical}#blogposting`,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
      "headline": title,
      "description": description,
      "image": [
        image.startsWith("http") ? image : `${siteOrigin}${image}`
      ],
      "datePublished": (publishedTime instanceof Date) ? publishedTime.toISOString() : publishedTime,
      "dateModified": (updatedTime instanceof Date) ? updatedTime.toISOString() : updatedTime,

      "inLanguage": "es-CL",
      "articleSection": category,
      "keywords": tags,
      "author": {
        "@type": "Person",
        "name": post.data.author || "Software Code"
      },
      "publisher": {
        "@type": "Organization",
        "@id": `${siteOrigin}#organization`,
        "name": orgName,
        "url": siteOrigin,
        "logo": {
          "@type": "ImageObject",
          "url": orgLogo
        }
      }
    }
  ]
}
---

<Layout title={title} description={description} image={image} url={canonical} type="article"
  publishedTime={(publishedTime instanceof Date) ? publishedTime.toISOString() : publishedTime}
  modifiedTime={(updatedTime instanceof Date) ? updatedTime.toISOString() : updatedTime}>
  
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)}></script>

  <header class="article-hero">
    <div class="container py-4 py-lg-5">
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-transparent p-0 mb-0">
          <li class="breadcrumb-item"><a href="/" class="text-muted">Inicio</a></li>
          <li class="breadcrumb-item"><a href="/blog/" class="text-muted">Blog</a></li>
          <li class="breadcrumb-item active" aria-current="page">{title}</li>
        </ol>
      </nav>

      <div class="row align-items-center">
        <div class="col-lg-7">
          <div class="d-flex flex-wrap align-items-center mb-3">
            <!-- BS4 -> BS5: mr-2 => me-2 -->
            <span class="article-pill me-2">{category}</span>

            <small class="text-muted">
              {post.data.date.toLocaleDateString('es-CL', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </small>

            {post.data.updatedAt && (
              // BS4 -> BS5: ml-3 => ms-3
              <small class="text-muted ms-3">
                • Actualizado: {post.data.updatedAt.toLocaleDateString('es-CL', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </small>
            )}
          </div>

          <h1 class="article-title mb-3">{title}</h1>
          <p class="article-subtitle mb-4">{description}</p>

          {tags.length > 0 && (
            <div class="d-flex flex-wrap">
              {tags.map(t => (
                // BS4 -> BS5: mr-2 => me-2
                <a
                  class="article-tag me-2 mb-2"
                  href={`/tag/${slugifyTag(t)}/`}
                >
                  #{t}
                </a>
              ))}
            </div>
          )}
        </div>

        <div class="col-lg-5 mt-4 mt-lg-0">
          <div class="article-media">
            <img
              src={image}
              alt={title}
              class="img-fluid article-img"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="article-wave" aria-hidden="true"></div>
  </header>

  <main class="article-body">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-12 col-xl-12">
          <article class="article-content">
            <Content />
          </article>

          <footer class="article-footer">
            <a class="article-back" href="/blog/">
              ← Volver al blog
            </a>

            <div class="article-footer-meta">
              Categoría: <strong>{category}</strong>
            </div>
          </footer>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
/* =====================================================
   Article detail — versión definitiva
   Scope seguro: solo .article-hero, .article-body y .article-content
   ===================================================== */

.article-hero {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  color: #fff;
  background:
    radial-gradient(900px 460px at 8% 0%, rgba(124, 58, 237, .34), transparent 62%),
    radial-gradient(820px 430px at 92% 12%, rgba(236, 72, 153, .22), transparent 58%),
    radial-gradient(780px 440px at 55% 100%, rgba(56, 189, 248, .13), transparent 58%),
    linear-gradient(180deg, #050816 0%, #070a12 100%);
  border-bottom: 1px solid rgba(255, 255, 255, .10);
}

.article-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  opacity: .18;
  background-image:
    linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
  background-size: 58px 58px;
  mask-image: linear-gradient(to bottom, black, transparent 76%);
}

.article-hero::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -1px;
  width: min(920px, 86vw);
  height: 1px;
  transform: translateX(-50%);
  background: linear-gradient(90deg, transparent, rgba(236,72,153,.72), rgba(124,58,237,.92), rgba(56,189,248,.72), transparent);
  box-shadow: 0 0 34px rgba(124, 58, 237, .42);
}

.article-hero .container {
  position: relative;
  z-index: 1;
}

.article-hero .breadcrumb {
  --bs-breadcrumb-divider-color: rgba(255,255,255,.36);
  margin-top: .4rem;
}

.article-hero .breadcrumb-item,
.article-hero .breadcrumb-item.active {
  color: rgba(226, 232, 240, .72);
}

.article-hero .breadcrumb a {
  color: rgba(226, 232, 240, .76) !important;
  text-decoration: none;
  font-weight: 750;
}

.article-hero .breadcrumb a:hover {
  color: #fff !important;
}

.article-pill {
  display: inline-flex;
  align-items: center;
  padding: .48rem .8rem;
  border-radius: 999px;
  border: 1px solid rgba(216, 180, 254, .24);
  color: rgba(255,255,255,.92);
  background:
    linear-gradient(135deg, rgba(124,58,237,.22), rgba(236,72,153,.12)),
    rgba(255,255,255,.055);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
  font-size: .78rem;
  font-weight: 950;
  letter-spacing: .035em;
  text-transform: uppercase;
}

.article-hero small,
.article-hero .text-muted {
  color: rgba(226, 232, 240, .68) !important;
}

.article-title {
  max-width: 760px;
  margin: 0;
  color: #fff;
  font-size: clamp(2.35rem, 6vw, 5.25rem);
  line-height: .98;
  letter-spacing: -.072em;
  font-weight: 950;
  text-wrap: balance;
}

.article-subtitle {
  max-width: 680px;
  color: rgba(226, 232, 240, .84);
  font-size: clamp(1.06rem, 1.8vw, 1.26rem);
  line-height: 1.75;
  text-wrap: pretty;
}

.article-tag {
  display: inline-flex;
  align-items: center;
  padding: .45rem .72rem;
  border-radius: 999px;
  border: 1px solid rgba(147,197,253,.22);
  color: #dbeafe;
  background: rgba(59,130,246,.10);
  text-decoration: none !important;
  font-size: .82rem;
  font-weight: 850;
  transition: transform .18s ease, background .18s ease, border-color .18s ease;
}

.article-tag:hover {
  color: #fff;
  border-color: rgba(216,180,254,.34);
  background: rgba(124,58,237,.18);
  transform: translateY(-1px);
}

.article-media {
  position: relative;
  padding: 10px;
  border-radius: 28px;
  border: 1px solid rgba(255,255,255,.16);
  background:
    linear-gradient(135deg, rgba(255,255,255,.12), rgba(255,255,255,.045)),
    rgba(15, 23, 42, .42);
  box-shadow:
    0 32px 90px rgba(0,0,0,.34),
    inset 0 1px 0 rgba(255,255,255,.09);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.article-img {
  display: block;
  width: 100%;
  height: clamp(250px, 30vw, 380px);
  object-fit: cover;
  border-radius: 20px;
}

.article-wave {
  height: 44px;
  background:
    radial-gradient(80px 34px at 12% 0, rgba(255,255,255,.10), transparent 70%),
    radial-gradient(110px 44px at 44% 0, rgba(139,92,246,.16), transparent 70%),
    radial-gradient(92px 38px at 78% 0, rgba(56,189,248,.12), transparent 70%);
}

/* Body */
.article-body {
  position: relative;
  padding: 76px 0 110px;
  background:
    radial-gradient(900px 520px at 12% 10%, rgba(124,58,237,.13), transparent 58%),
    radial-gradient(760px 460px at 88% 24%, rgba(236,72,153,.09), transparent 58%),
    linear-gradient(180deg, #050816 0%, #070a12 52%, #050816 100%);
}

/* Contenido MDX */
.article-content {
  position: relative;
  padding: clamp(28px, 5vw, 62px);
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 34px;
  color: #1e293b;
  background:
    linear-gradient(180deg, rgba(255,255,255,.99), rgba(248,250,252,.97)),
    #fff;
  box-shadow:
    0 34px 120px rgba(0,0,0,.42),
    inset 0 1px 0 rgba(255,255,255,.75);
  overflow: hidden;
}

.article-content::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 8px;
  background: linear-gradient(90deg, #ec4899, #7c3aed, #38bdf8);
}

.article-content > * {
  position: relative;
  z-index: 1;
}

/* Evita título duplicado si el MDX trae # H1 */
.article-content > h1:first-child {
  display: none;
}

.article-content p {
  margin: 0 0 1.45rem;
  color: #334155;
  font-size: clamp(1.02rem, 1.2vw, 1.12rem);
  line-height: 1.88;
  text-wrap: pretty;
}

.article-content strong {
  color: #0f172a;
  font-weight: 900;
}

.article-content em {
  color: #475569;
}

.article-content a {
  color: #6d28d9;
  font-weight: 850;
  text-decoration: none;
  background:
    linear-gradient(90deg, rgba(124,58,237,.28), rgba(236,72,153,.24))
    0 100% / 100% 2px no-repeat;
  transition: color .18s ease, background-size .18s ease;
}

.article-content a:hover {
  color: #4c1d95;
  background-size: 100% 100%;
}

.article-content h2 {
  position: relative;
  margin: 4.2rem 0 1.25rem;
  padding-top: 1.25rem;
  color: #08111f;
  font-size: clamp(1.85rem, 4vw, 3rem);
  line-height: 1.08;
  letter-spacing: -.055em;
  font-weight: 950;
  text-wrap: balance;
}

.article-content h2::before {
  content: "";
  display: block;
  width: 78px;
  height: 5px;
  margin-bottom: 18px;
  border-radius: 999px;
  background: linear-gradient(90deg, #ec4899, #7c3aed, #38bdf8);
  box-shadow: 0 12px 30px rgba(124,58,237,.22);
}

.article-content h3 {
  margin: 2.8rem 0 1rem;
  color: #111827;
  font-size: clamp(1.32rem, 2.5vw, 1.82rem);
  line-height: 1.22;
  letter-spacing: -.035em;
  font-weight: 920;
}

.article-content h4 {
  margin: 2rem 0 .85rem;
  color: #1e293b;
  font-size: 1.14rem;
  line-height: 1.35;
  font-weight: 900;
}

.article-content hr {
  margin: 3.4rem 0;
  border: 0;
  height: 1px;
  opacity: 1;
  background: linear-gradient(90deg, transparent, rgba(15,23,42,.16), transparent);
}

/* Listas */
.article-content ul,
.article-content ol {
  margin: 0 0 1.8rem;
  padding: 0;
  list-style: none;
}

.article-content li {
  position: relative;
  margin-bottom: .8rem;
  padding-left: 2rem;
  color: #334155;
  font-size: 1.04rem;
  line-height: 1.75;
}

.article-content ul li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .72em;
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: linear-gradient(135deg, #ec4899, #7c3aed, #38bdf8);
  box-shadow: 0 0 0 5px rgba(124,58,237,.10);
}

.article-content ol {
  counter-reset: sc-counter;
}

.article-content ol li {
  counter-increment: sc-counter;
}

.article-content ol li::before {
  content: counter(sc-counter);
  position: absolute;
  left: 0;
  top: .18em;
  width: 25px;
  height: 25px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(135deg, #7c3aed, #ec4899);
  font-size: .78rem;
  font-weight: 950;
}

/* Blockquote */
.article-content blockquote {
  margin: 2.6rem 0;
  padding: 1.6rem 1.7rem;
  border-left: 6px solid #7c3aed;
  border-radius: 22px;
  color: #1e293b;
  background:
    linear-gradient(135deg, rgba(124,58,237,.09), rgba(236,72,153,.06)),
    #fff;
  box-shadow:
    0 20px 50px rgba(15,23,42,.08),
    inset 0 0 0 1px rgba(124,58,237,.10);
}

.article-content blockquote p {
  margin-bottom: 0;
  color: #1e293b;
  font-size: 1.1rem;
  line-height: 1.75;
}

/* Código */
.article-content code {
  padding: .2rem .42rem;
  border-radius: 8px;
  color: #7e22ce;
  background: rgba(124,58,237,.08);
  font-size: .92em;
  font-weight: 750;
}

.article-content pre {
  margin: 2rem 0;
  padding: 1.35rem;
  border-radius: 22px;
  color: #e2e8f0;
  background: linear-gradient(135deg, #0f172a, #020617);
  box-shadow: 0 22px 60px rgba(15,23,42,.26);
  overflow-x: auto;
}

.article-content pre code {
  padding: 0;
  color: inherit;
  background: transparent;
  font-weight: 500;
}

/* Tablas */
.article-content table {
  width: 100%;
  margin: 2.4rem 0;
  border-collapse: separate;
  border-spacing: 0;
  overflow: hidden;
  border: 1px solid rgba(15,23,42,.10);
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 22px 60px rgba(15,23,42,.08);
}

.article-content thead {
  background:
    linear-gradient(135deg, rgba(124,58,237,.13), rgba(236,72,153,.08)),
    #f8fafc;
}

.article-content th {
  color: #0f172a;
  font-weight: 950;
}

.article-content th,
.article-content td {
  padding: 1rem 1.1rem;
  border-bottom: 1px solid rgba(15,23,42,.08);
  vertical-align: top;
  text-align: left;
}

.article-content tr:last-child td {
  border-bottom: 0;
}

.article-content td {
  color: #334155;
}

/* Bootstrap dentro del MDX */
.article-content .alert,
.article-content .card {
  margin: 2rem 0;
  border: 1px solid rgba(15,23,42,.10) !important;
  border-radius: 24px !important;
  color: #1e293b !important;
  background: #fff !important;
  box-shadow: 0 22px 60px rgba(15,23,42,.08) !important;
  overflow: hidden;
}

.article-content .alert {
  padding: 1.35rem 1.45rem;
}

.article-content .alert-light {
  border-left: 6px solid #7c3aed !important;
}

.article-content .alert-warning {
  border-left: 6px solid #f59e0b !important;
}

.article-content .alert-danger {
  border-left: 6px solid #ef4444 !important;
}

.article-content .card-body {
  padding: clamp(1.35rem, 4vw, 2.4rem);
}

.article-content .text-muted {
  color: #475569 !important;
}

.article-content .mb-0 {
  margin-bottom: 0 !important;
}

.article-content .table-responsive {
  margin: 2.4rem 0;
  border-radius: 22px;
  overflow-x: auto;
  box-shadow: 0 22px 60px rgba(15,23,42,.08);
}

.article-content .table {
  margin: 0;
  --bs-table-bg: #fff;
  --bs-table-color: #334155;
  --bs-table-border-color: rgba(15,23,42,.08);
}

/* Imágenes internas */
.article-content img {
  max-width: 100%;
  height: auto;
}

.article-content p > img {
  display: block;
  width: 100%;
  margin: 2.4rem auto;
  border-radius: 26px;
  border: 1px solid rgba(15,23,42,.10);
  box-shadow: 0 26px 80px rgba(15,23,42,.16);
}

/* Botones/CTA */
.article-content .btn,
.article-content .btn-primary,
.article-content a.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .45rem;
  border: 0 !important;
  border-radius: 999px !important;
  padding: .9rem 1.35rem !important;
  color: #fff !important;
  background: linear-gradient(135deg, #7c3aed, #db2777, #2563eb) !important;
  box-shadow:
    0 18px 46px rgba(124,58,237,.26),
    inset 0 1px 0 rgba(255,255,255,.18);
  font-weight: 950;
  text-decoration: none !important;
}

.article-content .btn:hover,
.article-content a.btn:hover {
  transform: translateY(-1px);
  filter: brightness(1.05);
}

.article-content [id] {
  scroll-margin-top: 124px;
}

/* Footer */
.article-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 2rem;
  padding: 1.2rem 1.25rem;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 24px;
  color: rgba(226,232,240,.76);
  background: rgba(255,255,255,.055);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.article-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(216,180,254,.24);
  border-radius: 999px;
  padding: .78rem 1.05rem;
  color: #fff;
  background: rgba(255,255,255,.075);
  text-decoration: none;
  font-weight: 900;
}

.article-back:hover {
  color: #fff;
  background: rgba(124,58,237,.24);
}

.article-footer-meta {
  color: rgba(226,232,240,.72);
  font-size: .92rem;
}

.article-footer-meta strong {
  color: #fff;
}

/* Responsive */
@media (max-width: 991.98px) {
  .article-title {
    max-width: 100%;
  }

  .article-media {
    margin-top: 1rem;
  }
}

@media (max-width: 768px) {
  .article-hero .container {
    padding-top: 1.2rem !important;
    padding-bottom: 2rem !important;
  }

  .article-title {
    letter-spacing: -.055em;
  }

  .article-img {
    height: 250px;
  }

  .article-body {
    padding: 46px 0 76px;
  }

  .article-content {
    padding: 26px 20px;
    border-radius: 26px;
  }

  .article-content h2 {
    margin-top: 3.2rem;
    letter-spacing: -.045em;
  }

  .article-content h3 {
    margin-top: 2.2rem;
  }

  .article-content p,
  .article-content li {
    font-size: 1rem;
    line-height: 1.75;
  }

  .article-content li {
    padding-left: 1.75rem;
  }

  .article-content th,
  .article-content td {
    padding: .85rem;
    font-size: .92rem;
  }

  .article-content pre {
    border-radius: 18px;
    padding: 1rem;
  }

  .article-footer {
    flex-direction: column;
    align-items: stretch;
  }

  .article-back {
    width: 100%;
  }
