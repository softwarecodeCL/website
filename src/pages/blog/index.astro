---
export const prerender = true;
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

const title = 'Blog de Desarrollo Web, SEO Técnico e IA — SoftwareCode.cl'
const description =
  'Guías, análisis y estrategias sobre desarrollo web, software a medida, SEO técnico, performance, automatización e inteligencia artificial aplicada a negocios.'

const siteUrl = 'https://www.softwarecode.cl'
const pageUrl = `${siteUrl}/blog`
const logoUrl = `${siteUrl}/logosc-original.png`

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const featuredPost = posts[0]
const remainingPosts = posts.slice(1)
const topPosts = posts.slice(0, 24)

const categories = [...new Set(posts.map(post => post.data.category).filter(Boolean))].slice(0, 6)

const formatDate = (date) => {
  return date.toLocaleDateString('es-CL', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      "name": "SoftwareCode.cl",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "@id": `${siteUrl}#logo`,
        "url": logoUrl
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      "url": siteUrl,
      "name": "SoftwareCode.cl",
      "publisher": { "@id": `${siteUrl}#organization` },
      "inLanguage": "es-CL"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumbs`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": pageUrl }
      ]
    },
    {
      "@type": ["CollectionPage", "Blog"],
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}#website` },
      "publisher": { "@id": `${siteUrl}#organization` },
      "inLanguage": "es-CL",
      "mainEntity": {
        "@type": "ItemList",
        "itemListOrder": "https://schema.org/ItemListOrderDescending",
        "numberOfItems": topPosts.length,
        "itemListElement": topPosts.map((p, idx) => ({
          "@type": "ListItem",
          "position": idx + 1,
          "url": `${siteUrl}/blog/${p.slug}/`
        }))
      }
    },
    ...topPosts.map((p) => ({
      "@type": "BlogPosting",
      "@id": `${siteUrl}/blog/${p.slug}/#blogposting`,
      "mainEntityOfPage": { "@type": "WebPage", "@id": `${siteUrl}/blog/${p.slug}/` },
      "headline": p.data.title,
      "description": p.data.description,
      "datePublished": (p.data.date instanceof Date) ? p.data.date.toISOString() : p.data.date,
      "inLanguage": "es-CL",
      "author": { "@type": "Organization", "@id": `${siteUrl}#organization` },
      "publisher": { "@id": `${siteUrl}#organization` },
      ...(p.data.image ? {
        "image": [p.data.image.startsWith("http") ? p.data.image : `${siteUrl}${p.data.image}`]
      } : {}),
      "articleSection": p.data.category || "Blog"
    }))
  ]
}
---

<Layout title={title} description={description} image="/img/blog/portada.jpg">
  <section class="blog-index">
    <div class="blog-orb blog-orb-one" aria-hidden="true"></div>
    <div class="blog-orb blog-orb-two" aria-hidden="true"></div>

    <div class="blog-shell">
      <header class="blog-hero blog-hero-compact">
        <div class="blog-hero-copy">
          <nav class="blog-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Inicio</a>
            <span>/</span>
            <span>Blog</span>
          </nav>

          <div class="blog-kicker">
            <span class="blog-kicker-dot"></span>
            <span>Laboratorio editorial</span>
          </div>

          <h1>
            Blog técnico para crear webs que cargan, posicionan y venden.
          </h1>

          <p>
            Guías prácticas sobre desarrollo web, SEO técnico, performance e IA aplicada.
            Contenido directo, accionable y pensado para tomar mejores decisiones digitales.
          </p>

          <div class="blog-actions">
            <a class="blog-main-btn" href="#posts">
              Explorar artículos
              <span>→</span>
            </a>

            <a class="blog-ghost-btn" href="/desarrollo-web-a-medida/">
              Ver servicios
            </a>
          </div>

          {categories.length > 0 && (
            <div class="blog-topics" aria-label="Categorías del blog">
              {categories.map(category => (
                <span>{category}</span>
              ))}
            </div>
          )}
        </div>

        <aside class="blog-lab-panel" aria-label="Panel editorial del blog">
          <div class="lab-panel-head">
            <span>Content Lab</span>
            <strong>{posts.length}</strong>
          </div>

          <div class="lab-stack">
            {featuredPost && (
              <a class="lab-layer lab-layer-featured" href={`/blog/${featuredPost.slug}/`}>
                <span>Última publicación</span>
                <strong>{featuredPost.data.title}</strong>
                <em>Leer ahora →</em>
              </a>
            )}

            <div class="lab-layer lab-layer-small">
              <span>SEO técnico</span>
              <strong>Indexación, CWV y arquitectura</strong>
            </div>

            <div class="lab-layer lab-layer-small">
              <span>Desarrollo moderno</span>
              <strong>Astro, SSR, performance y UX</strong>
            </div>
          </div>

          <div class="lab-metrics">
            <div>
              <strong>{categories.length || 1}</strong>
              <span>categorías</span>
            </div>
            <div>
              <strong>SEO</strong>
              <span>foco editorial</span>
            </div>
          </div>
        </aside>
      </header>

      {featuredPost && (
        <section class="featured-wrap" aria-labelledby="featured-title">
          <div class="section-heading">
            <span>Artículo destacado</span>
            <h2 id="featured-title">Lectura recomendada</h2>
          </div>

          <article class="featured-card">
            <a href={`/blog/${featuredPost.slug}/`} class="featured-link" aria-label={`Leer: ${featuredPost.data.title}`}>
              <div class="featured-media">
                {featuredPost.data.image ? (
                  <img src={featuredPost.data.image} alt={featuredPost.data.title} loading="eager" />
                ) : (
                  <div class="featured-placeholder"></div>
                )}

                <div class="featured-badge">
                  {featuredPost.data.category || 'Blog'}
                </div>
              </div>

              <div class="featured-content">
                <time>{formatDate(featuredPost.data.date)}</time>
                <h2>{featuredPost.data.title}</h2>
                <p>{featuredPost.data.description}</p>

                <div class="featured-footer">
                  <span>Leer análisis completo</span>
                  <strong>→</strong>
                </div>
              </div>
            </a>
          </article>
        </section>
      )}

      <section class="posts-section" id="posts" aria-labelledby="posts-title">
        <div class="section-heading section-heading-row">
          <div>
            <span>Últimos contenidos</span>
            <h2 id="posts-title">Biblioteca estratégica</h2>
          </div>
          <p>
            Artículos pensados para posicionar, educar y ayudar a tomar mejores decisiones técnicas.
          </p>
        </div>

        <div class="posts-grid">
          {(featuredPost ? remainingPosts : posts).map(post => (
            <article class="post-card">
              <a href={`/blog/${post.slug}/`} class="post-card__link" aria-label={`Leer: ${post.data.title}`}>
                <div class="post-card__media">
                  {post.data.image ? (
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="post-card__img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="post-card__img post-card__img--placeholder"></div>
                  )}

                  <div class="post-card__overlay"></div>

                  <div class="post-card__meta">
                    <span class="post-card__pill">{post.data.category || 'Blog'}</span>
                    <span class="post-card__date">
                      {formatDate(post.data.date)}
                    </span>
                  </div>
                </div>

                <div class="post-card__body">
                  <h2 class="post-card__title">{post.data.title}</h2>
                  <p class="post-card__desc">{post.data.description}</p>

                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="post-card__tags">
                      {post.data.tags.slice(0, 3).map(tag => (
                        <span>#{tag}</span>
                      ))}
                    </div>
                  )}

                  <div class="post-card__footer">
                    <span class="post-card__cta">
                      Leer artículo <span class="post-card__arrow">→</span>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</Layout>

<style>
.blog-index {
  --blog-bg: #050816;
  --blog-surface: rgba(255, 255, 255, 0.075);
  --blog-surface-strong: rgba(255, 255, 255, 0.12);
  --blog-border: rgba(255, 255, 255, 0.14);
  --blog-border-strong: rgba(216, 180, 254, 0.28);
  --blog-text: #ffffff;
  --blog-muted: rgba(226, 232, 240, 0.76);
  --blog-soft: rgba(203, 213, 225, 0.62);
  --blog-purple: #8b5cf6;
  --blog-pink: #ec4899;
  --blog-blue: #38bdf8;
  --blog-green: #22c55e;

  position: relative;
  min-height: 100vh;
  padding: 118px 18px 110px;
  color: var(--blog-text);
  background:
    radial-gradient(circle at 16% 0%, rgba(139, 92, 246, 0.30), transparent 34rem),
    radial-gradient(circle at 86% 12%, rgba(236, 72, 153, 0.18), transparent 34rem),
    radial-gradient(circle at 50% 100%, rgba(56, 189, 248, 0.10), transparent 38rem),
    linear-gradient(180deg, #050816 0%, #070a12 48%, #050816 100%);
  overflow: hidden;
}

.blog-index::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .18;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
  background-size: 58px 58px;
  mask-image: linear-gradient(to bottom, black, transparent 78%);
}

.blog-index::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 94px;
  width: min(920px, 82vw);
  height: 1px;
  transform: translateX(-50%);
  background: linear-gradient(90deg, transparent, rgba(236,72,153,.72), rgba(139,92,246,.92), rgba(56,189,248,.70), transparent);
  box-shadow: 0 0 28px rgba(139,92,246,.38);
}

.blog-orb {
  position: absolute;
  border-radius: 999px;
  filter: blur(20px);
  opacity: .55;
  pointer-events: none;
}

.blog-orb-one {
  width: 340px;
  height: 340px;
  left: -120px;
  top: 160px;
  background: radial-gradient(circle, rgba(236,72,153,.28), transparent 68%);
}

.blog-orb-two {
  width: 420px;
  height: 420px;
  right: -180px;
  top: 380px;
  background: radial-gradient(circle, rgba(56,189,248,.18), transparent 70%);
}

.blog-shell {
  position: relative;
  z-index: 1;
  width: min(1180px, 100%);
  margin: 0 auto;
}

/* HERO */
.blog-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(340px, .72fr);
  gap: clamp(28px, 5vw, 72px);
  align-items: center;
  min-height: 560px;
  padding: clamp(28px, 5vw, 72px);
  border: 1px solid var(--blog-border);
  border-radius: 38px;
  background:
    linear-gradient(135deg, rgba(255,255,255,.10), rgba(255,255,255,.045)),
    rgba(15, 23, 42, .58);
  box-shadow:
    0 36px 120px rgba(0,0,0,.36),
    inset 0 1px 0 rgba(255,255,255,.08);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  overflow: hidden;
}

.blog-hero::before {
  content: "";
  position: absolute;
  inset: auto -15% -38% 28%;
  height: 360px;
  background:
    radial-gradient(circle at 30% 40%, rgba(236,72,153,.22), transparent 34%),
    radial-gradient(circle at 58% 48%, rgba(139,92,246,.26), transparent 38%),
    radial-gradient(circle at 72% 26%, rgba(56,189,248,.16), transparent 34%);
  filter: blur(18px);
  pointer-events: none;
}

.blog-hero-copy,
.blog-studio-card {
  position: relative;
  z-index: 1;
}

.blog-breadcrumb {
  display: flex;
  align-items: center;
  gap: .55rem;
  margin-bottom: 22px;
  color: var(--blog-soft);
  font-size: .92rem;
  font-weight: 800;
}

.blog-breadcrumb a {
  color: rgba(226,232,240,.76);
  text-decoration: none;
}

.blog-breadcrumb a:hover {
  color: #fff;
}

.blog-kicker {
  width: fit-content;
  display: inline-flex;
  align-items: center;
  gap: .65rem;
  margin-bottom: 24px;
  padding: 9px 14px;
  border: 1px solid var(--blog-border-strong);
  border-radius: 999px;
  color: rgba(237, 233, 254, .95);
  background:
    linear-gradient(135deg, rgba(139,92,246,.22), rgba(236,72,153,.13)),
    rgba(255,255,255,.055);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
  font-size: .86rem;
  font-weight: 900;
  letter-spacing: .035em;
  text-transform: uppercase;
}

.blog-kicker-dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--blog-pink), var(--blog-purple), var(--blog-blue));
  box-shadow: 0 0 22px rgba(139,92,246,.78);
}

.blog-hero h1 {
  max-width: 760px;
  margin: 0;
  color: #fff;
  font-size: clamp(2.65rem, 6.2vw, 6.4rem);
  line-height: .92;
  letter-spacing: -.082em;
  font-weight: 950;
  text-wrap: balance;
}

.blog-hero p {
  max-width: 690px;
  margin: 26px 0 0;
  color: var(--blog-muted);
  font-size: clamp(1.05rem, 1.6vw, 1.26rem);
  line-height: 1.75;
  text-wrap: pretty;
}

.blog-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 34px;
}

.blog-main-btn,
.blog-ghost-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  min-height: 48px;
  padding: .9rem 1.22rem;
  border-radius: 999px;
  font-weight: 950;
  text-decoration: none;
  transition: transform .18s ease, filter .18s ease, border-color .18s ease, background .18s ease;
}

.blog-main-btn {
  color: #fff;
  background: linear-gradient(135deg, #7c3aed, #db2777, #2563eb);
  box-shadow:
    0 18px 46px rgba(124,58,237,.34),
    inset 0 1px 0 rgba(255,255,255,.18);
}

.blog-ghost-btn {
  color: rgba(255,255,255,.88);
  border: 1px solid rgba(255,255,255,.18);
  background: rgba(255,255,255,.06);
}

.blog-main-btn:hover,
.blog-ghost-btn:hover {
  transform: translateY(-2px);
  filter: brightness(1.06);
  color: #fff;
}

.blog-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 30px;
}

.blog-topics span {
  padding: .45rem .72rem;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 999px;
  color: rgba(226,232,240,.82);
  background: rgba(255,255,255,.055);
  font-size: .86rem;
  font-weight: 850;
}

/* PANEL DERECHO SIN RADAR */
.blog-studio-card {
  padding: 22px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 30px;
  background:
    radial-gradient(circle at 20% 0%, rgba(236,72,153,.18), transparent 32rem),
    radial-gradient(circle at 80% 18%, rgba(56,189,248,.15), transparent 28rem),
    rgba(2, 6, 23, .58);
  box-shadow:
    0 30px 80px rgba(0,0,0,.34),
    inset 0 1px 0 rgba(255,255,255,.08);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.studio-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.studio-eyebrow {
  color: rgba(226,232,240,.72);
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.studio-status {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .38rem .62rem;
  border-radius: 999px;
  color: #bbf7d0;
  background: rgba(34,197,94,.12);
  border: 1px solid rgba(34,197,94,.24);
  font-size: .76rem;
  font-weight: 950;
}

.studio-status::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: var(--blog-green);
  box-shadow: 0 0 16px rgba(34,197,94,.72);
}

.studio-window {
  margin-top: 18px;
  padding: 18px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 22px;
  background:
    linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.035)),
    rgba(15,23,42,.78);
}

.studio-bar {
  display: flex;
  gap: 7px;
  margin-bottom: 18px;
}

.studio-bar span {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: rgba(255,255,255,.22);
}

.studio-bar span:nth-child(1) { background: #fb7185; }
.studio-bar span:nth-child(2) { background: #facc15; }
.studio-bar span:nth-child(3) { background: #22c55e; }

.studio-line {
  position: relative;
  padding: 15px 0 15px 22px;
  border-bottom: 1px solid rgba(255,255,255,.09);
}

.studio-line:last-child {
  border-bottom: 0;
}

.studio-line::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22px;
  width: 9px;
  height: 9px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--blog-pink), var(--blog-purple), var(--blog-blue));
  box-shadow: 0 0 16px rgba(139,92,246,.62);
}

.studio-label {
  display: block;
  margin-bottom: 5px;
  color: rgba(203,213,225,.68);
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.studio-line strong {
  display: block;
  color: #fff;
  font-size: 1.02rem;
  line-height: 1.25;
}

.studio-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 14px;
}

.studio-grid div {
  padding: 16px;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 18px;
  background: rgba(255,255,255,.055);
}

.studio-grid strong {
  display: block;
  color: #fff;
  font-size: 1.9rem;
  line-height: 1;
  letter-spacing: -.04em;
}

.studio-grid span {
  display: block;
  margin-top: 6px;
  color: rgba(226,232,240,.68);
  font-size: .84rem;
  font-weight: 800;
}

.studio-note {
  margin-top: 14px;
  padding: 17px;
  border-radius: 20px;
  background:
    linear-gradient(135deg, rgba(124,58,237,.18), rgba(236,72,153,.10));
  border: 1px solid rgba(216,180,254,.18);
}

.studio-note span {
  display: block;
  margin-bottom: 6px;
  color: rgba(226,232,240,.62);
  font-size: .78rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.studio-note strong {
  display: block;
  color: #fff;
  line-height: 1.35;
}

/* SECTIONS */
.featured-wrap,
.posts-section {
  margin-top: 82px;
}

.section-heading {
  margin-bottom: 26px;
}

.section-heading span {
  display: inline-flex;
  margin-bottom: 10px;
  color: #c4b5fd;
  font-size: .82rem;
  font-weight: 950;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.section-heading h2 {
  margin: 0;
  color: #fff;
  font-size: clamp(2rem, 4vw, 3.35rem);
  line-height: 1;
  letter-spacing: -.06em;
  font-weight: 950;
}

.section-heading-row {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
}

.section-heading-row p {
  max-width: 460px;
  margin: 0;
  color: var(--blog-soft);
  line-height: 1.65;
}

/* FEATURED */
.featured-card {
  border-radius: 34px;
  border: 1px solid var(--blog-border);
  background:
    linear-gradient(135deg, rgba(255,255,255,.10), rgba(255,255,255,.045));
  box-shadow: 0 30px 100px rgba(0,0,0,.32);
  overflow: hidden;
}

.featured-link {
  display: grid;
  grid-template-columns: .92fr 1.08fr;
  min-height: 390px;
  color: inherit;
  text-decoration: none;
}

.featured-media {
  position: relative;
  min-height: 320px;
  overflow: hidden;
  background: rgba(255,255,255,.05);
}

.featured-media img,
.featured-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .45s ease;
}

.featured-placeholder {
  background:
    radial-gradient(circle at 20% 20%, rgba(236,72,153,.24), transparent 40%),
    radial-gradient(circle at 80% 20%, rgba(56,189,248,.18), transparent 36%),
    linear-gradient(135deg, rgba(124,58,237,.35), rgba(15,23,42,.95));
}

.featured-card:hover .featured-media img {
  transform: scale(1.045);
}

.featured-badge {
  position: absolute;
  left: 18px;
  bottom: 18px;
  padding: .55rem .78rem;
  border-radius: 999px;
  color: #111827;
  background: rgba(255,255,255,.92);
  font-size: .78rem;
  font-weight: 950;
  text-transform: uppercase;
  letter-spacing: .04em;
}

.featured-content {
