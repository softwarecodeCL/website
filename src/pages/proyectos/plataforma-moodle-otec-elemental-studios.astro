---
import Layout from '../../layouts/Layout.astro';
export const prerender = true;

const pageUrl = 'https://www.softwarecode.cl/proyectos/plataforma-moodle-otec-elemental-studios/';
const title = 'Plataforma Moodle para OTEC | Elemental Studios';
const description = 'Caso de éxito: implementación de una plataforma Moodle para Elemental Studios, orientada a capacitación corporativa en idiomas y apoyo a su proceso de certificación como OTEC en Chile.';
// Usa una imagen existente para evitar un OG roto. Cámbiala luego por una portada propia del caso.
const image = '/logosc-original.png';

const challenges = [
  {
    icon: 'bi-diagram-3',
    title: 'Centralizar la operación académica',
    text: 'Reunir cursos, participantes, recursos y actividades en un entorno único, administrable y preparado para crecer.',
  },
  {
    icon: 'bi-briefcase',
    title: 'Capacitación aplicada al trabajo',
    text: 'Organizar programas de idiomas con focos concretos: hotelería, turismo, atención al cliente y comunicación empresarial.',
  },
  {
    icon: 'bi-shield-check',
    title: 'Respaldar el modelo OTEC',
    text: 'Contar con una base tecnológica que apoyara la trazabilidad, la gestión académica y la ejecución de formación e-learning.',
  },
];

const solutionItems = [
  {
    number: '01',
    icon: 'bi-window-stack',
    title: 'Plataforma Moodle bajo dominio propio',
    text: 'Implementación de un campus virtual accesible desde moodle.elementalstudios.cl, integrado a la presencia digital de la organización.',
  },
  {
    number: '02',
    icon: 'bi-people',
    title: 'Gestión de usuarios y roles',
    text: 'Estructura para administrar participantes, relatores y responsables de la plataforma con accesos diferenciados.',
  },
  {
    number: '03',
    icon: 'bi-journal-richtext',
    title: 'Organización de cursos y contenidos',
    text: 'Configuración del LMS para estructurar módulos, materiales, actividades y rutas de aprendizaje por programa.',
  },
  {
    number: '04',
    icon: 'bi-graph-up',
    title: 'Seguimiento del aprendizaje',
    text: 'Base para revisar participación, progreso y cumplimiento de actividades dentro de cada curso.',
  },
  {
    number: '05',
    icon: 'bi-phone',
    title: 'Experiencia responsive',
    text: 'Acceso desde computadores, tablets y teléfonos para facilitar el aprendizaje en distintos contextos laborales.',
  },
  {
    number: '06',
    icon: 'bi-sliders',
    title: 'Autonomía operativa',
    text: 'Una plataforma administrable por el equipo de Elemental Studios, preparada para incorporar nuevos cursos y participantes.',
  },
];

const sectors = [
  {
    icon: 'bi-building',
    title: 'Hotelería',
    text: 'Comunicación con huéspedes, recepción, reservas, orientación y resolución de situaciones de servicio.',
  },
  {
    icon: 'bi-airplane',
    title: 'Turismo',
    text: 'Idiomas aplicados a experiencias turísticas, atención de visitantes y coordinación con clientes internacionales.',
  },
  {
    icon: 'bi-headset',
    title: 'Atención al cliente',
    text: 'Vocabulario, escucha y respuestas aplicadas a contextos reales de atención y experiencia de clientes.',
  },
  {
    icon: 'bi-briefcase',
    title: 'Empresas',
    text: 'Inglés y portugués para reuniones, presentaciones, coordinación y comunicación profesional.',
  },
];

const results = [
  'Campus virtual propio y alineado con la marca Elemental Studios.',
  'Cursos, usuarios y recursos centralizados en una sola plataforma.',
  'Base e-learning preparada para capacitación corporativa por industria.',
  'Mayor autonomía para publicar y administrar nuevos programas.',
  'Infraestructura digital que apoyó el proceso de certificación y operación como OTEC.',
  'Una solución escalable para ampliar la oferta de capacitación en idiomas.',
];

const faqs = [
  {
    question: '¿Qué se desarrolló para Elemental Studios?',
    answer: 'Se implementó y configuró una plataforma Moodle bajo dominio propio para centralizar cursos, usuarios, contenidos, actividades y seguimiento del aprendizaje.',
  },
  {
    question: '¿La plataforma Moodle permitió la certificación como OTEC?',
    answer: 'La certificación como OTEC depende del cumplimiento de requisitos normativos y de los organismos competentes. Según el alcance informado por el cliente, la plataforma Moodle fue un habilitador tecnológico clave para respaldar su modelo e-learning y avanzar en su proceso de certificación y operación como OTEC en Chile.',
  },
  {
    question: '¿Para qué tipos de capacitación fue diseñada?',
    answer: 'La plataforma está orientada a programas corporativos de inglés y portugués aplicados a contextos laborales, especialmente hotelería, turismo, atención al cliente y comunicación empresarial.',
  },
  {
    question: '¿Se puede implementar una solución similar para otra OTEC?',
    answer: 'Sí. La arquitectura y configuración pueden adaptarse a la identidad, metodología, tipos de cursos, perfiles de usuario y necesidades operativas de cada organismo de capacitación o empresa.',
  },
];

const schemaExtras = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: 'Implementación de plataformas Moodle para OTEC',
    serviceType: 'Implementación y configuración de plataforma LMS Moodle',
    provider: { '@id': 'https://www.softwarecode.cl/#organization' },
    areaServed: { '@type': 'Country', name: 'Chile' },
    url: pageUrl,
    description: 'Implementación de plataformas Moodle para organismos de capacitación, empresas y proyectos de formación e-learning.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime="2026-06-23"
  modifiedTime="2026-06-23"
  schemaExtras={schemaExtras}
>
  <article class="case-study">
    <header class="case-hero">
      <div class="case-grid" aria-hidden="true"></div>
      <div class="case-orb case-orb-one" aria-hidden="true"></div>
      <div class="case-orb case-orb-two" aria-hidden="true"></div>

      <div class="container case-hero-inner">
        <div class="row align-items-center g-5">
          <div class="col-lg-6">
            <a class="case-back" href="/proyectos/">
              <i class="bi bi-arrow-left"></i>
              Proyectos
            </a>

            <div class="case-eyebrow">
              <span class="case-eyebrow-dot"></span>
              Caso de éxito · EdTech · OTEC
            </div>

            <h1>
              Plataforma Moodle para
              <span>capacitación corporativa en idiomas</span>
            </h1>

            <p class="case-lead">
              Implementamos el campus virtual de Elemental Studios para organizar y escalar
              sus programas de inglés y portugués aplicados al trabajo. La solución se convirtió
              en una base tecnológica clave para respaldar su modelo e-learning y apoyar su
              proceso de certificación y operación como OTEC en Chile.
            </p>

            <div class="case-actions">
              <a
                class="case-primary-btn"
                href="https://moodle.elementalstudios.cl/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Ver plataforma
                <i class="bi bi-arrow-up-right"></i>
              </a>

              <a
                class="case-secondary-btn"
                href="https://wa.me/56988396128?text=Hola%2C%20quiero%20implementar%20una%20plataforma%20Moodle%20para%20mi%20OTEC%20o%20empresa"
                target="_blank"
                rel="noopener noreferrer"
              >
                Evaluar un proyecto similar
              </a>
            </div>

            <div class="case-tags" aria-label="Características del proyecto">
              <span>Moodle LMS</span>
              <span>Capacitación e-learning</span>
              <span>OTEC</span>
              <span>Idiomas para empresas</span>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="platform-visual">
              <div class="platform-topbar">
                <div class="platform-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="platform-url">
                  <i class="bi bi-lock-fill"></i>
                  moodle.elementalstudios.cl
                </div>
                <i class="bi bi-arrow-clockwise platform-refresh"></i>
              </div>

              <div class="platform-body">
                <aside class="platform-sidebar">
                  <div class="platform-brand">
                    <span class="platform-brand-mark">E</span>
                    <span>Elemental</span>
                  </div>

                  <div class="platform-nav-item active">
                    <i class="bi bi-grid-1x2"></i><span>Inicio</span>
                  </div>
                  <div class="platform-nav-item">
                    <i class="bi bi-journal-bookmark"></i><span>Mis cursos</span>
                  </div>
                  <div class="platform-nav-item">
                    <i class="bi bi-bar-chart"></i><span>Progreso</span>
                  </div>
                  <div class="platform-nav-item">
                    <i class="bi bi-person"></i><span>Perfil</span>
                  </div>
                </aside>

                <div class="platform-main">
                  <div class="platform-welcome">
                    <div>
                      <span>Campus virtual</span>
                      <strong>Bienvenido a Elemental Studios</strong>
                    </div>
                    <span class="platform-avatar">ES</span>
                  </div>

                  <div class="platform-progress-card">
                    <div>
                      <small>Progreso general</small>
                      <strong>Capacitación aplicada al trabajo</strong>
                    </div>
                    <span>76%</span>
                    <div class="platform-progress-bar"><i></i></div>
                  </div>

                  <div class="platform-course-grid">
                    <div class="platform-course purple">
                      <span class="platform-course-icon"><i class="bi bi-building"></i></span>
                      <small>Programa corporativo</small>
                      <strong>English for Hospitality</strong>
                      <div><span>8 módulos</span><i class="bi bi-arrow-right"></i></div>
                    </div>

                    <div class="platform-course pink">
                      <span class="platform-course-icon"><i class="bi bi-headset"></i></span>
                      <small>Atención al cliente</small>
                      <strong>Customer Service English</strong>
                      <div><span>6 módulos</span><i class="bi bi-arrow-right"></i></div>
                    </div>
                  </div>

                  <div class="platform-bottom-row">
                    <div class="platform-mini-card">
                      <i class="bi bi-check2-circle"></i>
                      <span><small>Actividades</small><strong>Seguimiento centralizado</strong></span>
                    </div>
                    <div class="platform-mini-card">
                      <i class="bi bi-people"></i>
                      <span><small>Participantes</small><strong>Gestión por curso</strong></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="visual-note">
              <span><i class="bi bi-shield-check"></i></span>
              <p>
                <strong>Infraestructura para crecer:</strong>
                un entorno propio para cursos, participantes y nuevas líneas de capacitación.
              </p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class="case-summary">
      <div class="container">
        <div class="summary-grid">
          <div class="summary-item">
            <span>Cliente</span>
            <strong>Elemental Studios</strong>
          </div>
          <div class="summary-item">
            <span>Industria</span>
            <strong>Capacitación corporativa</strong>
          </div>
          <div class="summary-item">
            <span>Solución</span>
            <strong>Plataforma Moodle</strong>
          </div>
          <div class="summary-item">
            <span>Alcance</span>
            <strong>Chile · E-learning</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="case-section case-intro">
      <div class="container">
        <div class="row g-5 align-items-start">
          <div class="col-lg-5">
            <span class="section-kicker">El proyecto</span>
            <h2>De una oferta de capacitación a una operación digital preparada para escalar</h2>
          </div>

          <div class="col-lg-7">
            <p class="section-large-copy">
              Elemental Studios desarrolla programas de idiomas para empresas, con contenidos
              aplicados a situaciones reales de trabajo. Su propuesta requería algo más que una
              página informativa: necesitaba un entorno capaz de sostener la experiencia académica,
              administrar participantes y organizar cursos con distintos focos profesionales.
            </p>

            <p class="section-copy">
              SoftwareCode implementó una plataforma Moodle bajo dominio propio para transformar
              esa necesidad en una operación e-learning centralizada. El campus virtual permitió
              estructurar la oferta formativa, disponer de accesos diferenciados y entregar una
              experiencia coherente para estudiantes, relatores y administradores.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="case-section challenge-section">
      <div class="container">
        <div class="section-heading centered">
          <span class="section-kicker">El desafío</span>
          <h2>Una plataforma que conectara formación, operación y crecimiento</h2>
          <p>
            El objetivo no era instalar Moodle como una herramienta aislada, sino convertirlo
            en una pieza central del modelo de capacitación de Elemental Studios.
          </p>
        </div>

        <div class="row g-4">
          {challenges.map((challenge) => (
            <div class="col-md-6 col-lg-4">
              <article class="challenge-card">
                <span class="challenge-icon"><i class={`bi ${challenge.icon}`}></i></span>
                <h3>{challenge.title}</h3>
                <p>{challenge.text}</p>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="otec-section">
      <div class="container">
        <div class="otec-panel">
          <div class="otec-glow" aria-hidden="true"></div>
          <div class="row g-5 align-items-center position-relative">
            <div class="col-lg-5">
              <div class="otec-badge">
                <i class="bi bi-patch-check-fill"></i>
                Habilitador tecnológico
              </div>
              <h2>Una base digital que apoyó su certificación como OTEC</h2>
            </div>

            <div class="col-lg-7">
              <p>
                Según el alcance informado por el cliente, la implementación de Moodle fue un
                componente clave para que Elemental Studios pudiera formalizar y respaldar su
                modelo de capacitación e-learning, avanzar en su proceso y certificarse como
                Organismo Técnico de Capacitación en Chile.
              </p>

              <p>
                La plataforma no reemplaza los requisitos legales, normativos ni de calidad del
                proceso de certificación. Su aporte fue entregar la infraestructura necesaria para
                organizar la formación, administrar usuarios, mantener trazabilidad académica y
                operar cursos online desde un entorno institucional propio.
              </p>

              <div class="otec-points">
                <span><i class="bi bi-check2"></i> Operación académica centralizada</span>
                <span><i class="bi bi-check2"></i> Soporte para formación e-learning</span>
                <span><i class="bi bi-check2"></i> Gestión de cursos y participantes</span>
                <span><i class="bi bi-check2"></i> Base preparada para auditoría y crecimiento</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="case-section solution-section">
      <div class="container">
        <div class="section-heading split-heading">
          <div>
            <span class="section-kicker">La solución</span>
            <h2>Una implementación pensada para la operación real</h2>
          </div>
          <p>
            Diseñamos una estructura clara para que la tecnología acompañara el modelo académico,
            sin convertir la administración diaria en una tarea compleja.
          </p>
        </div>

        <div class="solution-list">
          {solutionItems.map((item) => (
            <article class="solution-row">
              <span class="solution-number">{item.number}</span>
              <span class="solution-icon"><i class={`bi ${item.icon}`}></i></span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
              <i class="bi bi-arrow-down-right solution-arrow"></i>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="case-section sectors-section">
      <div class="container">
        <div class="row g-5 align-items-end mb-5">
          <div class="col-lg-7">
            <span class="section-kicker">Capacitación especializada</span>
            <h2>Idiomas aplicados a situaciones laborales concretas</h2>
          </div>
          <div class="col-lg-5">
            <p class="section-copy mb-0">
              La plataforma permite organizar programas según industria, perfil del participante
              y contexto comunicacional, manteniendo una experiencia consistente.
            </p>
          </div>
        </div>

        <div class="row g-4">
          {sectors.map((sector) => (
            <div class="col-md-6 col-lg-3">
              <article class="sector-card">
                <i class={`bi ${sector.icon}`}></i>
                <h3>{sector.title}</h3>
                <p>{sector.text}</p>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="case-section process-section">
      <div class="container">
        <div class="section-heading centered light-heading">
          <span class="section-kicker">Cómo lo abordamos</span>
          <h2>Del requerimiento a una plataforma lista para operar</h2>
        </div>

        <div class="process-line">
          <article>
            <span>01</span>
            <h3>Levantamiento</h3>
            <p>Definición de usuarios, cursos, experiencia académica y necesidades operativas.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Configuración</h3>
            <p>Preparación de Moodle, accesos, estructura general y dominio institucional.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Personalización</h3>
            <p>Ajuste visual y organización del campus para alinearlo con Elemental Studios.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Puesta en marcha</h3>
            <p>Validación del flujo, publicación y preparación para administrar programas reales.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="case-section results-section">
      <div class="container">
        <div class="row g-5 align-items-center">
          <div class="col-lg-5">
            <span class="section-kicker">El resultado</span>
            <h2>Una plataforma propia para convertir conocimiento en capacitación escalable</h2>
            <p class="section-copy">
              Elemental Studios pasó a contar con un entorno digital capaz de sostener su oferta
              formativa, ampliar sus programas y entregar una experiencia consistente a empresas
              y participantes.
            </p>

            <a
              class="text-link"
              href="https://elementalstudios.cl/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Conocer Elemental Studios <i class="bi bi-arrow-up-right"></i>
            </a>
          </div>

          <div class="col-lg-7">
            <div class="results-grid">
              {results.map((result, index) => (
                <div class="result-item">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <p>{result}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="case-section credibility-section">
      <div class="container">
        <div class="credibility-panel">
          <div class="credibility-copy">
            <span class="section-kicker">Más que una instalación</span>
            <h2>La tecnología debía acompañar el proyecto educativo</h2>
            <p>
              El valor de Moodle no está solamente en sus funciones. Está en cómo se configura
              para representar la metodología, los procesos y la experiencia que cada organización
              quiere entregar. En este proyecto, la plataforma se adaptó al propósito de Elemental
              Studios: desarrollar habilidades de comunicación aplicadas al mundo laboral.
            </p>
          </div>

          <div class="credibility-stat">
            <span class="stat-label">Impacto del proyecto</span>
            <strong>Una base tecnológica para operar como OTEC</strong>
            <small>Capacitación e-learning · gestión académica · crecimiento</small>
          </div>
        </div>
      </div>
    </section>

    <section class="case-section faq-section">
      <div class="container">
        <div class="row g-5">
          <div class="col-lg-4">
            <span class="section-kicker">Preguntas frecuentes</span>
            <h2>Plataformas Moodle para capacitación</h2>
            <p class="section-copy">
              Una implementación correcta debe responder tanto a la experiencia del alumno como
              a la administración y trazabilidad de la organización.
            </p>
          </div>

          <div class="col-lg-8">
            <div class="faq-list">
              {faqs.map((faq, index) => (
                <details class="faq-item" open={index === 0}>
                  <summary>
                    <span>{faq.question}</span>
                    <i class="bi bi-plus-lg"></i>
                  </summary>
                  <div><p>{faq.answer}</p></div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="case-cta-section">
      <div class="container">
        <div class="case-cta-panel">
          <div class="case-cta-pattern" aria-hidden="true"></div>
          <div class="case-cta-content">
            <span class="section-kicker">¿Necesitas una plataforma similar?</span>
            <h2>Implementamos Moodle para OTEC, empresas y proyectos de capacitación</h2>
            <p>
              Cuéntanos cómo funcionan tus cursos, qué necesitas administrar y qué experiencia
              quieres entregar. Diseñaremos una solución alineada con tu operación real.
            </p>

            <div class="case-actions justify-content-center">
              <a
                class="case-primary-btn light"
                href="https://wa.me/56988396128?text=Hola%2C%20quiero%20cotizar%20una%20plataforma%20Moodle%20para%20mi%20OTEC%20o%20empresa"
                target="_blank"
                rel="noopener noreferrer"
              >
                Solicitar diagnóstico
                <i class="bi bi-arrow-up-right"></i>
              </a>

              <a class="case-secondary-btn light" href="/desarrollo-web-a-medida/">
                Ver desarrollo a medida
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  :global(body) {
    background: #f7f8fc;
  }

  .case-study {
    --ink: #111322;
    --muted: #666a79;
    --purple: #7436f5;
    --purple-dark: #4b1bb8;
    --pink: #dd3cad;
    --line: rgba(17, 19, 34, 0.1);
    color: var(--ink);
    overflow: hidden;
  }

  .case-hero {
    position: relative;
    padding: 82px 0 72px;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(circle at 78% 18%, rgba(124, 58, 237, 0.25), transparent 28%),
      radial-gradient(circle at 18% 100%, rgba(219, 39, 119, 0.15), transparent 30%),
      #080a12;
  }

  .case-grid {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.72), transparent 90%);
  }

  .case-orb {
