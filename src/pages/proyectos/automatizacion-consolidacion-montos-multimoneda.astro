            <strong>Errores y reprocesos</strong>
          </div>
          <div class="summary-item">
            <span>Enfoque</span>
            <strong>Integración y automatización</strong>
          </div>
          <div class="summary-item">
            <span>Resultado</span>
            <strong>Control y trazabilidad</strong>
          </div>
        </div>
      </div>
    </section>

