const schemaExtras = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: 'Automatización de procesos financieros e integración de sistemas',
    serviceType: 'Desarrollo de software financiero a medida',
    provider: { '@id': 'https://www.softwarecode.cl/#organization' },
    areaServed: { '@type': 'Country', name: 'Chile' },
    url: pageUrl,
    description: 'Diseño de soluciones para automatizar procesos financieros, integrar sistemas y controlar operaciones multimoneda con trazabilidad.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
