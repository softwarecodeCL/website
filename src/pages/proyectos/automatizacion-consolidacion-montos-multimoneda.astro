  .platform-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .platform-dots span:first-child { background: #ff6b81; }
  .platform-dots span:nth-child(2) { background: #ffc15a; }
  .platform-dots span:nth-child(3) { background: #5bd69c; }

  .platform-url {
    height: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 12px;
    border-radius: 7px;
    color: rgba(255, 255, 255, 0.38);
    background: rgba(255, 255, 255, 0.045);
    font-size: 0.6rem;
  }

  .platform-refresh {
    color: rgba(255, 255, 255, 0.32);
    font-size: 0.7rem;
  }

  .platform-body {
    min-height: 440px;
    display: grid;
    grid-template-columns: 112px 1fr;
  }

  .platform-sidebar {
    padding: 17px 10px;
    border-right: 1px solid rgba(255, 255, 255, 0.065);
    background: #0b0e17;
  }

  .platform-brand {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 4px 23px;
    color: #fff;
    font-size: 0.64rem;
    font-weight: 850;
  }

  .platform-brand-mark {
    width: 25px;
    height: 25px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    color: #fff;
    background: linear-gradient(135deg, #7c3aed, #db2777);
    font-size: 0.75rem;
  }

  .platform-nav-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 8px;
    margin-bottom: 5px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.34);
    font-size: 0.56rem;
    font-weight: 650;
  }

  .platform-nav-item.active {
    color: #ddd2ff;
    background: rgba(124, 58, 237, 0.14);
  }

  .platform-main {
    padding: 21px;
    background:
      radial-gradient(circle at 92% 8%, rgba(124, 58, 237, 0.13), transparent 25%),
      #121622;
  }

  .platform-welcome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 17px;
  }

  .platform-welcome > div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .platform-welcome span,
  .platform-progress-card small,
  .platform-course small,
  .platform-mini-card small {
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.52rem;
  }

  .platform-welcome strong {
    color: #fff;
    font-size: 0.9rem;
  }

  .platform-avatar {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: #d9ccff !important;
    background: rgba(124, 58, 237, 0.13);
    font-size: 0.54rem !important;
    font-weight: 800;
  }

  .platform-progress-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    padding: 15px;
    margin-bottom: 15px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.035);
  }

  .platform-progress-card > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .platform-progress-card strong {
    color: #fff;
    font-size: 0.68rem;
  }

  .platform-progress-card > span {
    color: #c4b5fd;
    font-size: 0.73rem;
    font-weight: 850;
  }

  .platform-progress-bar {
    grid-column: 1 / -1;
    height: 5px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
  }

  .platform-progress-bar i {
    display: block;
    width: 76%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #7c3aed, #db2777);
  }

  .platform-course-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px;
  }

  .platform-course {
    min-height: 145px;
    display: flex;
    flex-direction: column;
    padding: 13px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 13px;
  }

  .platform-course.purple {
    background: linear-gradient(145deg, rgba(124, 58, 237, 0.19), rgba(124, 58, 237, 0.035));
  }

  .platform-course.pink {
    background: linear-gradient(145deg, rgba(219, 39, 119, 0.16), rgba(219, 39, 119, 0.03));
  }

  .platform-course-icon {
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    margin-bottom: 13px;
    border-radius: 9px;
    color: #e9ddff;
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.73rem;
  }

  .platform-course strong {
    margin-top: 4px;
    color: #fff;
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .platform-course > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    color: rgba(255, 255, 255, 0.46);
    font-size: 0.52rem;
  }

  .platform-bottom-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px;
    margin-top: 11px;
  }

  .platform-mini-card {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.025);
  }

  .platform-mini-card > i {
    color: #a78bfa;
    font-size: 0.82rem;
  }

  .platform-mini-card span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .platform-mini-card strong {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.55rem;
  }

  .visual-note {
    position: relative;
    z-index: 2;
    width: min(86%, 430px);
    display: flex;
    align-items: center;
    gap: 12px;
    margin: -20px 0 0 auto;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 15px;
    background: rgba(13, 16, 27, 0.96);
    box-shadow: 0 24px 55px rgba(0, 0, 0, 0.4);
  }

  .visual-note > span {
    width: 37px;
    height: 37px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 11px;
    color: #d8caff;
    background: rgba(124, 58, 237, 0.14);
  }

  .visual-note p {
    margin: 0;
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.7rem;
    line-height: 1.5;
  }

  .visual-note strong { color: rgba(255, 255, 255, 0.86); }

  .case-summary {
    position: relative;
    z-index: 4;
    margin-top: -1px;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .summary-item {
    min-height: 112px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    padding: 20px 28px;
    border-right: 1px solid var(--line);
  }

  .summary-item:first-child { border-left: 1px solid var(--line); }

  .summary-item span {
    color: #9295a2;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .summary-item strong {
    font-size: 0.96rem;
    font-weight: 850;
  }

  .case-section {
    padding: 105px 0;
  }

  .case-intro { background: #fff; }

  .section-kicker {
    display: inline-block;
    margin-bottom: 15px;
    color: var(--purple);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .case-section h2,
  .reliability-section h2,
  .case-cta-section h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.05em;
    font-weight: 950;
  }

  .section-large-copy {
    margin: 0 0 24px;
    color: #2a2d39;
    font-size: clamp(1.15rem, 1.7vw, 1.43rem);
    line-height: 1.65;
    letter-spacing: -0.018em;
  }

  .section-copy,
  .section-heading > p,
  .split-heading > p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .section-heading {
    margin-bottom: 52px;
  }

  .section-heading.centered {
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .section-heading.centered p {
    max-width: 650px;
    margin: 20px auto 0;
  }

  .challenge-section { background: #f4f5f9; }

  .challenge-card {
    height: 100%;
    padding: 31px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 18px 60px rgba(17, 19, 34, 0.045);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .challenge-card:hover {
    transform: translateY(-5px);
    border-color: rgba(116, 54, 245, 0.2);
    box-shadow: 0 25px 70px rgba(17, 19, 34, 0.08);
  }

  .challenge-icon,
  .solution-icon {
    width: 49px;
    height: 49px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(116, 54, 245, 0.15);
    border-radius: 15px;
    color: var(--purple);
    background: rgba(116, 54, 245, 0.075);
    font-size: 1.08rem;
  }

  .challenge-card h3,
  .solution-row h3,
  .sector-card h3,
  .process-line h3 {
    margin: 22px 0 10px;
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  .challenge-card p,
  .solution-row p,
  .sector-card p,
  .process-line p {
    margin: 0;
    color: var(--muted);
    font-size: 0.91rem;
    line-height: 1.7;
  }

  .reliability-section {
    padding: 96px 0;
    background: #f4f5f9;
  }

  .reliability-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(36px, 6vw, 72px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    color: #fff;
    background:
      linear-gradient(125deg, rgba(124, 58, 237, 0.14), transparent 42%),
      #0b0e17;
    box-shadow: 0 35px 100px rgba(17, 19, 34, 0.16);
  }

  .reliability-glow {
    position: absolute;
    top: -160px;
    right: -120px;
    width: 410px;
    height: 410px;
    border-radius: 50%;
    background: rgba(124, 58, 237, 0.16);
    filter: blur(18px);
  }

  .reliability-badge { margin-bottom: 22px; }
  .reliability-badge i { color: #c4b5fd; }

  .reliability-panel p {
    margin: 0 0 18px;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.98rem;
    line-height: 1.78;
  }

  .reliability-points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px 18px;
    margin-top: 28px;
  }

  .reliability-points span {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.83rem;
    font-weight: 700;
  }

  .reliability-points i { color: #a78bfa; }

  .solution-section { background: #fff; }

  .split-heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: end;
    gap: 60px;
  }

  .split-heading > p { margin: 0; }

  .solution-list {
    border-top: 1px solid var(--line);
  }

  .solution-row {
    display: grid;
    grid-template-columns: 54px 52px 1fr 30px;
    align-items: center;
    gap: 23px;
    padding: 29px 10px;
    border-bottom: 1px solid var(--line);
    transition: padding 180ms ease, background 180ms ease;
  }

  .solution-row:hover {
    padding-left: 20px;
    padding-right: 20px;
    background: rgba(116, 54, 245, 0.025);
  }

  .solution-row h3 { margin: 0 0 5px; }

  .solution-number {
    color: #a2a4ae;
    font-size: 0.71rem;
    font-weight: 850;
    letter-spacing: 0.08em;
  }

  .solution-arrow {
    color: #a4a6b0;
    font-size: 1rem;
  }

  .sectors-section { background: #f4f5f9; }

  .sector-card {
    height: 100%;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.78);
  }

  .sector-card > i {
    font-size: 1.45rem;
    color: var(--purple);
  }

  .sector-card h3 { margin-top: 24px; }

  .process-section {
    color: #fff;
    background:
      radial-gradient(circle at 50% 0%, rgba(124, 58, 237, 0.19), transparent 34%),
      #090c14;
  }

  .light-heading h2 { color: #fff; }

  .process-line {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 21px;
  }

  .process-line::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 8%;
    right: 8%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.44), transparent);
  }

  .process-line article {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .process-line article > span {
    width: 45px;
    height: 45px;
    display: grid;
    place-items: center;
    margin: 0 auto 25px;
    border: 1px solid rgba(196, 181, 253, 0.22);
    border-radius: 50%;
    color: #c4b5fd;
    background: #111521;
    font-size: 0.67rem;
    font-weight: 900;
    box-shadow: 0 0 0 8px #090c14;
  }

  .process-line h3 {
    margin: 0 0 10px;
    color: #fff;
  }

  .process-line p {
    color: rgba(255, 255, 255, 0.52);
  }

  .results-section { background: #fff; }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    color: var(--purple);
    font-size: 0.88rem;
    font-weight: 850;
    text-decoration: none;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .result-item {
    min-height: 150px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #fff;
  }

  .result-item span {
    display: block;
    margin-bottom: 22px;
    color: var(--purple);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .result-item p {
    margin: 0;
    color: #333641;
    font-size: 0.92rem;
    line-height: 1.55;
    font-weight: 700;
  }

  .credibility-section {
    padding-top: 0;
    background: #fff;
  }

  .credibility-panel {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 26px;
  }

  .credibility-copy {
    padding: clamp(34px, 6vw, 70px);
  }

  .credibility-copy h2 {
    font-size: clamp(2rem, 3.6vw, 3.25rem);
  }

  .credibility-copy p {
    max-width: 680px;
    margin: 23px 0 0;
    color: var(--muted);
    line-height: 1.78;
  }

  .credibility-stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(34px, 6vw, 64px);
    color: #fff;
    background:
      radial-gradient(circle at 100% 0%, rgba(219, 39, 119, 0.24), transparent 35%),
      linear-gradient(145deg, #5b21b6, #7c3aed 54%, #9d174d);
  }

  .stat-label {
    margin-bottom: 25px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .credibility-stat strong {
    font-size: clamp(1.65rem, 3.2vw, 2.65rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .credibility-stat small {
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.6;
  }

  .faq-section { background: #f4f5f9; }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-size: 1rem;
    font-weight: 850;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary i {
    color: var(--purple);
    transition: transform 180ms ease;
  }

  .faq-item[open] summary i { transform: rotate(45deg); }

  .faq-item > div {
    overflow: hidden;
  }

  .faq-item p {
    max-width: 760px;
    margin: 0;
    padding: 0 45px 24px 4px;
    color: var(--muted);
    line-height: 1.75;
  }

  .case-cta-section {
    padding: 85px 0 110px;
    background: #f4f5f9;
  }

  .case-cta-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 8vw, 90px) 24px;
    border-radius: 30px;
    color: #fff;
    background:
      radial-gradient(circle at 20% 0%, rgba(236, 72, 153, 0.24), transparent 28%),
      radial-gradient(circle at 90% 90%, rgba(59, 130, 246, 0.22), transparent 29%),
      linear-gradient(135deg, #3b127b, #6d28d9 45%, #9d174d);
    box-shadow: 0 38px 100px rgba(91, 33, 182, 0.24);
  }

  .case-cta-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: radial-gradient(circle at center, #000, transparent 82%);
  }

  .case-cta-content {
    position: relative;
    z-index: 1;
    max-width: 850px;
    margin: auto;
    text-align: center;
  }

  .case-cta-content .section-kicker { color: #e9ddff; }

  .case-cta-content p {
    max-width: 680px;
    margin: 23px auto 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 1rem;
    line-height: 1.75;
  }

  .case-primary-btn.light {
    color: #5b21b6;
    border-color: #fff;
    background: #fff;
    box-shadow: 0 20px 45px rgba(20, 10, 45, 0.25);
  }

  .case-primary-btn.light:hover { color: #4c1d95; }
  .case-secondary-btn.light { color: #fff; }

  @media (max-width: 1199.98px) {
    .platform-visual { transform: none; }
    .platform-body { grid-template-columns: 96px 1fr; }
    .platform-sidebar { padding-left: 7px; padding-right: 7px; }
  }

  @media (max-width: 991.98px) {
    .case-hero { padding-top: 58px; }
    .case-hero h1 { max-width: 760px; }
    .platform-visual { margin-top: 10px; }
    .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .summary-item:nth-child(2) { border-right: 0; }
    .summary-item:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .summary-item:nth-child(3) { border-left: 1px solid var(--line); }
    .case-section { padding: 82px 0; }
    .split-heading,
    .credibility-panel { grid-template-columns: 1fr; }
    .split-heading { gap: 24px; }
    .process-line { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 45px 25px; }
    .process-line::before { display: none; }
  }

  @media (max-width: 767.98px) {
    .case-hero { padding: 42px 0 56px; }
    .case-back { margin-bottom: 22px; }
    .case-hero h1 { font-size: clamp(2.45rem, 12vw, 4rem); }
    .case-actions { align-items: stretch; }
    .case-primary-btn,
    .case-secondary-btn { width: 100%; }
    .platform-body { min-height: 380px; grid-template-columns: 1fr; }
    .platform-sidebar { display: none; }
    .platform-main { padding: 15px; }
    .platform-course-grid,
    .platform-bottom-row { grid-template-columns: 1fr; }
    .platform-course { min-height: 118px; }
    .platform-bottom-row .platform-mini-card:nth-child(2) { display: none; }
    .visual-note { width: 92%; margin-top: -14px; }
    .case-section { padding: 68px 0; }
    .summary-grid { grid-template-columns: 1fr; }
    .summary-item,
    .summary-item:first-child,
    .summary-item:nth-child(3) {
      min-height: 88px;
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .summary-item:last-child { border-bottom: 0; }
    .reliability-panel { border-radius: 22px; }
    .reliability-points,
    .results-grid,
    .process-line { grid-template-columns: 1fr; }
    .solution-row {
      grid-template-columns: 42px 1fr;
      gap: 14px 17px;
      padding: 24px 4px;
    }
    .solution-icon { grid-row: 1 / span 2; }
    .solution-number { display: none; }
