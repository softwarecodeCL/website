    <section class="case-summary" aria-label="Resumen del caso">
      <div class="container">
        <div class="summary-grid">
          <div class="summary-item">
            <span>Problema</span>
            <strong>Datos financieros dispersos</strong>
          </div>
          <div class="summary-item">
