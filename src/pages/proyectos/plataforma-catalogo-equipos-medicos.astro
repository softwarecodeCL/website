---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const SITE_URL = "https://www.softwarecode.cl/";
const pageUrl = `${SITE_URL}proyectos/plataforma-catalogo-equipos-medicos/`;
const clientUrl = "https://www.servicioshyh.cl/";
const pageTitle = "Plataforma Web y Catálogo de Equipos Médicos";
const pageDescription =
  "Caso de desarrollo web para Servicios HYH: catálogo B2B de equipos médicos, fichas técnicas, filtros, cotización múltiple y optimización SEO.";
const socialImage = "/logosc-original.png";
const publishedDate = "2026-06-23";
const whatsappUrl =
  "https://wa.me/56988396128?text=Hola%2C%20vi%20el%20proyecto%20de%20Servicios%20HYH%20y%20necesito%20una%20plataforma%20web%20o%20cat%C3%A1logo%20similar%20para%20mi%20empresa.";

const capabilities = [
  {
    icon: "bi-grid-1x2",
    title: "Catálogo especializado",
    text: "Organización de equipos oftalmológicos, laboratorio, repuestos y ofertas en una estructura navegable."
  },
  {
    icon: "bi-file-earmark-text",
    title: "Fichas de producto",
    text: "Páginas individuales preparadas para explicar características, documentos y usos de cada equipo."
  },
  {
    icon: "bi-cart-check",
    title: "Cotización múltiple",
    text: "El visitante puede seleccionar varios equipos y enviar una única solicitud comercial con sus datos."
  },
  {
    icon: "bi-search",
    title: "SEO técnico y contenido",
    text: "Arquitectura, metadatos y contenidos orientados a búsquedas técnicas y comerciales del sector."
  },
  {
    icon: "bi-phone",
    title: "Experiencia responsive",
    text: "Navegación y formularios adaptados para dispositivos móviles, escritorio y diferentes tamaños de pantalla."
  },
  {
    icon: "bi-bar-chart",
    title: "Medición y evolución",
    text: "Seguimiento mediante Analytics y Search Console para detectar consultas, páginas y oportunidades de mejora."
  }
];

const schemaExtras = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    "mainEntityOfPage": { "@id": `${pageUrl}#webpage` },
    "headline": "Desarrollo de plataforma web y catálogo de equipos médicos para Servicios HYH",
    "description": pageDescription,
    "datePublished": publishedDate,
    "dateModified": publishedDate,
    "author": { "@id": `${SITE_URL}nosotros/#marco-estay` },
    "publisher": { "@id": `${SITE_URL}#organization` },
    "about": [
      { "@type": "Thing", "name": "Desarrollo web a medida" },
      { "@type": "Thing", "name": "Catálogo B2B" },
      { "@type": "Thing", "name": "SEO técnico" },
      { "@type": "Thing", "name": "Cotización de equipos médicos" }
    ],
    "mentions": {
      "@type": "Organization",
      "name": "Servicios HYH",
      "url": clientUrl
    },
    "inLanguage": "es-CL"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Por qué se desarrolló un catálogo de cotización y no un ecommerce tradicional?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Los equipos requieren asesoría, revisión de disponibilidad y una propuesta comercial. Por eso se priorizó un catálogo con fichas técnicas y solicitud de cotización múltiple en lugar de una compra directa genérica."
        }
      },
      {
        "@type": "Question",
        "name": "¿Una plataforma de catálogo puede posicionarse en Google?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Cada categoría y ficha puede responder búsquedas específicas cuando existe una arquitectura rastreable, contenido útil, metadatos correctos, rendimiento y enlaces internos."
        }
      },
      {
        "@type": "Question",
        "name": "¿SoftwareCode desarrolla catálogos similares para otras industrias?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. La misma lógica puede adaptarse a empresas de equipamiento, repuestos, maquinaria, servicios técnicos y productos B2B que venden mediante asesoría y cotización."
        }
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={socialImage}
  url={pageUrl}
  schemaExtras={schemaExtras}
>
  <article>
    <header class="case-hero position-relative overflow-hidden">
      <div class="case-hero__glow case-hero__glow--one"></div>
      <div class="case-hero__glow case-hero__glow--two"></div>
      <div class="case-hero__grid"></div>

      <div class="container position-relative">
        <nav aria-label="Breadcrumb" class="case-breadcrumb mb-4">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item"><a href="/proyectos/">Proyectos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Servicios HYH</li>
          </ol>
        </nav>

        <div class="row align-items-center g-5">
          <div class="col-12 col-lg-7" data-aos="fade-up" data-aos-duration="650">
            <div class="d-flex flex-wrap gap-2 mb-3">
              <span class="case-badge">Caso de proyecto</span>
              <span class="case-badge">Equipamiento médico</span>
              <span class="case-badge">Chile</span>
            </div>

            <h1 class="display-4 fw-bold lh-sm mb-4">
              Desarrollo de plataforma web y catálogo de equipos médicos para
              <span class="case-gradient-text">Servicios HYH</span>
            </h1>

            <p class="lead text-secondary mb-4">
              Una solución B2B creada para presentar equipos oftalmológicos y de laboratorio,
              organizar información técnica y convertir las visitas del sitio en solicitudes de cotización.
            </p>

            <div class="d-flex flex-wrap gap-2 mb-4">
              <span class="case-chip"><i class="bi bi-code-slash"></i> Desarrollo web</span>
              <span class="case-chip"><i class="bi bi-search"></i> SEO técnico</span>
              <span class="case-chip"><i class="bi bi-grid"></i> Catálogo B2B</span>
              <span class="case-chip"><i class="bi bi-send"></i> Cotizaciones</span>
            </div>

            <div class="d-grid gap-2 d-sm-flex">
              <a href="#solucion" class="btn case-btn-primary btn-lg px-4">Ver la solución</a>
              <a
                href={clientUrl}
                class="btn case-btn-outline btn-lg px-4"
                target="_blank"
                rel="noopener noreferrer"
              >
                Visitar Servicios HYH <i class="bi bi-box-arrow-up-right ms-1"></i>
              </a>
            </div>
          </div>

          <div class="col-12 col-lg-5" data-aos="fade-left" data-aos-duration="650">
            <div class="case-visual-card">
                <img
                  src="/proyectos/hyh1.png"
                  alt="Página principal y catálogo web de Servicios HYH"
                  width="860"
                  height="740"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="case-main-image"
                />


              <div class="case-floating-card">
                <i class="bi bi-arrow-right-circle"></i>
                <div>
                  <strong>Flujo principal</strong>
                  <span>Producto → cotización → contacto comercial</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class="case-proof-strip border-top border-bottom">
      <div class="container">
        <div class="row g-0">
          <div class="col-12 col-md-3"><div class="case-proof"><i class="bi bi-grid-3x3-gap"></i><span><strong>Catálogo B2B</strong><small>Equipos y repuestos</small></span></div></div>
          <div class="col-12 col-md-3"><div class="case-proof"><i class="bi bi-cart-check"></i><span><strong>Cotización múltiple</strong><small>Venta consultiva</small></span></div></div>
          <div class="col-12 col-md-3"><div class="case-proof"><i class="bi bi-file-text"></i><span><strong>Fichas técnicas</strong><small>Información por producto</small></span></div></div>
          <div class="col-12 col-md-3"><div class="case-proof"><i class="bi bi-search"></i><span><strong>SEO progresivo</strong><small>Contenido medible</small></span></div></div>
        </div>
      </div>
    </section>

    <section class="py-5 case-section">
      <div class="container py-lg-4">
        <div class="row g-5">
          <div class="col-12 col-lg-5" data-aos="fade-up" data-aos-duration="650">
            <span class="case-kicker">Contexto</span>
            <h2 class="case-title mt-2 mb-3">Una empresa técnica con un proceso de venta basado en asesoría y cotización</h2>
          </div>
          <div class="col-12 col-lg-7" data-aos="fade-up" data-aos-duration="650" data-aos-delay="80">
            <p class="case-copy">
              Servicios HYH trabaja con venta, arriendo y soporte técnico de equipos de oftalmología y laboratorio.
              Su oferta incluye productos especializados, repuestos y servicios que requieren información detallada,
              disponibilidad y contacto comercial antes de concretar una compra.
            </p>
            <p class="case-copy mb-0">
              El proyecto debía facilitar la exploración de esa oferta, presentar cada equipo con mayor claridad
              y permitir que una clínica, laboratorio o profesional solicitara una cotización desde cualquier dispositivo.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5 case-soft border-top border-bottom">
      <div class="container py-lg-4">
        <div class="row g-5 align-items-start">
          <div class="col-12 col-lg-5" data-aos="fade-up" data-aos-duration="650">
            <span class="case-kicker">El desafío</span>
            <h2 class="case-title mt-2 mb-3">Transformar una oferta compleja en una experiencia clara y rastreable</h2>
            <p class="text-secondary mb-0">
              Una empresa con múltiples marcas, categorías y especificaciones técnicas necesita más que una página informativa.
              Requiere una estructura capaz de crecer y de convertir búsquedas específicas en oportunidades comerciales.
            </p>
          </div>

          <div class="col-12 col-lg-7">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <div class="challenge-card">
                  <span>01</span>
                  <h3 class="h5 fw-bold">Oferta especializada</h3>
                  <p>Organizar equipos, repuestos, servicios, arriendo y ofertas sin confundir al visitante.</p>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="challenge-card">
                  <span>02</span>
                  <h3 class="h5 fw-bold">Información técnica</h3>
                  <p>Permitir que cada ficha explique características, aplicaciones y documentación relevante.</p>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="challenge-card">
                  <span>03</span>
                  <h3 class="h5 fw-bold">Venta consultiva</h3>
                  <p>Adaptar el recorrido a una solicitud de cotización, no a una compra directa genérica.</p>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="challenge-card">
                  <span>04</span>
                  <h3 class="h5 fw-bold">Crecimiento orgánico</h3>
                  <p>Crear páginas capaces de responder búsquedas por servicio, categoría, marca y producto.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="solucion" class="py-5 case-section">
      <div class="container py-lg-4">
        <div class="row mb-4 g-3 align-items-end">
          <div class="col-12 col-lg-8">
            <span class="case-kicker">La solución</span>
            <h2 class="case-title mt-2 mb-2">Una plataforma web conectada con el proceso comercial de Servicios HYH</h2>
            <p class="text-secondary mb-0">
              La implementación combina presentación de productos, navegación, contenido técnico y un flujo de cotización adaptado al negocio.
            </p>
          </div>
        </div>

        <div class="row g-4">
          {capabilities.map((item, index) => (
            <div class="col-12 col-md-6 col-lg-4" data-aos="fade-up" data-aos-duration="650" data-aos-delay={index * 45}>
              <div class="capability-card">
                <span class="capability-card__icon"><i class={`bi ${item.icon}`}></i></span>
                <h3 class="h5 fw-bold">{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-5 case-process border-top border-bottom">
      <div class="container py-lg-4">
        <div class="row g-5 align-items-center">
          <div class="col-12 col-lg-5" data-aos="fade-up" data-aos-duration="650">
            <span class="case-kicker">Recorrido del usuario</span>
            <h2 class="case-title mt-2 mb-3">Un proceso diseñado para cotizar productos técnicos</h2>
            <p class="text-secondary mb-0">
              La arquitectura acompaña al visitante desde la búsqueda hasta una solicitud comercial estructurada.
            </p>
          </div>

          <div class="col-12 col-lg-7" data-aos="fade-left" data-aos-duration="650">
            <div class="process-flow">
              <div class="process-step"><span>1</span><div><strong>Descubrimiento</strong><small>Google, navegación o enlace directo</small></div></div>
              <i class="bi bi-arrow-right process-arrow"></i>
              <div class="process-step"><span>2</span><div><strong>Exploración</strong><small>Categorías, ofertas y fichas</small></div></div>
              <i class="bi bi-arrow-right process-arrow"></i>
              <div class="process-step"><span>3</span><div><strong>Selección</strong><small>Uno o varios equipos</small></div></div>
              <i class="bi bi-arrow-right process-arrow"></i>
              <div class="process-step"><span>4</span><div><strong>Cotización</strong><small>Datos y contacto comercial</small></div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5 case-section">
      <div class="container py-lg-4">
        <div class="row g-5 align-items-center">
          <div class="col-12 col-lg-6" data-aos="fade-up" data-aos-duration="650">
                <img
                  src="/proyectos/hyh2.jpeg"
                  alt="Página principal y catálogo web de Servicios HYH"
                  width="860"
                  height="740"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="case-main-image"
                />
          </div>

          <div class="col-12 col-lg-6" data-aos="fade-left" data-aos-duration="650">
            <span class="case-kicker">Decisión estratégica</span>
            <h2 class="case-title mt-2 mb-3">Por qué no se implementó como una tienda online convencional</h2>
            <p class="case-copy">
              Los equipos médicos requieren asesoría, validación de disponibilidad, condiciones comerciales
              y, en algunos casos, coordinación de instalación o soporte. Forzar una compra directa habría simplificado
              la tecnología, pero no habría representado correctamente el negocio.
            </p>
            <p class="case-copy mb-0">
              Por eso se priorizó un catálogo consultivo: el usuario puede informarse, seleccionar varios productos
              y enviar una solicitud completa para continuar con atención especializada.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5 case-seo border-top border-bottom">
      <div class="container py-lg-4">
        <div class="row g-5">
          <div class="col-12 col-lg-5" data-aos="fade-up" data-aos-duration="650">
            <span class="case-kicker">SEO y medición</span>
            <h2 class="case-title mt-2 mb-3">Una base preparada para crecer con búsquedas reales</h2>
            <p class="text-secondary mb-0">
              El trabajo SEO se aborda como un proceso continuo: revisar datos, detectar oportunidades y mejorar las páginas con mayor potencial comercial.
            </p>
          </div>

          <div class="col-12 col-lg-7">
            <div class="seo-list">
              <div><i class="bi bi-diagram-2"></i><span><strong>Arquitectura por categorías y productos</strong><small>Rutas y relaciones internas comprensibles.</small></span></div>
              <div><i class="bi bi-card-text"></i><span><strong>Titles, descripciones y contenido</strong><small>Información útil alineada con la intención de búsqueda.</small></span></div>
              <div><i class="bi bi-speedometer2"></i><span><strong>Rendimiento y experiencia móvil</strong><small>Mejoras técnicas para facilitar navegación e indexación.</small></span></div>
              <div><i class="bi bi-graph-up"></i><span><strong>Search Console y Analytics</strong><small>Identificación de consultas, páginas y nuevas oportunidades.</small></span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5 case-results">
      <div class="container py-lg-4">
        <div class="row g-5 align-items-start">
          <div class="col-12 col-lg-5" data-aos="fade-up" data-aos-duration="650">
            <span class="case-kicker">Resultados obtenidos</span>
            <h2 class="case-title mt-2 mb-3">Una plataforma más clara para clientes y administradores</h2>
            <p class="text-secondary mb-0">
              En esta etapa se presentan resultados funcionales y verificables. Las métricas orgánicas pueden añadirse cuando exista un periodo comparable y autorizado.
            </p>
          </div>

          <div class="col-12 col-lg-7">
            <div class="results-grid">
              <div class="result-card"><i class="bi bi-check-circle"></i><span>Catálogo centralizado para equipos, repuestos y ofertas.</span></div>
              <div class="result-card"><i class="bi bi-check-circle"></i><span>Fichas individuales capaces de incorporar información técnica.</span></div>
              <div class="result-card"><i class="bi bi-check-circle"></i><span>Proceso de cotización múltiple adaptado a venta consultiva.</span></div>
              <div class="result-card"><i class="bi bi-check-circle"></i><span>Mejor base para crear contenido posicionable por producto y servicio.</span></div>
              <div class="result-card"><i class="bi bi-check-circle"></i><span>Navegación disponible en dispositivos móviles y escritorio.</span></div>
              <div class="result-card"><i class="bi bi-check-circle"></i><span>Medición continua para orientar las siguientes mejoras.</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5 case-learning border-top border-bottom">
      <div class="container py-lg-4">
        <div class="case-learning-card" data-aos="fade-up" data-aos-duration="650">
          <span class="case-learning-card__icon"><i class="bi bi-lightbulb"></i></span>
          <div>
            <span class="case-kicker">Aprendizaje del proyecto</span>
            <h2 class="h3 fw-bold mt-2 mb-3">En productos técnicos, más contenido no siempre significa mejor contenido</h2>
            <p class="text-secondary mb-0">
              La información debe organizarse según las dudas del comprador, la intención de búsqueda y el proceso real de cotización.
              Una ficha útil no solo describe el equipo: ayuda a decidir, comparar y dar el siguiente paso comercial.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5 case-related">
      <div class="container py-lg-4">
        <div class="row g-4">
          <div class="col-12 col-lg-4">
            <a href="/desarrollo-web-a-medida/" class="related-card">
              <i class="bi bi-code-slash"></i>
              <span>Servicio relacionado</span>
              <strong>Desarrollo web a medida</strong>
              <small>Plataformas orientadas a procesos y resultados.</small>
            </a>
          </div>
          <div class="col-12 col-lg-4">
            <a href="/agencia-marketing-digital/" class="related-card">
              <i class="bi bi-graph-up-arrow"></i>
              <span>Servicio relacionado</span>
              <strong>Marketing digital B2B</strong>
              <small>SEO, captación y medición para empresas.</small>
            </a>
          </div>
          <div class="col-12 col-lg-4">
            <a href="/nosotros/" class="related-card">
              <i class="bi bi-person-badge"></i>
              <span>Quién ejecuta</span>
              <strong>Conoce SoftwareCode</strong>
              <small>Experiencia técnica detrás del proyecto.</small>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5 case-faq border-top">
      <div class="container py-lg-4">
        <div class="row g-5">
          <div class="col-12 col-lg-5">
            <span class="case-kicker">Preguntas frecuentes</span>
            <h2 class="case-title mt-2 mb-3">Catálogos web y plataformas de cotización B2B</h2>
            <p class="text-secondary mb-0">Respuestas para empresas con productos o servicios que necesitan una venta consultiva.</p>
          </div>

          <div class="col-12 col-lg-7">
            <div class="accordion case-accordion" id="caseFaq">
              <div class="accordion-item">
                <h3 class="accordion-header">
                  <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#caseFaq1" aria-expanded="true" aria-controls="caseFaq1">
                    ¿Por qué usar cotización en vez de compra directa?
                  </button>
                </h3>
                <div id="caseFaq1" class="accordion-collapse collapse show" data-bs-parent="#caseFaq">
                  <div class="accordion-body">Cuando el producto requiere asesoría, disponibilidad, configuración o instalación, la cotización permite reunir la información necesaria y mantener una atención comercial especializada.</div>
                </div>
              </div>

              <div class="accordion-item">
                <h3 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#caseFaq2" aria-expanded="false" aria-controls="caseFaq2">
                    ¿Un catálogo de productos puede posicionarse en Google?
                  </button>
                </h3>
                <div id="caseFaq2" class="accordion-collapse collapse" data-bs-parent="#caseFaq">
                  <div class="accordion-body">Sí. Cada categoría y ficha puede responder consultas específicas si tiene contenido útil, metadatos, enlaces internos y una base técnica rastreable.</div>
                </div>
              </div>

              <div class="accordion-item">
                <h3 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#caseFaq3" aria-expanded="false" aria-controls="caseFaq3">
                    ¿Se puede adaptar esta solución a otros sectores?
                  </button>
                </h3>
                <div id="caseFaq3" class="accordion-collapse collapse" data-bs-parent="#caseFaq">
                  <div class="accordion-body">Sí. Es especialmente útil para maquinaria, repuestos, equipamiento industrial, insumos médicos y otros productos B2B que se venden mediante asesoría y cotización.</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="py-5 case-cta-section">
      <div class="container py-lg-4">
        <div class="case-cta">
          <div>
            <span class="case-kicker">Tu proyecto</span>
            <h2 class="h2 fw-bold mt-2 mb-2">¿Necesitas un catálogo o plataforma B2B similar?</h2>
            <p class="text-secondary mb-0">
              Cuéntanos qué vendes, cómo cotizas actualmente y qué procesos necesitas mejorar.
            </p>
          </div>
          <div class="d-grid d-sm-flex gap-2">
            <a href={whatsappUrl} class="btn case-btn-primary btn-lg px-4" target="_blank" rel="noopener noreferrer">
              Conversar sobre mi proyecto
            </a>
            <a href="/proyectos/" class="btn case-btn-outline btn-lg px-4">Ver más proyectos</a>
          </div>
        </div>
      </div>
    </footer>
  </article>

  <style>
    :root {
      --case-ink: #111827;
      --case-muted: #64748b;
      --case-border: rgba(15,23,42,.1);
      --case-purple: #6f2cff;
      --case-pink: #ff2ea6;
      --case-soft: #f8fafc;
    }

    .case-hero { padding: 8.5rem 0 6rem; color: var(--case-ink); background: linear-gradient(180deg,#f8fafc 0%,#fff 100%); }
    .case-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(15,23,42,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(15,23,42,.045) 1px,transparent 1px); background-size: 44px 44px; mask-image: linear-gradient(to bottom,black,transparent 88%); pointer-events: none; }
    .case-hero__glow { position:absolute; border-radius:50%; filter:blur(28px); opacity:.55; pointer-events:none; }
    .case-hero__glow--one { width:470px; height:470px; left:-190px; top:-220px; background:rgba(255,46,166,.2); }
    .case-hero__glow--two { width:540px; height:540px; right:-250px; top:-120px; background:rgba(111,44,255,.18); }
    .case-breadcrumb a { color:var(--case-purple); text-decoration:none; }

    .case-badge,.case-chip { display:inline-flex; align-items:center; gap:.42rem; border:1px solid rgba(111,44,255,.18); background:rgba(111,44,255,.06); color:#5b21b6; border-radius:999px; padding:.45rem .8rem; font-size:.82rem; font-weight:850; }
    .case-gradient-text { background:linear-gradient(90deg,var(--case-pink),var(--case-purple)); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .case-btn-primary { color:#fff; border:0; border-radius:999px; font-weight:900; background:linear-gradient(90deg,var(--case-pink),var(--case-purple)); box-shadow:0 18px 45px rgba(111,44,255,.2); }
    .case-btn-primary:hover { color:#fff; transform:translateY(-1px); }
    .case-btn-outline { border:1px solid rgba(111,44,255,.28); color:var(--case-purple); background:#fff; border-radius:999px; font-weight:900; }
    .case-btn-outline:hover { color:var(--case-purple); background:rgba(111,44,255,.06); }

    .case-visual-card { position:relative; border:1px solid var(--case-border); border-radius:28px; padding:1rem; background:rgba(255,255,255,.94); box-shadow:0 30px 80px rgba(15,23,42,.13); }
    .case-image-placeholder,.case-media-placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; border:1px dashed rgba(255,255,255,.3); color:#fff; background:radial-gradient(circle at 25% 25%,rgba(255,46,166,.28),transparent 42%),radial-gradient(circle at 80% 70%,rgba(111,44,255,.38),transparent 45%),#101423; }
    .case-image-placeholder { min-height:500px; border-radius:22px; }
    .case-image-placeholder i,.case-media-placeholder i { font-size:3rem; margin-bottom:1rem; }
    .case-image-placeholder span,.case-media-placeholder span { opacity:.78; margin-top:.35rem; }
    .case-image-placeholder small,.case-media-placeholder small { opacity:.55; margin-top:.25rem; }
    .case-main-image { width:100%; height:auto; aspect-ratio:860/740; object-fit:cover; border-radius:22px; }
    .case-floating-card { position:absolute; left:-38px; bottom:34px; display:flex; gap:.85rem; align-items:center; max-width:290px; padding:1rem 1.15rem; border:1px solid var(--case-border); border-radius:18px; background:rgba(255,255,255,.96); box-shadow:0 18px 50px rgba(15,23,42,.16); }
    .case-floating-card i { color:var(--case-purple); font-size:1.45rem; }
    .case-floating-card strong,.case-floating-card span { display:block; }
    .case-floating-card span { font-size:.78rem; color:var(--case-muted); }

    .case-proof-strip { background:#fff; }
    .case-proof { min-height:120px; display:flex; gap:.9rem; align-items:center; padding:1.4rem; border-right:1px solid var(--case-border); }
    .case-proof i { width:45px; height:45px; display:grid; place-items:center; border-radius:13px; color:var(--case-purple); background:rgba(111,44,255,.08); font-size:1.15rem; }
    .case-proof strong,.case-proof small { display:block; }
    .case-proof small { color:var(--case-muted); margin-top:.1rem; }

    .case-section,.case-results,.case-related,.case-faq,.case-cta-section { background:#fff; }
    .case-soft,.case-process,.case-seo,.case-learning { background:var(--case-soft); }
    .case-kicker { color:var(--case-purple); text-transform:uppercase; letter-spacing:.12em; font-size:.78rem; font-weight:950; }
    .case-title { color:var(--case-ink); font-weight:900; }
    .case-copy { color:var(--case-muted); font-size:1.05rem; line-height:1.85; }

    .challenge-card,.capability-card,.result-card,.case-learning-card,.related-card,.case-cta { border:1px solid var(--case-border); background:#fff; box-shadow:0 20px 55px rgba(15,23,42,.07); }
    .challenge-card { height:100%; border-radius:20px; padding:1.5rem; }
    .challenge-card > span { display:inline-grid; place-items:center; width:38px; height:38px; border-radius:12px; color:var(--case-purple); background:rgba(111,44,255,.08); font-weight:950; margin-bottom:1rem; }
    .challenge-card p,.capability-card p { color:var(--case-muted); margin:0; }

    .capability-card { height:100%; border-radius:22px; padding:1.7rem; }
    .capability-card__icon { width:50px; height:50px; display:grid; place-items:center; border-radius:15px; background:linear-gradient(135deg,rgba(255,46,166,.12),rgba(111,44,255,.12)); color:var(--case-purple); font-size:1.3rem; margin-bottom:1.1rem; }

    .process-flow { display:grid; grid-template-columns:1fr auto 1fr auto 1fr auto 1fr; align-items:center; gap:.65rem; }
    .process-step { min-height:155px; padding:1.2rem; border:1px solid var(--case-border); border-radius:20px; background:#fff; box-shadow:0 15px 45px rgba(15,23,42,.06); }
    .process-step > span { width:38px; height:38px; display:grid; place-items:center; border-radius:12px; color:#fff; background:linear-gradient(135deg,var(--case-pink),var(--case-purple)); font-weight:950; margin-bottom:1rem; }
    .process-step strong,.process-step small { display:block; }
    .process-step small { color:var(--case-muted); margin-top:.3rem; }
    .process-arrow { color:var(--case-purple); }

    .case-media-placeholder { min-height:450px; border-radius:26px; padding:2rem; }
    .seo-list { display:grid; gap:1rem; }
    .seo-list > div { display:flex; gap:1rem; align-items:flex-start; border:1px solid var(--case-border); border-radius:18px; padding:1.25rem; background:#fff; }
    .seo-list i { width:44px; height:44px; display:grid; place-items:center; flex:0 0 auto; border-radius:13px; color:var(--case-purple); background:rgba(111,44,255,.08); }
    .seo-list strong,.seo-list small { display:block; }
    .seo-list small { color:var(--case-muted); margin-top:.2rem; }

    .results-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
    .result-card { display:flex; align-items:flex-start; gap:.8rem; border-radius:18px; padding:1.25rem; color:var(--case-muted); }
    .result-card i { color:var(--case-purple); font-size:1.15rem; margin-top:.1rem; }

    .case-learning-card { border-radius:26px; padding:clamp(2rem,4vw,3.4rem); display:flex; gap:1.5rem; align-items:flex-start; }
    .case-learning-card__icon { width:58px; height:58px; flex:0 0 auto; display:grid; place-items:center; border-radius:17px; color:var(--case-purple); background:rgba(111,44,255,.09); font-size:1.5rem; }

    .related-card { display:flex; flex-direction:column; height:100%; border-radius:22px; padding:1.6rem; text-decoration:none; color:var(--case-ink); transition:transform .18s ease,border-color .18s ease; }
    .related-card:hover { color:var(--case-ink); transform:translateY(-3px); border-color:rgba(111,44,255,.28); }
    .related-card i { width:48px; height:48px; display:grid; place-items:center; border-radius:14px; color:var(--case-purple); background:rgba(111,44,255,.08); font-size:1.25rem; margin-bottom:1rem; }
    .related-card > span { color:var(--case-purple); text-transform:uppercase; letter-spacing:.08em; font-size:.72rem; font-weight:900; }
    .related-card strong { font-size:1.15rem; margin-top:.3rem; }
    .related-card small { color:var(--case-muted); margin-top:.45rem; }

    .case-accordion .accordion-item { border:1px solid var(--case-border); border-radius:16px!important; overflow:hidden; margin-bottom:.8rem; }
    .case-accordion .accordion-button { font-weight:850; box-shadow:none; }
    .case-accordion .accordion-button:not(.collapsed) { color:var(--case-purple); background:rgba(111,44,255,.05); }
    .case-accordion .accordion-body { color:var(--case-muted); line-height:1.75; }

    .case-cta { border-radius:28px; padding:clamp(2rem,5vw,4rem); display:flex; align-items:center; justify-content:space-between; gap:2rem; }

    @media (max-width:1199.98px) {
      .process-flow { grid-template-columns:1fr 1fr; }
      .process-arrow { display:none; }
    }

    @media (max-width:991.98px) {
      .case-hero { padding:7rem 0 4.5rem; }
      .case-floating-card { left:20px; bottom:20px; }
      .case-proof { border-right:0; border-bottom:1px solid var(--case-border); }
      .case-cta { align-items:stretch; flex-direction:column; }
    }

    @media (max-width:767.98px) {
      .results-grid { grid-template-columns:1fr; }
      .process-flow { grid-template-columns:1fr; }
      .case-learning-card { flex-direction:column; }
    }

    @media (max-width:575.98px) {
      .case-hero h1 { font-size:2.18rem; }
      .case-image-placeholder { min-height:390px; }
      .case-floating-card { position:relative; left:auto; bottom:auto; margin-top:1rem; max-width:none; }
      .case-media-placeholder { min-height:330px; }
    }
  </style>
</Layout>
