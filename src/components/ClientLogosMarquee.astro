---
type Logo = { src: string; alt: string; href?: string };

const logos: Logo[] = [
  { src: '/logos-clientes/apartha.png', alt: 'Apartha', href: 'https://www.apartha.com/' },
  { src: '/logos-clientes/elementalStudios.png', alt: 'Elemental Studios', href: 'https://www.elementalstudios.cl/' },
  { src: '/logos-clientes/logo-negro.png', alt: 'Licores Premium', href: 'https://www.licorespremium.cl/' },
  { src: '/logos-clientes/servicioshyh.png', alt: 'Servicios HYH', href: 'https://www.servicioshyh.cl/' },
];

// duplicamos 1 vez (marquee necesita 2 tracks iguales)
const track = [...logos, ...logos];
---
<section class="sc-client-logos" aria-label="Logos de clientes">
  <div class="sc-client-logos__bg" aria-hidden="true"></div>

  <div class="container">
    <div class="sc-logos-header">
      <span class="sc-logos-eyebrow">Empresas que confían en nosotros</span>

      <h2 class="sc-logos-title">
        Proyectos reales, marcas reales y soluciones digitales con impacto
      </h2>

      <p class="sc-logos-text">
        Hemos trabajado en desarrollo web, SEO, automatización e integración de plataformas
        para negocios que necesitan resultados medibles.
      </p>
    </div>

    <div class="logos-marquee" style="--duration: 26s;">
      <div class="logos-marquee__glow" aria-hidden="true"></div>
      <div class="sheen" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>

      <div class="marquee" role="presentation">
        <div class="marquee__track">
          {track.map((l) => (
            l.href ? (
              <a class="logo-item" href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.alt}>
                <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
              </a>
            ) : (
              <div class="logo-item" aria-label={l.alt}>
                <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
              </div>
            )
          ))}
        </div>

        <div class="marquee__track" aria-hidden="true">
          {track.map((l) => (
            l.href ? (
              <a class="logo-item" href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.alt}>
                <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
              </a>
            ) : (
              <div class="logo-item" aria-label={l.alt}>
                <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
              </div>
            )
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
.sc-client-logos {
  position: relative;
  overflow: hidden;
  padding: 86px 0 92px;
  color: rgba(255,255,255,.94);
  background:
    radial-gradient(760px 340px at 16% 0%, rgba(168,85,247,.18), transparent 64%),
    radial-gradient(760px 360px at 86% 12%, rgba(109,143,255,.13), transparent 62%),
    linear-gradient(180deg, #070a12 0%, #090d1a 50%, #070a12 100%);
}

.sc-client-logos__bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .14;
  background-image:
    linear-gradient(to right, rgba(255,255,255,.07) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,.055) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: radial-gradient(circle at 50% 0%, #000 0%, transparent 72%);
}

.sc-client-logos::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -220px;
  width: min(960px, 90vw);
  height: 420px;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(168,85,247,.22), transparent 70%);
  filter: blur(18px);
  pointer-events: none;
}

.sc-client-logos .container {
  position: relative;
  z-index: 2;
}

.sc-logos-header {
  max-width: 860px;
  margin-bottom: 34px;
}

.sc-logos-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
  font-size: .74rem;
  font-weight: 900;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(216,180,254,.86);
}

.sc-logos-eyebrow::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #a855f7;
  box-shadow: 0 0 18px rgba(168,85,247,.9);
}

.sc-logos-title {
  max-width: 760px;
  margin: 0;
  color: rgba(255,255,255,.98);
  font-size: clamp(2rem, 3vw, 3.05rem);
  line-height: 1.04;
  font-weight: 950;
  letter-spacing: -.045em;
  text-shadow: 0 18px 58px rgba(0,0,0,.44);
}

.sc-logos-text {
  max-width: 680px;
  margin: 16px 0 0;
  color: rgba(255,255,255,.66);
  font-size: 1rem;
  line-height: 1.72;
}

/* Wrapper principal */
.logos-marquee {
  position: relative;
  overflow: hidden;
  width: 100%;
  padding: 22px 0;
  isolation: isolate;
  border-radius: 28px;
  background:
    linear-gradient(135deg, rgba(255,255,255,.075), rgba(255,255,255,.025)),
    radial-gradient(720px 160px at 20% 0%, rgba(168,85,247,.15), transparent 66%),
    radial-gradient(680px 160px at 80% 100%, rgba(109,143,255,.10), transparent 64%);
  border: 1px solid rgba(255,255,255,.11);
  box-shadow:
    0 28px 72px rgba(0,0,0,.32),
    inset 0 0 0 1px rgba(255,255,255,.035);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
          mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
}

.logos-marquee__glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: min(920px, 88vw);
  height: 160px;
  transform: translate(-50%, -50%);
  pointer-events: none;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(168,85,247,.16), transparent 70%);
  filter: blur(18px);
  z-index: 1;
}

/* Sheen */
.sheen {
  position: absolute;
  inset: -60px -35%;
  pointer-events: none;
  z-index: 2;
  background: linear-gradient(
    115deg,
    transparent 0%,
    rgba(255,255,255,.00) 35%,
    rgba(216,180,254,.12) 47%,
    rgba(109,143,255,.09) 55%,
    transparent 72%
  );
  transform: translateX(-34%);
  animation: scSheen 9.5s ease-in-out infinite;
  opacity: .65;
}

@keyframes scSheen {
  0%   { transform: translateX(-40%); opacity: .22; }
  45%  { opacity: .68; }
  100% { transform: translateX(40%);  opacity: .22; }
}

/* Grain */
.grain {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  opacity: .055;
  background-image:
    repeating-linear-gradient(
      0deg,
      rgba(255,255,255,.10) 0px,
      rgba(255,255,255,.10) 1px,
      transparent 1px,
      transparent 4px
    );
}

/* Marquee */
.marquee {
  position: relative;
  z-index: 3;
  display: flex;
  width: max-content;
  will-change: transform;
  transform: translateZ(0);
  animation: marquee var(--duration, 26s) linear infinite;
}

@keyframes marquee {
  from { transform: translate3d(0,0,0); }
  to   { transform: translate3d(-50%,0,0); }
}

.marquee__track {
  display: flex;
  align-items: center;
  gap: 42px;
  padding-right: 42px;
}

/* Item */
.logo-item {
  width: 210px;
  height: 104px;
  display: grid;
  place-items: center;
  position: relative;
  text-decoration: none;
  border-radius: 22px;
  background:
    linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.035));
  border: 1px solid rgba(255,255,255,.10);
  box-shadow:
    0 18px 44px rgba(0,0,0,.24),
    inset 0 0 0 1px rgba(255,255,255,.025);
  transition:
    transform .2s ease,
    background .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

.logo-item::before {
  content: "";
  position: absolute;
  inset: 18px 18px;
  border-radius: 999px;
  background: radial-gradient(circle at 50% 55%, rgba(216,180,254,.14), transparent 70%);
  opacity: .9;
  filter: blur(12px);
  z-index: -1;
  pointer-events: none;
}

.logo-item img {
  max-height: 72px;
  max-width: 155px;
  width: auto;
  height: auto;
  object-fit: contain;
  opacity: .92;
  transform: translateZ(0);
  filter:
    brightness(1.06)
    contrast(1.04)
    drop-shadow(0 12px 22px rgba(0,0,0,.34));
  transition: transform .2s ease, opacity .2s ease, filter .2s ease;
}

.logos-marquee:hover .marquee {
  animation-play-state: paused;
}

.logo-item:hover {
  transform: translateY(-3px);
  background:
    linear-gradient(180deg, rgba(255,255,255,.105), rgba(255,255,255,.045));
  border-color: rgba(216,180,254,.24);
  box-shadow:
    0 24px 58px rgba(0,0,0,.34),
    0 0 28px rgba(168,85,247,.12);
}

.logo-item:hover img {
  transform: scale(1.045);
  opacity: 1;
  filter:
    brightness(1.12)
    contrast(1.08)
    drop-shadow(0 16px 28px rgba(0,0,0,.42));
}

/* Mobile */
@media (max-width: 767.98px) {
  .sc-client-logos {
    padding: 70px 0 76px;
  }

  .sc-logos-header {
    margin-bottom: 26px;
  }

  .sc-logos-title {
    font-size: clamp(2rem, 9vw, 2.65rem);
  }

  .sc-logos-text {
    font-size: .96rem;
  }

  .logos-marquee {
    padding: 16px 0;
    border-radius: 22px;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 13%, #000 87%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0%, #000 13%, #000 87%, transparent 100%);
  }

  .marquee__track {
    gap: 18px;
    padding-right: 18px;
  }

  .logo-item {
    width: 164px;
    height: 86px;
    border-radius: 18px;
  }

  .logo-item img {
    max-width: 124px;
    max-height: 58px;
  }

  .logos-marquee {
    --duration: 20s;
  }
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
  .marquee {
    animation: none;
  }

  .sheen {
    animation: none;
    opacity: .18;
  }
}
</style>