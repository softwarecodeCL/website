---
type Logo = { src: string; alt: string; href?: string };

const logos: Logo[] = [
  { src: '/logos-clientes/apartha.png', alt: 'Apartha', href: 'https://www.apartha.cl/' },
  { src: '/logos-clientes/elementalStudios.png', alt: 'Elemental Studios', href: '#' },
  { src: '/logos-clientes/logo-negro.png', alt: 'Licores Premium', href: 'https://www.licorespremium.cl/' },
  { src: '/logos-clientes/servicioshyh.png', alt: 'Servicios HYH', href: 'https://www.servicioshyh.cl/' },
];

// duplicamos 1 vez (marquee necesita 2 tracks iguales)
const track = [...logos, ...logos];
---

<section class="sc-client-logos py-4 py-lg-5" aria-label="Logos de clientes">
  <div class="container">
    <div class="sc-logos-header mb-4">
      <span class="sc-logos-eyebrow">Empresas que confían en nosotros</span>
    </div>

    <div class="logos-marquee" style="--duration: 22s;">
      <div class="sheen" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>

      <div class="marquee" role="presentation">
        <div class="marquee__track">
          {track.map((l) => (
            l.href ? (
              <a class="logo-item" href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.alt}>
                <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
              </a>
            ) : (
              <div class="logo-item" aria-label={l.alt}>
                <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
              </div>
            )
          ))}
        </div>

        <div class="marquee__track" aria-hidden="true">
          {track.map((l) => (
            l.href ? (
              <a class="logo-item" href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.alt}>
                <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
              </a>
            ) : (
              <div class="logo-item" aria-label={l.alt}>
                <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
              </div>
            )
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* Header premium */
.sc-logos-header{ max-width: 720px; }
.sc-logos-eyebrow{
  display:inline-block;
  font-size:.75rem;
  font-weight:700;
  letter-spacing:.18em;
  text-transform:uppercase;
  color: rgba(255,255,255,.55);
}

/* Wrapper */
.logos-marquee{
  position: relative;
  overflow: hidden;
  width: 100%;
  padding: 14px 0;
  isolation: isolate;

  /* fade lateral */
  -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 9%, #000 91%, transparent 100%);
          mask-image: linear-gradient(to right, transparent 0%, #000 9%, #000 91%, transparent 100%);
}

/* Glow arriba/abajo (cinta iluminada pero sin “bordes”) */
.logos-marquee::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:1;
  background:
    radial-gradient(1200px 70px at 50% 0%,
      rgba(255,255,255,.045),
      rgba(255,255,255,0) 70%),
    radial-gradient(1200px 70px at 50% 100%,
      rgba(255,255,255,.038),
      rgba(255,255,255,0) 70%);
  opacity:.9;
  animation: scAmbient 8s ease-in-out infinite;
}
@keyframes scAmbient{
  0% { transform: translateX(-1%); opacity:.78; }
  50%{ transform: translateX( 1%); opacity:.95; }
  100%{transform: translateX(-1%); opacity:.78; }
}

/* Sheen */
.sheen{
  position:absolute;
  inset:-40px -35%;
  pointer-events:none;
  z-index:1;
  background: linear-gradient(115deg,
    transparent 0%,
    rgba(110,168,255,.10) 42%,
    rgba(139,92,246,.08) 52%,
    transparent 72%
  );
  transform: translateX(-30%);
  animation: scSheen 10.5s ease-in-out infinite;
  opacity: .55;
}
@keyframes scSheen{
  0%   { transform: translateX(-38%); opacity: .22; }
  45%  { opacity: .58; }
  100% { transform: translateX(38%);  opacity: .22; }
}

/* Grain liviano */
.grain{
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:1;
  opacity:.06;
  background-image:
    repeating-linear-gradient(0deg,
      rgba(255,255,255,.10) 0px,
      rgba(255,255,255,.10) 1px,
      transparent 1px,
      transparent 4px
    );
}

/* Marquee */
.marquee{
  position: relative;
  z-index: 2;
  display:flex;
  width: max-content;
  will-change: transform;
  transform: translateZ(0);
  animation: marquee var(--duration, 22s) linear infinite;
}
@keyframes marquee{
  from { transform: translate3d(0,0,0); }
  to   { transform: translate3d(-50%,0,0); }
}

/* tracks */
.marquee__track{
  display:flex;
  align-items:center;
  gap: 72px;               /* 👈 separación pro desktop */
  padding-right: 72px;     /* evita “pegado” entre loops */
}

/* Item */
.logo-item{
  height: 84px;
  display:grid;
  place-items:center;
  text-decoration:none;
  border-radius: 12px;
  transition: transform .2s ease, background .2s ease;
  position: relative;
}

/* Glow detrás del logo (ayuda a logos oscuros) */
.logo-item::before{
  content:"";
  position:absolute;
  inset: 14px -10px;
  border-radius: 999px;
  background: radial-gradient(circle at 50% 55%,
    rgba(255,255,255,.10),
    rgba(255,255,255,0) 70%);
  opacity: .9;
  filter: blur(10px);
  z-index:-1;
  pointer-events:none;
}

.logo-item img{
  max-height: 84px;
  max-width: 180px;
  width:auto;
  height:auto;
  object-fit: contain;
  opacity: .96;
  transform: translateZ(0);
  transition: transform .2s ease, opacity .2s ease;
}

/* Hover sutil */
.logos-marquee:hover .marquee{ animation-play-state: paused; } /* opcional */
.logo-item:hover{ transform: translateY(-1px); background: rgba(255,255,255,.02); }
.logo-item:hover img{ transform: scale(1.03); opacity: 1; }

/* Mobile */
@media (max-width: 575.98px){
  .logos-marquee{
    padding: 8px 0;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 14%, #000 86%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0%, #000 14%, #000 86%, transparent 100%);
  }
  .marquee__track{
    gap: 28px;            /* 👈 separación mobile */
    padding-right: 28px;
  }
  .logo-item img{ max-width: 140px; }
  .logos-marquee{ --duration: 18s; } /* un poco más rápido en mobile */
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce){
  .marquee{ animation: none; }
  .sheen{ animation: none; opacity: .18; }
}
</style>