  height: 7px;
  border-radius: 50%;
  background: #a855f7;
  box-shadow: 0 0 16px rgba(168,85,247,.9);
}

.hero-title {
  font-size: clamp(2rem, 4.2vw, 3.9rem) !important;
  line-height: .98;
  letter-spacing: -.05em;
  font-weight: 950 !important;
  margin-bottom: 26px !important;
  text-shadow: 0 18px 50px rgba(0,0,0,.55);
}

.hero-highlight{
  display: inline-block;
  background: linear-gradient(90deg, #ff61d2 0%, #b85cff 42%, #6d8fff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-subtitle{
  max-width: 610px;
  margin-bottom: 30px !important;
  color: rgba(255,255,255,.78) !important;
  font-size: 1.08rem;
  line-height: 1.75;
}

.sc-hero-actions{
  display: flex;
  gap: 14px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.sc-hero-btn-main{
  min-height: 58px;
  padding: 14px 24px;
  border-radius: 14px;
  font-size: 1rem;
  font-weight: 900;
  min-width: 250px;
}

.sc-hero-btn-secondary{
  min-height: 58px;
  padding: 14px 24px;
  min-width: 210px;
  border-radius: 14px;
  font-size: 1rem;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: rgba(255,255,255,.94) !important;
  background: rgba(7,10,18,.52);
  border: 1px solid rgba(255,255,255,.18);
  box-shadow:
    0 12px 32px rgba(0,0,0,.28),
    inset 0 0 0 1px rgba(255,255,255,.04);
  transition: all .18s ease;
  text-decoration: none;
}

.sc-hero-btn-secondary:hover{
  transform: translateY(-1px);
  background: rgba(255,255,255,.07);
  border-color: rgba(255,255,255,.28);
}

.sc-hero-btn-icon{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  opacity: .9;
}

.sc-hero-feature-pills{
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-top: 6px;
  margin-bottom: 24px;
}

.sc-hero-pill{
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(8,12,24,.54);
  border: 1px solid rgba(255,255,255,.08);
  box-shadow:
    0 12px 26px rgba(0,0,0,.22),
    inset 0 0 0 1px rgba(255,255,255,.02);
  text-align: left;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.sc-hero-pill-icon{
  color: #c26cff;
  font-size: 1rem;
  line-height: 1;
  padding-top: 2px;
  min-width: 16px;
}

.sc-hero-pill strong{
  display: block;
  color: rgba(255,255,255,.95);
  font-size: .79rem;
  line-height: 1.15;
  font-weight: 800;
  margin-bottom: 4px;
}

.sc-hero-pill span{
  display: block;
  color: rgba(255,255,255,.55);
  font-size: .63rem;
  line-height: 1.2;
}

.sc-hero-stats{
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  padding-top: 8px;
  border-top: 1px solid rgba(255,255,255,.08);
}

.sc-hero-stat{
  display: flex;
  align-items: flex-start;
  gap: 10px;
  text-align: left;
}

.sc-hero-stat-icon{
  min-width: 26px;
  font-size: 1.45rem;
  line-height: 1;
  color: rgba(140,104,255,.9);
  opacity: .95;
}

.sc-hero-stat-copy strong{
  display: block;
  color: rgba(255,255,255,.98);
  font-size: 1.9rem;
  line-height: 1;
  font-weight: 900;
  letter-spacing: -.03em;
  margin-bottom: 6px;
}

.sc-hero-stat-copy span{
  display: block;
  color: rgba(255,255,255,.60);
  font-size: .82rem;
  line-height: 1.35;
  max-width: 145px;
}

.sc-hero-stat:last-child .sc-hero-stat-copy strong{
  font-size: 1.15rem;
  line-height: 1.1;
  margin-top: 2px;
}

/* Responsive */
@media (max-width: 1199.98px){
  .sc-hero-feature-pills{
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .sc-hero-stats{
