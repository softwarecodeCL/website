}

/* GRID: más separación real, alineado, responsive */
.tech-logos{
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 34px 44px; /* ← separación premium */
  align-items: center;
  justify-items: center;
  margin-top: 34px;
  padding: 18px 10px;
}

/* Item sin cajas, pero con “presencia” */
.tech-item{
  display: grid;
  justify-items: center;
  gap: 10px;
  text-decoration: none;
  user-select: none;

  padding: 10px 8px;               /* área de hover sin caja visual */
  border-radius: 16px;             /* para hover suave */
  transition: transform .18s ease, background .18s ease, filter .18s ease;
}

.tech-item img{
  width: 86px;                     /* tamaño base */
  height: 56px;
  object-fit: contain;

  /* nitidez + profundidad sin “lavar” */
  filter:
    drop-shadow(0 12px 28px rgba(0,0,0,.45))
    drop-shadow(0 0 18px rgba(110,168,255,.10));
  transform: translateZ(0);
  image-rendering: -webkit-optimize-contrast;
}

.tech-item span{
  font-weight: 900;
  letter-spacing: .14em;
  text-transform: uppercase;
  font-size: .72rem;
  color: rgba(255,255,255,.88);
  text-shadow: 0 12px 30px rgba(0,0,0,.45);
}

