  <style>
   /* =========================================
   BASE / HELPERS
   ========================================= */

.section-modern{
  position: relative;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  overflow: hidden;
}

.section-modern .overlay{
  position:absolute;
  inset:0;
  background:
    radial-gradient(1200px 500px at 20% 0%, rgba(56,189,248,.25), transparent 55%),
    radial-gradient(900px 450px at 80% 30%, rgba(139,92,246,.22), transparent 55%),
    linear-gradient(to bottom, rgba(0,0,0,.72), rgba(0,0,0,.76));
  pointer-events:none;
}



/* Evitar espacios raros con footer */
main{
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

body{
  background: #070a12; /* mismo tono del footer */
}


/* ===== Premium CTA Buttons ===== */
.btn-glow{
  position: relative;
  border: 0;
  border-radius: 14px;
  padding: 12px 18px;
  font-weight: 800;
  letter-spacing: .2px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap: 10px;
  line-height: 1;
  min-height: 52px;
  color: rgba(255,255,255,.98) !important;
  text-shadow: 0 1px 0 rgba(0,0,0,.55);
  box-shadow:
    0 14px 40px rgba(0,0,0,.40),
    0 0 0 1px rgba(255,255,255,.16) inset;
  transition: transform .15s ease, filter .15s ease, box-shadow .15s ease;
  will-change: transform;
}

.btn-glow::before{
  content:"";
  position:absolute;
  inset:-2px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(255,255,255,.22), rgba(255,255,255,0));
  opacity: .55;
  pointer-events:none;
}

.btn-glow::after{
  content:"";
  position:absolute;
  inset:-10px;
  border-radius: 18px;
  filter: blur(14px);
  opacity: .45;
  pointer-events:none;
  z-index:-1;
}

.btn-glow .btn-arrow{
  display:inline-block;
  transform: translateX(0);
  transition: transform .15s ease;
  opacity: .95;
}

.btn-glow:hover{
  transform: translateY(-1px);
