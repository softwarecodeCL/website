   ================================ */
.sc-tech{
  position: relative;
  z-index: 1;
  padding-top: 130px; /* para que no choque con la wave */
}

/* esta capa oscurece la parte superior del tech (donde aparece tu franja) */
.sc-tech::after{
  content:"";
  position:absolute;
  left:0; right:0; top:0;
