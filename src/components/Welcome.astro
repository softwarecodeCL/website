/* ================================
   TRANSICIÓN AURORA (NO WAVE)
   ================================ */
.gradient-banner{
  position: relative;
  overflow: hidden;
  padding-bottom: 120px; /* deja espacio para la transición */
}

.sc-aurora-divider{
  position: absolute;
  left: 0; right: 0;
  bottom: -1px;
  height: 190px;
  pointer-events: none;
  z-index: 5;
}

.sc-aurora-divider svg{
  width: 100%;
  height: 100%;
  display: block;
}

/* base oscura del corte */
.sc-aurora-base{
  fill: rgba(7,10,18,.92);
}

/* shimmer animado (impacto premium) */
.sc-aurora-shimmer{
  stroke-dasharray: 140 1200;
  stroke-dashoffset: 0;
  animation: scShimmer 3.8s linear infinite;
}

@keyframes scShimmer{
  0%   { stroke-dashoffset: 0;   opacity: .12; }
  40%  { opacity: .38; }
  100% { stroke-dashoffset: -1600; opacity: .12; }
}

/* micro movimiento de la aurora */
.sc-aurora-glow{
  animation: scAuroraFloat 6s ease-in-out infinite;
  opacity: .9;
}

@keyframes scAuroraFloat{
  0%,100% { transform: translateY(0); }
  50%     { transform: translateY(6px); }
}

/* grano suave para look “agencia” */
.sc-aurora-grain{
  mix-blend-mode: overlay;
}

/* La sección siguiente “sube” un poco, como panel premium */
#servicios.sc-services{
  margin-top: -40px;
  padding-top: 90px;
  border-top-left-radius: 28px;
  border-top-right-radius: 28px;
  box-shadow: 0 -40px 90px rgba(0,0,0,.45);
  position: relative;
  z-index: 2;
}

