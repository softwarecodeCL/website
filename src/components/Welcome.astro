/* Asegura que la sección de tecnologías no tape el wave */






















.sc-tech{
  position: relative;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  /* separa del wave de servicios sin verse pegado */
  padding-bottom: 90px;
}

/* overlay FINO, elegante, no mata el fondo */
.sc-tech .tech-overlay{
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(1200px 520px at 15% 20%, rgba(110,168,255,.18), transparent 60%),
    radial-gradient(1000px 520px at 85% 30%, rgba(139,92,246,.16), transparent 62%),
    linear-gradient(to bottom, rgba(7,10,18,.55), rgba(7,10,18,.72));
}

/* “film grain” ultra sutil para look agencia */
.sc-tech::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  opacity:.06;
  background-image:
    repeating-linear-gradient(0deg, rgba(255,255,255,.08) 0, rgba(255,255,255,.08) 1px, transparent 1px, transparent 3px);
  mix-blend-mode: overlay;
}

/* Kicker / títulos */
.tech-kicker{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding: 6px 14px;
  border-radius: 999px;
  font-weight: 900;
  letter-spacing: .18em;
  text-transform: uppercase;
  font-size: .72rem;
