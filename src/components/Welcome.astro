    max-width: none;
  }
}



/* =====================================================
   HERO CHIPS — un poco más grandes
   SEO Técnico / IA aplicada / Performance
   ===================================================== */

.sc-hero-feature-pills {
  gap: 10px !important;
  margin-top: 10px !important;
  margin-bottom: 26px !important;
}

.sc-hero-pill {
  min-height: 62px !important;
  padding: 13px 15px !important;
  border-radius: 13px !important;
  gap: 11px !important;
  background: rgba(8, 12, 24, .62) !important;
  border: 1px solid rgba(255,255,255,.12) !important;
  box-shadow:
    0 14px 30px rgba(0,0,0,.28),
    inset 0 0 0 1px rgba(255,255,255,.035) !important;
}

.sc-hero-pill-icon {
  font-size: 1.05rem !important;
  color: #c56cff !important;
  min-width: 19px !important;
}

.sc-hero-pill strong {
  font-size: .78rem !important;
  line-height: 1.15 !important;
  margin-bottom: 4px !important;
}

.sc-hero-pill span {
  font-size: .64rem !important;
  line-height: 1.2 !important;
}


/* =====================================================
   HERO STATS — animación visual al entrar
   ===================================================== */

.sc-hero-stat {
  opacity: 0;
  transform: translateY(12px);
  animation: scStatFadeUp .7s ease forwards;
}

.sc-hero-stat:nth-child(1) {
  animation-delay: .1s;
}

.sc-hero-stat:nth-child(2) {
  animation-delay: .22s;
}

.sc-hero-stat:nth-child(3) {
  animation-delay: .34s;
}

.sc-hero-stat:nth-child(4) {
  animation-delay: .46s;
}

@keyframes scStatFadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.sc-count {
  display: inline-block;
  min-width: 3ch;
}

.sc-stat-text {
  display: inline-block;
}

/* =====================================================
   FIX COLOR SOPORTE CONTINUO
   ===================================================== */

.sc-hero-stats .sc-hero-stat,
.sc-hero-stats .sc-hero-stat *,
.sc-hero-stats .sc-hero-stat strong,
.sc-hero-stats .sc-hero-stat span {
  color: rgba(255, 255, 255, .92) !important;
}

.sc-hero-stat-copy strong,
.sc-hero-stat-copy .sc-count,
.sc-hero-stat-copy .sc-stat-text {
  color: rgba(255, 255, 255, .98) !important;
}

.sc-hero-stat-copy > span {
  color: rgba(255, 255, 255, .62) !important;
}

.sc-hero-stat-icon,
.sc-hero-stat-icon i {
  color: rgba(150, 120, 255, .95) !important;
}

.sc-hero-bg .btn-primary-soft,
.sc-hero-bg .sc-hero-btn-main {
  background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 48%, #a21caf 100%) !important;
  color: #ffffff !important;
  border: 1px solid rgba(216, 180, 254, 0.28) !important;
  box-shadow:
    0 16px 42px rgba(91, 33, 182, 0.42),
    0 0 0 1px rgba(255,255,255,0.14) inset !important;
}


