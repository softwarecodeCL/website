   ===================================================== */

#servicios.sc-services {
  --svc-bg: #070a12;
  --svc-bg-2: #0b1020;
  --svc-card: rgba(255,255,255,.065);
  --svc-card-2: rgba(255,255,255,.035);
  --svc-border: rgba(255,255,255,.12);
  --svc-border-strong: rgba(216,180,254,.24);
  --svc-text: rgba(255,255,255,.94);
  --svc-muted: rgba(255,255,255,.68);
  --svc-purple: #a855f7;
  --svc-pink: #d946ef;
  --svc-blue: #6d8fff;

  position: relative;
  overflow: hidden;
  margin-top: -40px;
  padding-top: 100px !important;
  padding-bottom: 140px !important;
  color: var(--svc-text);
  border-top-left-radius: 34px;
  border-top-right-radius: 34px;
  background:
    radial-gradient(900px 420px at 12% 0%, rgba(168,85,247,.22), transparent 62%),
    radial-gradient(800px 420px at 92% 18%, rgba(109,143,255,.16), transparent 60%),
    linear-gradient(180deg, #080b16 0%, #0b1020 48%, #070a12 100%);
  box-shadow:
    0 -42px 90px rgba(0,0,0,.48),
    inset 0 1px 0 rgba(255,255,255,.08);
}

#servicios.sc-services::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .18;
