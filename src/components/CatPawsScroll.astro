---
// src/components/CatPawsScroll.astro
---

<div class="cat-paws-track" aria-hidden="true">
  <div id="catPawsLottie" class="cat-paws-lottie"></div>
</div>

<script>
  import lottie from "lottie-web";

  const el = document.getElementById("catPawsLottie");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  if (el && !prefersReducedMotion) {
    const anim = lottie.loadAnimation({
      container: el,
      renderer: "svg",
      loop: false,
      autoplay: false,
      path: "/animations/cat-vertical-scroll.json",
      rendererSettings: {
        preserveAspectRatio: "xMidYMid slice",
      },
    });

    let raf = null;

    const updatePaws = () => {
      const doc = document.documentElement;
      const maxScroll = doc.scrollHeight - window.innerHeight;

      const progress = maxScroll > 0
        ? clamp(window.scrollY / maxScroll, 0, 1)
        : 0;

      const frame = progress * Math.max(anim.totalFrames - 1, 1);

      anim.goToAndStop(frame, true);

      document.documentElement.style.setProperty(
        "--cat-paws-fill",
        `${progress * 100}%`
      );
    };

    const requestUpdate = () => {
      if (raf) return;

      raf = requestAnimationFrame(() => {
        raf = null;
        updatePaws();
      });
    };

    anim.addEventListener("DOMLoaded", updatePaws);

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);

    requestUpdate();
  }
</script>

<style>
  .cat-paws-track {
    position: fixed;
    top: 96px;
    right: clamp(14px, 3vw, 42px);
    width: clamp(52px, 5vw, 82px);
    height: calc(100dvh - 132px);
    z-index: 1049;
    pointer-events: none;
    opacity: 0.95;
  }

  .cat-paws-track::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: rgba(168, 85, 247, 0.08);
  }

  .cat-paws-track::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 2px;
    height: var(--cat-paws-fill, 0%);
    transform: translateX(-50%);
    border-radius: 999px;
    background: linear-gradient(
      to top,
      rgba(168, 85, 247, 0.5),
      rgba(236, 72, 153, 0.35),
      rgba(255, 255, 255, 0)
    );
    filter: blur(0.4px);
  }

  .cat-paws-lottie {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    filter:
      drop-shadow(0 8px 18px rgba(0, 0, 0, 0.28))
      drop-shadow(0 0 16px rgba(168, 85, 247, 0.22));
  }

  @media (max-width: 991.98px) {
    .cat-paws-track {
      display: none;
    }
  }
</style>